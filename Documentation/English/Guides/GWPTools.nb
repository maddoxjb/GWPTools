Notebook[{
Cell["GWPTools", "GuideTitle",
 CellID->225533653,ExpressionUUID->"3146e473-8838-4c9c-a3f5-49ac234ee0b7"],

Cell[CellGroupData[{

Cell["", "GuideFunctionsSection",
 CellID->1862874138,ExpressionUUID->"c9bf837f-c46b-422b-a8dc-e02de08b8340"],

Cell["\<\
An exact, fully analytical framework for modeling the quantum dynamics of a \
Gaussian wavepacket (GWP) evolving under a quadratic external potential \
energy field. GWPTools provides an optimized architecture for evaluating \
time-dependent wavefunctions, densities, expectation values, and exact \
quantum trajectories.\
\>", "GuideAbstract",
 CellChangeTimes->{{3.995569551366997*^9, 3.995569568639702*^9}, {
  3.995569603238872*^9, 3.995569700984435*^9}, {3.995569754309477*^9, 
  3.995569867651362*^9}, {3.995569943845188*^9, 3.995569944025754*^9}, {
  3.995570366188736*^9, 3.9955703686249743`*^9}, {3.995580858324786*^9, 
  3.995580903456266*^9}, {3.995655602128751*^9, 3.995655736428872*^9}, {
  3.995656236550815*^9, 3.9956562397457113`*^9}},
 CellID->235469016,ExpressionUUID->"b75a9f8c-b18d-4670-8415-fe7cf3a4cd59"],

Cell[CellGroupData[{

Cell["User Interface Functions", "GuideFunctionsSubsection",
 CellChangeTimes->{{3.995573303050461*^9, 3.995573309656735*^9}},
 CellID->536859292,ExpressionUUID->"09eacb19-7a99-4437-96c8-64d101286eff"],

Cell[TextData[{
 Cell[BoxData["GWP"], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"c40ac8e4-27e1-4161-a8df-4d4f38357a23",ExpressionUUID->
  "972cf9ec-26b7-4070-8a5b-e0b0de2bf315"],
 " \[LongDash] Initializes a time-evolving Gaussian wavepacket system."
}], "GuideText",
 CellChangeTimes->{{3.9955699177901793`*^9, 3.995569940975917*^9}, {
   3.995569975905608*^9, 3.9955699761554527`*^9}, 3.995580951631892*^9},
 CellID->1161547753,ExpressionUUID->"24d58da3-fe00-46c3-90e6-67a54e7e1b6a"],

Cell[TextData[{
 Cell[BoxData["GWPObject"], "InlineGuideFunction",
  TaggingRules->{"PageType" -> "Function"},
  CellTags->"c5c6736a-1ff4-4e4e-8fcf-2d9846cbae62",ExpressionUUID->
  "ccea7836-22dd-468b-b4a0-bb10ec104317"],
 " \[LongDash] The central dispatcher and data structure for seamlessly \
querying all physical properties, dynamical fields, and expectation values."
}], "GuideText",
 CellChangeTimes->{{3.9955699803332157`*^9, 3.995570014467952*^9}, 
   3.995580966034631*^9},
 CellID->1506733441,ExpressionUUID->"ec51e7ce-a3f3-4d6d-a68b-728faa301321"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Developer Functions", "GuideFunctionsSubsection",
 CellChangeTimes->{{3.9955717858106403`*^9, 3.9955717896042767`*^9}},
 CellID->1938621229,ExpressionUUID->"f8b7ebf3-c450-4b65-a5fd-5c8d56305e4c"],

Cell["\<\
The core package is built on dozens of optimized backend evaluators. While \
end-users should generally route calculations through GWP using the GWPObject \
structure, these foundational symbols are exposed for advanced development.\
\>", "GuideText",
 CellChangeTimes->{{3.995571978955305*^9, 3.995572000798004*^9}, {
   3.995573228544676*^9, 3.995573235201045*^9}, {3.995580299628215*^9, 
   3.995580346199744*^9}, {3.995581015107731*^9, 3.995581039716939*^9}, {
   3.995655506397851*^9, 3.995655518188488*^9}, 3.9956561494054823`*^9},
 CellID->379483230,ExpressionUUID->"81da6e42-69bc-455f-a33d-12106a07133e"],

Cell["\<\
Function definitions and usage examples are provided in the Developer \
Reference Manual.\
\>", "GuideText",
 CellChangeTimes->{
  3.995581045232037*^9, 3.995581275305852*^9, {3.995655534891263*^9, 
   3.995655547727371*^9}},
 CellID->206292237,ExpressionUUID->"b188eb29-aa88-4a50-bed8-4246d51ee0d0"]
}, Open  ]]
}, Open  ]],

