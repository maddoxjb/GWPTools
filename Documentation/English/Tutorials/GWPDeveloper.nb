 RowBox[{"OBJ2", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{"\"\<Potential\>\"", "->", "\"\<Free\>\""}], "]"}]}]}], "Input",
