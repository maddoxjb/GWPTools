  3.99849161067043*^9, 3.998568794002124*^9, {3.9985742003726997`*^9, 
   3.998574204739376*^9}, 3.9985749199145737`*^9, 3.9985787503739767`*^9, 
   3.998591847529724*^9, 3.998600881075781*^9},
 CellID->734625774,ExpressionUUID->"13c13353-7129-43f3-a473-ad9892b176c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP", "[", "\"\<CT\>\"", "]"}], "[", "\"\<Classes\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GWP", "[", "\"\<CT\>\"", "]"}], "[", "\"\<PotentialNames\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{{3.99849129601576*^9, 3.998491308447938*^9}, {
  3.998491617330511*^9, 3.998491617614586*^9}, {3.998568602928645*^9, 
  3.998568605698103*^9}, {3.9985927645662317`*^9, 3.998592765471197*^9}},
