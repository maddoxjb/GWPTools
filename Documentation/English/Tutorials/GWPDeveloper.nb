       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}]}], ",", 
    RowBox[{"\<\"Potential\"\>", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"\<\"Harmonic\"\>", ",", "1"}], "}"}]}], ",", 
    RowBox[{"\<\"PotentialModel\"\>", "\[Rule]", 
     RowBox[{"GWPCTHARMONIC", "[", "1", "]"}]}], ",", 
    RowBox[{"\<\"Summary\"\>", "\[Rule]", "Automatic"}]}], 
   "\[RightAssociation]"}], "]"}]], "Output",
