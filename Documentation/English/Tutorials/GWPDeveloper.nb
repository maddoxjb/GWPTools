 RowBox[{"Dataset", "@", 
  RowBox[{"Select", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<Signatures\>\"", 
     "]"}], ",", 
    RowBox[{
     RowBox[{"#Category", "==", "\"\<Dynamic\>\""}], "&"}]}], 
   "]"}]}]], "Input",
