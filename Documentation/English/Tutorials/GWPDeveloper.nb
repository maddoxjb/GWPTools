  3.99857674580794*^9, {3.998578183667356*^9, 3.998578199622656*^9}, {
   3.998581146581234*^9, 3.99858116862488*^9}},
 CellLabel->"In[37]:=",
 CellID->651110349,ExpressionUUID->"6086de12-9ff5-4c92-a970-f5648886d956"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"OMEGA", " ", "t"}], "]"}]}], "+", 
  FractionBox[
   RowBox[{"RP", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}], 
   RowBox[{"MASS", " ", "OMEGA"}]]}]], "Output",
