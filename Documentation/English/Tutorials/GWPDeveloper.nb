        "Static"|>}, "AllowEmbedding" -> True, "InitialShape" -> 
     TypeSystem`PackageScope`HeaderShape[<|{All, "Property"} -> 
        1, {All, "ShortKey"} -> 1, {All, "Class"} -> 1, {All, "DynamicClass"} -> 
