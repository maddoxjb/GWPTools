Cell[CellGroupData[{

Cell["\<\
Filter by the \"StaticParameters\" class to list its registered properties.\
\>", "MathCaption",
 CellChangeTimes->{3.998470683871785*^9, 3.9985747844133997`*^9, 
  3.998591493186801*^9, 3.9986001399610043`*^9},
 CellID->1718309085,ExpressionUUID->"9e5a1065-2a7f-4040-a934-d9f99f2cbf83"],

