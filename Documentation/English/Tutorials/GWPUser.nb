Cell[CellGroupData[{

Cell["Visualizing Field Dynamics", "Subsection",
 CellChangeTimes->{{3.99883618934059*^9, 3.998836194323408*^9}},
 CellID->154934955,ExpressionUUID->"6f274ac8-fffb-4e88-a153-2133f2bcd983"],

Cell["\<\
For dynamic wavepackets, field properties such as wavefunctions and \
probability densities evaluate as bivariate functions of space and time [x, \
t]. Because GWPObject natively supports vectorization over its temporal \
argument, passing a list of times rapidly generates a sequence of evaluated \
states for visualization.\
\>", "Text",
 CellID->330342511,ExpressionUUID->"1173efea-2f31-4d4c-aab0-426643712ff3"],

Cell[CellGroupData[{

Cell["\<\
Initialize a free-particle wavepacket and plot its spatial probability \
density expanding over time.\
\>", "MathCaption",
 CellChangeTimes->{3.9988362431375732`*^9},
 CellID->821354882,ExpressionUUID->"78bda78e-23a8-4623-8757-b790bae1b00f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"freeObj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", "->", "\"\<Free\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"freeObj", "[", "\"\<DensityX\>\"", "]"}], "[", 
     RowBox[{"x", ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2", ",", "4"}], "}"}]}], "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "8"}], ",", "8"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<Density\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t = 0\>\"", ",", "\"\<t = 2\>\"", ",", "\"\<t = 4\>\""}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.998836250244766*^9, 3.998836262912899*^9}},
 CellLabel->"In[31]:=",
 CellID->486618858,ExpressionUUID->"a319e933-d6fe-4e1f-8e6a-341bb4966581"],

