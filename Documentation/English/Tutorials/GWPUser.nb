Cell["\<\
To explore the framework further, the full list of supported property names \
for any wavepacket type can be retrieved using the \"Properties\" \
introspection query.\
\>", "Text",
 CellChangeTimes->{3.998781410847788*^9},
 CellID->416757744,ExpressionUUID->"f215114d-d98d-40f2-b9f5-17781a3b1c48"],

Cell[CellGroupData[{

Cell["Retrieve a list of all supported 1D properties.", "MathCaption",
 CellChangeTimes->{
  3.9987813950453243`*^9, {3.998781427150964*^9, 3.99878142939532*^9}},
 CellID->708041432,ExpressionUUID->"82989fb8-7add-49a7-8a16-950ff7d9acab"],

