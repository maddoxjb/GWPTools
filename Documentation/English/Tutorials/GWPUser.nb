Cell[CellGroupData[{

Cell["Physical Framework Extensions", "Subsection",
 CellChangeTimes->{{3.998762360282748*^9, 3.998762367661487*^9}, {
  3.998767136135642*^9, 3.998767136864366*^9}},
 CellID->2030706864,ExpressionUUID->"81779dbb-b971-4f71-87cb-8d6820ffa5af"],

Cell["GWPHydrodynamics: ", "Text",
 CellChangeTimes->{{3.998842123863503*^9, 3.998842123867635*^9}},
 CellID->1491608198,ExpressionUUID->"67d21490-1e76-4c3a-a92f-153877576e63"],

Cell["\<\
Expands the package into the domain of quantum hydrodynamics and Bohmian \
mechanics. This extension natively evaluates probability current densities, \
exact quantum trajectories, and dynamic quantum potentials derived directly \
from the underlying parameter bus.\
\>", "Text",
 CellID->733444042,ExpressionUUID->"423df06a-ba3c-40d2-af65-20ce3dee6f99"],

Cell[CellGroupData[{

Cell["\<\
Initialize the hydrodynamics extension, query the available Bohmian \
observables, and plot the exact quantum trajectories for a harmonic \
oscillator.\
\>", "MathCaption",
 CellChangeTimes->{3.9988426804660177`*^9},
 CellID->1335236354,ExpressionUUID->"c8a53094-ab60-47e9-9729-718e5b420619"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<GWPTools`GWPHydrodynamics`\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
  RowBox[{"\"\<Properties\>\"", ",", "\"\<BohmianTrajectories\>\""}], "]"}], "\n", 
