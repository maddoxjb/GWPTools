 RowBox[{"OBJ1", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}]}], "\n", 
 RowBox[{"OBJ2", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{"1", ",", 
    RowBox[{"-", "2"}]}], "]"}]}], "\n", 
 RowBox[{"OBJ3", "=", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{"1", ",", 
    RowBox[{"-", "2"}], ",", "5", ",", 
    RowBox[{"\[Pi]", "/", "2"}]}], "]"}]}]}], "Input",
