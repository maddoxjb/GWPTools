Cell[CellGroupData[{

Cell["Tracing Phase Space Trajectories", "Subsection",
 CellChangeTimes->{{3.998836208146285*^9, 3.9988362132097692`*^9}},
 CellID->422406274,ExpressionUUID->"f5e8a555-166a-4386-892c-748394287a83"],

Cell[TextData[{
 "Global kinematic observables, such as expected position and momentum, \
evaluate as pure temporal functions [t] when a dynamic potential is active. \
By evaluating these expectation values as continuous functions of time, exact \
phase-space trajectories (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftAngleBracket]", 
         OverscriptBox[
          StyleBox["p", "TI"], "^"], "\[RightAngleBracket]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\hat{p} \\rangle", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6addf19a-0c16-4391-aec3-e9894a145150"],
 " vs ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LeftAngleBracket]", 
         OverscriptBox[
          StyleBox["x", "TI"], "^"], "\[RightAngleBracket]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\langle \\hat{x} \\rangle", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d998d793-33e2-4ec6-bc93-f07de12da439"],
 ") can be traced analytically without numerical differential equation \
solvers."
}], "Text",
 CellChangeTimes->{{3.998836335215136*^9, 3.998836373137432*^9}},
 CellID->556100993,ExpressionUUID->"e64720b6-11f6-4775-9ffd-ac77770afa08"],

Cell[CellGroupData[{

Cell["\<\
Initialize a non-resonant forced harmonic oscillator and trace its \
phase-space trajectory over multiple driving cycles.\
\>", "MathCaption",
 CellChangeTimes->{3.998836322564973*^9},
 CellID->1295874039,ExpressionUUID->"6f27df0f-d90f-4666-9829-03160fcfe88c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"drivenObj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"\"\<Potential\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<NonResonantForcedHO\>\"", ",", "1", ",", 
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"6", "/", "10"}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"drivenObj", "[", "\"\<PositionExpectation\>\"", "]"}], "[", 
      "t", "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"drivenObj", "[", "\"\<MomentumExpectation\>\"", "]"}], "[", 
      "t", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", "\[Pi]"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Position\>\"", ",", "\"\<Momentum\>\""}], "}"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}], "Input",
 CellChangeTimes->{
  3.998836302706772*^9, {3.998841352225869*^9, 3.998841354313147*^9}},
 CellLabel->"In[33]:=",
 CellID->2123309246,ExpressionUUID->"8ac73ce8-9167-4b15-98d4-7b605699f95a"],

