Cell[CellGroupData[{

Cell["Evaluate the time-dependent position expectation value.", "MathCaption",
 CellChangeTimes->{{3.998777230998659*^9, 3.998777232312152*^9}, 
   3.9987822509798183`*^9},
 CellID->1810526138,ExpressionUUID->"17233035-7fd5-4a07-95cd-cb01ee8624cc"],

Cell[CellGroupData[{

