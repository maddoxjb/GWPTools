Cell[CellGroupData[{

Cell["\<\
Evaluate a global property for both states to observe the signature shift.\
\>", "MathCaption",
 CellChangeTimes->{3.998831450623365*^9, 3.998834626839079*^9},
 CellID->1351392919,ExpressionUUID->"e30a6f73-0364-49a8-bcef-2573f81de435"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"objStatic", "[", "\"\<PositionUncertainty\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"objDynamic", "[", "\"\<PositionUncertainty\>\"", "]"}], "[", "t", 
  "]"}]}], "Input",
 CellChangeTimes->{3.998831440059148*^9, 3.998834635481368*^9},
 CellLabel->"In[17]:=",
