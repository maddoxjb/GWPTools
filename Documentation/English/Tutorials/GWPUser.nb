Cell["GWPPhaseSpace: ", "Text",
 CellChangeTimes->{{3.99884212755258*^9, 3.998842127556512*^9}},
 CellID->2039688374,ExpressionUUID->"0c7ebff5-2add-43a7-8dc8-a2d737b01d14"],

Cell["\<\
Shifts the analytical focus entirely into the phase-space formulation of \
quantum mechanics. This module computes exact Wigner quasi-probability \
distributions and Husimi Q-functions, providing rigorous tools for \
investigating classical-quantum correspondence and phase-space structures.\
\>", "Text",
 CellChangeTimes->{3.998843051389093*^9},
 CellID->1433311079,ExpressionUUID->"964529ce-6fa2-4632-aa02-104e9960918f"],

Cell[CellGroupData[{

Cell["\<\
Initialize the phase-space extension and evaluate the exact analytical Wigner \
distribution.\
\>", "MathCaption",
 CellChangeTimes->{3.998843067307682*^9},
 CellID->492402937,ExpressionUUID->"99b8bf2a-5648-42fc-927e-c21b4b4453e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<GWPTools`GWPPhaseSpace`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<WignerFunction\>\"", 
   "]"}], "[", 
  RowBox[{"x", ",", "p"}], "]"}]}], "Input",
 CellChangeTimes->{{3.998842376816781*^9, 3.998842412718157*^9}},
 CellLabel->"In[45]:=",
 CellID->1561670268,ExpressionUUID->"5b5f9e8f-4d1a-40a8-87b4-d2d338ab45f2"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     SuperscriptBox["p", "2"]}], "-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"]}]], "\[Pi]"]], "Output",
 CellChangeTimes->{4.0004128474929028`*^9},
 CellLabel->"Out[46]=",
 CellID->1896494985,ExpressionUUID->"465736d1-bf32-4a71-b0cf-4a818ba7b8b2"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
}, Open  ]],

