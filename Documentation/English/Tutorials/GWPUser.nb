Cell["GWP[\"RDM1D\"]\[LongDash]Reduced Density Matrix in 1D Space: ", "Text",
 CellChangeTimes->{{3.998841546337215*^9, 3.99884155301873*^9}, {
  3.998842631691491*^9, 3.998842631695059*^9}},
 CellID->949902174,ExpressionUUID->"070982ab-970e-46f0-b2ab-9c29776e040e"],

Cell["\<\
Introduces mixed quantum states and open-system dynamics. This experimental \
framework expands the GWP formalism into Liouville space to model \
decoherence, thermal distributions, and environmental coupling.\
\>", "Text",
 CellChangeTimes->{{3.998841546337215*^9, 3.99884155301873*^9}, {
  3.998842640453121*^9, 3.998842642104362*^9}},
 CellID->1585053832,ExpressionUUID->"2e9ba8fb-4179-40ed-908e-97d76ad4c3d7"],

Cell[CellGroupData[{

Cell["\<\
Initialize the reduced density matrix type and plot the damped spatial \
trajectory of an open quantum system.\
\>", "MathCaption",
 CellChangeTimes->{
  3.998842664666636*^9, {3.9988433822272863`*^9, 3.998843386979985*^9}},
 CellID->1282215542,ExpressionUUID->"a52dcb8f-e191-4527-8836-2cbc7996f173"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<GWPTools`GWPEngineRDM1D`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GWP", "[", "\"\<RDM1D\>\"", "]"}], "[", 
      RowBox[{
       RowBox[{"1", "/", "4"}], ",", "1", ",", 
       RowBox[{"\"\<Potential\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<HarmonicCL\>\"", ",", "1", ",", 
          RowBox[{"1", "/", "2"}], ",", "1"}], "}"}]}]}], "]"}], 
     "[", "\"\<PositionCenter\>\"", "]"}], "[", "t", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"4", " ", "Pi"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.998841918600737*^9, 3.9988420779828043`*^9}, 
   3.99884265337607*^9},
 CellLabel->"In[39]:=",
