 CellLabel->"Out[17]=",
 CellID->15856027,ExpressionUUID->"06c90c8b-e47b-4330-ae78-ae22909d8914"],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox["t", "2"], "4"]}]]]]], "Output",
 CellChangeTimes->{4.000412843244946*^9},
 CellLabel->"Out[18]=",
 CellID->204273561,ExpressionUUID->"4b322117-3661-48ba-a1ca-1f4ff2688e09"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the exact 1st-order spatial derivative of the static and dynamic \
probability densities.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9988346619407*^9, {3.998834706078085*^9, 3.998834712851453*^9}},
 CellID->1059743372,ExpressionUUID->"dff29d08-9416-4cde-9fd2-6d2b5fce2f10"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"objStatic", "[", 
   RowBox[{"\"\<DensityX\>\"", ",", "1"}], "]"}], "[", "x", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"objDynamic", "[", 
    RowBox[{"\"\<DensityX\>\"", ",", "1"}], "]"}], "[", 
   RowBox[{"x", ",", "t"}], "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998834672349084*^9, 3.998834724196628*^9}},
 CellLabel->"In[19]:=",
 CellID->2024968633,ExpressionUUID->"c465f3fa-e9a9-4645-b142-9a4e9921789c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
