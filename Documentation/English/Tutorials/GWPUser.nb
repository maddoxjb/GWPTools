Cell[CellGroupData[{

Cell["Future Directions", "Section",
 CellChangeTimes->{{3.9987623434140253`*^9, 3.9987623469955883`*^9}, {
   3.998836067938923*^9, 3.998836075500267*^9}, 3.9988416165795803`*^9},
 CellID->130795178,ExpressionUUID->"9a8845eb-0062-41ff-bc7c-7c803ebcf133"],

Cell["\<\
While the core \"1D\" wavepacket type provides a robust foundation for \
single-state quantum dynamics, the GWPTools framework is architecturally \
designed to be highly extensible. Several advanced physical models and \
multi-dimensional state types are currently under active development. Because \
these modules are experimental, they are not loaded by default and must be \
explicitly initialized using the Needs command prior to passing their type \
strings to the GWP constructor.\
\>", "Text",
 CellChangeTimes->{{3.998843303084453*^9, 3.998843308901184*^9}},
 CellID->284516125,ExpressionUUID->"11aaa68b-b9d7-45dc-b8c2-5c271e0c5fb0"],

Cell[CellGroupData[{

Cell["Experimental Wavepacket Types", "Subsection",
 CellChangeTimes->{3.998841487616323*^9},
 CellID->1563914653,ExpressionUUID->"11fe37bc-69f5-4b88-91c3-123949526cdf"],

Cell["GWP[\"2D\"]\[LongDash]Single Wavepackets in 2D Space: ", "Text",
 CellChangeTimes->{{3.9988415111132393`*^9, 3.998841516540584*^9}, {
  3.998841641832478*^9, 3.998841641836459*^9}},
 CellID->1661217338,ExpressionUUID->"a988a47e-c03b-4fd4-9d74-218d27725ced"],

Cell["\<\
Extends the generalized Gaussian formalism to two spatial dimensions. This \
module evaluates 2D potential energy surfaces, coupled coordinate kinematics, \
and complex momentum-space dynamics.\
\>", "Text",
 CellChangeTimes->{{3.9988415111132393`*^9, 3.998841516540584*^9}, {
   3.998841645870076*^9, 3.998841666393426*^9}, 3.998842510348754*^9},
 CellID->424556240,ExpressionUUID->"196fe45a-9e65-45dc-ab66-206ee9929761"],

Cell[CellGroupData[{

Cell["\<\
Initialize the 2D wavepacket type and evaluate the time-dependent spatial \
density for a free particle.\
\>", "MathCaption",
 CellChangeTimes->{
  3.998842520010406*^9, {3.9988433320624933`*^9, 3.9988433545747232`*^9}},
 CellID->879715986,ExpressionUUID->"e38f4639-c959-4f41-a3ce-a12b8a63fdba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<GWPTools`GWPEngine2D`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", "\"\<2D\>\"", "]"}], "[", 
     RowBox[{"\"\<Potential\>\"", "->", "\"\<Free\>\""}], "]"}], 
    "[", "\"\<DensityX\>\"", "]"}], "[", 
   RowBox[{"x", ",", "y", ",", "t"}], "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998841685424713*^9, 3.998841752916754*^9}},
 CellLabel->"In[35]:=",
 CellID->2109150754,ExpressionUUID->"3bd40b9b-aed9-4bdb-8a91-757e3970649c"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}], ")"}]}], 
      RowBox[{"1", "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["t", "2"]}]}]]}]], " ", 
   SqrtBox[
    FractionBox["1", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"1", "+", 
        RowBox[{"4", " ", 
         SuperscriptBox["t", "2"]}]}], ")"}], "2"]]]}], "\[Pi]"]], "Output",
 CellChangeTimes->{4.000412844494351*^9},
 CellLabel->"Out[36]=",
 CellID->1218541401,ExpressionUUID->"83da696f-794c-433d-b204-b33295b48a24"]
}, Open  ]]
}, Open  ]],

Cell["GWP[\"SS1D\"]\[LongDash]Superposition States in 1D Space: ", "Text",
 CellChangeTimes->{{3.998841528556419*^9, 3.9988415317790527`*^9}, {
  3.998841649825223*^9, 3.998841649829062*^9}},
 CellID->644905119,ExpressionUUID->"eb215225-6cd1-40dc-8e9c-c59181110903"],

Cell["\<\
Implements coherent quantum superposition states. By evaluating the \
off-diagonal cross-density terms between multiple discrete Gaussian \
wavepackets, this engine exactly resolves transient quantum interference \
patterns and time-dependent overlap integrals.\
\>", "Text",
 CellChangeTimes->{{3.998841528556419*^9, 3.9988415317790527`*^9}, {
  3.998841670410796*^9, 3.998841671020361*^9}},
 CellID->238151415,ExpressionUUID->"9e871a72-7ca3-4f9c-bfaf-48ebf5361654"],

Cell[CellGroupData[{

Cell["\<\
Initialize the superposition type and plot the interference pattern of a \
discrete 1D spatial density.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9988425351881323`*^9, {3.9988433451875896`*^9, 3.998843360382574*^9}},
 CellID->129786074,ExpressionUUID->"a6c32d3d-07b4-4c4a-b5f8-0500de4ba663"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<GWPTools`GWPEngineSS1D`\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"GWP", "[", "\"\<SS1D\>\"", "]"}], "[", "]"}], 
     "[", "\"\<DensityX\>\"", "]"}], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.998841773979024*^9, 3.998841841432118*^9}, {
  3.9988418855164413`*^9, 3.998841900644362*^9}, {3.9988425481486473`*^9, 
  3.998842621680387*^9}},
 CellLabel->"In[37]:=",
