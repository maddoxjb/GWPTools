Cell[CellGroupData[{

Cell["Mathematical Definitions", "Section",
 CellID->2035642797,ExpressionUUID->"21ce5697-6447-44ee-88ae-768d40bff616"],

Cell["\<\
The mathematical foundation of quantum fluid dynamics (hydrodynamics) relies \
on decomposing the complex wavefunction into strictly real-valued density and \
phase components. This section details the formal definitions and algebraic \
strategies used by the GWPHydrodynamics to evaluate these fields and \
observables.\
\>", "Text",
 CellChangeTimes->{
  3.998665039369185*^9, {3.998673402665344*^9, 3.9986734043865*^9}},
 CellID->1486508822,ExpressionUUID->"a57be6b0-d328-4b45-acfd-d4646ee03da9"],

Cell[CellGroupData[{

Cell["The Madelung Representation (Spatial Fields)", "Subsection",
 CellChangeTimes->{{3.9986650727294693`*^9, 3.9986650849912977`*^9}},
 CellID->1350145129,ExpressionUUID->"861e4c23-d1b2-4824-98b6-0dd74a79208f"],

Cell[CellGroupData[{

Cell["\<\
The Madelung transformation expresses the position-space wavefunction in \
complex-polar form as\
\>", "Text",
 CellChangeTimes->{{3.9986804461397753`*^9, 3.998680447592473*^9}},
 CellID->2043889973,ExpressionUUID->"c22642f0-942b-4ea3-a4cd-6f1d7803a9e8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"R", "(", 
      RowBox[{"x", ",", "t"}], ")"}], " ", 
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{"S", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], ")"}]}], "=", 
    RowBox[{
     SqrtBox[
      RowBox[{"\[Rho]", "(", 
       RowBox[{"x", ",", "t"}], ")"}]], 
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{"S", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.9986661676166887`*^9, 3.9986661907322206`*^9}, {3.9986784847802057`*^9, 
  3.9986785164344997`*^9}, {3.998680696580627*^9, 3.9986807103506393`*^9}, {
  3.998727454087328*^9, 3.998727455384721*^9}, {3.9987275931663313`*^9, 
  3.998727610222084*^9}},
 FontSize->16,
 CellID->839912931,ExpressionUUID->"6761897b-c250-49b0-91e7-e94150ab4ff8"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["R", "TI"], TraditionalForm], "errors" -> {}, "input" -> "R",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"x", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "1f706e5f-b20f-492b-8df9-fe4e265ebb26"],
 " is the amplitude (note that AX, amplitude as a function of x, is the \
symbol used), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|
     "boxes" -> FormBox["\[Rho]", TraditionalForm], "errors" -> {}, "input" -> 
      "\\rho", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"x", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a0034257-437d-4f13-ba1f-ccd72a184002"],
 " is the probability density, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        StyleBox["S", "TI"], TraditionalForm], "errors" -> {}, "input" -> "S",
       "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"x", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "2e09f39b-06e1-4ade-ac46-002b270647b4"],
 " is the quantum action (phase)."
}], "Text",
 CellChangeTimes->{
  3.998678383140994*^9, {3.998678521763647*^9, 3.998678546151569*^9}, {
   3.998680314535912*^9, 3.9986803601053133`*^9}, {3.998680398509454*^9, 
   3.998680399926701*^9}, {3.998680908403202*^9, 3.998680931810961*^9}, {
   3.998727616738353*^9, 3.998727632385309*^9}},
 CellID->264705572,ExpressionUUID->"1b55e632-b6d3-4aa5-8b5a-7b79d672e49b"],

Cell[CellGroupData[{

Cell["For a GWP, the density is given by", "Text",
 CellChangeTimes->{{3.998680364743472*^9, 3.998680375887224*^9}},
 CellID->707835480,ExpressionUUID->"c1b36976-33ad-4e0d-9bd2-fc8d8666c696"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "2"}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.9986661676166887`*^9, 3.9986661907322206`*^9}, {3.9986784847802057`*^9, 
  3.9986785164344997`*^9}, {3.9986801453569107`*^9, 3.998680200875682*^9}, {
  3.998727642739846*^9, 3.9987276436624928`*^9}},
 FontSize->16,
 CellID->432264403,ExpressionUUID->"dbe5a0eb-363f-47dd-86ef-3f33bad06dfd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["and the phase is given by ", "Text",
 CellChangeTimes->{{3.9986803857922897`*^9, 3.9986804164896297`*^9}},
 CellID->1983553159,ExpressionUUID->"f493bca6-dc11-473f-b401-c674af4afa1c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"S", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[HBar]"}], " ", 
     RowBox[{"Im", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "t"]}], ")"}], "2"]}], "+", 
    RowBox[{
     SubscriptBox["p", "t"], "(", 
     RowBox[{"x", "-", 
      SubscriptBox["x", "t"]}], ")"}], "+", 
    RowBox[{"Re", "(", 
     SubscriptBox["\[Gamma]", "t"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.9986661676166887`*^9, 3.9986661907322206`*^9}, {3.9986784847802057`*^9, 
  3.9986785164344997`*^9}, {3.9986801453569107`*^9, 3.998680261617053*^9}, {
  3.998727645719921*^9, 3.9987276465835667`*^9}},
 FontSize->16,
 CellID->1861319590,ExpressionUUID->"ba4e975b-6617-4243-a335-7b2ce9d7609d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
From the Madelung decomposition, the continuous kinematic fields of the \
quantum fluid are defined. The flow velocity field (or drift velocity) \
describes the classical-like transport of the probability fluid and is \
derived strictly from the phase gradient:\
\>", "Text",
 CellChangeTimes->{{3.9986785756115932`*^9, 3.9986785762387733`*^9}, {
  3.998680478044944*^9, 3.998680482264803*^9}},
 CellID->136566547,ExpressionUUID->"3729bfa0-de63-490b-9518-9a3329e8767d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"v", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "m"], 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"S", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]]}], "=", 
    RowBox[{
     FractionBox["1", "m"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["p", "t"], "-", 
       RowBox[{"2", "\[HBar]", " ", 
        RowBox[{"Im", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], 
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.9986743542458467`*^9, 
  3.998674354941443*^9}, {3.998678579635075*^9, 3.998678580371131*^9}, {
  3.998679012176805*^9, 3.998679046134392*^9}, {3.998727652062415*^9, 
  3.9987276592466717`*^9}},
 FontSize->16,
 CellID->1761420433,ExpressionUUID->"9f3fdf2d-e8ef-4649-bb03-1bccadbf2d9c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The osmotic velocity describes the quantum diffusion characteristic of the \
fluid's tendency to spread, derived from the amplitude gradient:\
\>", "Text",
 CellChangeTimes->{3.998665275135087*^9},
 CellID->960847319,ExpressionUUID->"78fb267b-7f2a-4bd6-9391-076b3f2d65f8"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"u", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["\[HBar]", 
      RowBox[{"2", "m", " "}]], 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", " ", "ln"}], " ", 
       RowBox[{"\[Rho]", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", "\[HBar]"}], "m"]}], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "t"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.9986652968652163`*^9}, {3.9986663119266663`*^9, 
  3.9986663150743923`*^9}, {3.998674357171361*^9, 3.99867445147119*^9}, {
  3.998678585628017*^9, 3.998678586313683*^9}, {3.998679058588147*^9, 
  3.9986790783194437`*^9}, {3.9987276686832523`*^9, 3.998727688890442*^9}},
 FontSize->16,
 CellID->2134541820,ExpressionUUID->"0cc32cc6-779f-4902-829d-d219d74a9ebb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The probability current density relates the flow velocity to the spatial \
density:\
\>", "Text",
 CellChangeTimes->{{3.998665304546253*^9, 3.998665319060063*^9}},
 CellID->1361428419,ExpressionUUID->"7f76a51f-bffb-4e29-908a-319f70bfdcc1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"j", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], " ", 
    RowBox[{"v", "(", 
     RowBox[{"x", ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
  3.998665336124662*^9}, {3.998674458954301*^9, 3.998674462715622*^9}, {
  3.99867859249408*^9, 3.998678593176976*^9}, {3.998679100140874*^9, 
  3.998679112393547*^9}, {3.998727697909542*^9, 3.998727703627522*^9}},
 FontSize->16,
 CellID->463072375,ExpressionUUID->"f37c7aa8-fa8c-414c-b26e-7b363be2ab54"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The non-classical behavior of the fluid is governed by the quantum potential, \
a scalar field originating from the curvature of the amplitude:\
\>", "Text",
 CellChangeTimes->{{3.998665340436545*^9, 3.998665370991892*^9}, {
  3.9986749245113897`*^9, 3.998674929580172*^9}},
 CellID->218887043,ExpressionUUID->"18f466f5-c939-4e27-8dbe-c8eb2530ba18"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"2", "m"}]]}], 
    FractionBox["1", 
     RowBox[{"R", "(", 
      RowBox[{"x", ",", "t"}], ")"}]], 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[PartialD]", "2"], 
      RowBox[{"R", "(", 
       RowBox[{"x", ",", "t"}], ")"}]}], 
     RowBox[{"\[PartialD]", "x"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
   3.998665336124662*^9}, {3.998665384509428*^9, 3.998665415945456*^9}, {
   3.9986663174183817`*^9, 3.99866631965902*^9}, {3.998673474405555*^9, 
   3.998673478512664*^9}, {3.99867352549179*^9, 3.9986735468166428`*^9}, 
   3.9986735910507193`*^9, {3.998674320944003*^9, 3.9986743242920437`*^9}, 
   3.9986749195950327`*^9, {3.9986786016070833`*^9, 3.9986786022813053`*^9}, {
   3.9986791191540728`*^9, 3.998679120674141*^9}, {3.9986792266256647`*^9, 
   3.998679254307065*^9}, {3.998727720741728*^9, 3.998727744711031*^9}, {
   3.998728179112956*^9, 3.998728233654278*^9}},
 FontSize->16,
 CellID->818975787,ExpressionUUID->"0105dcc5-7e8d-4cbf-bc90-ed8a8b738cd6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"4", "m"}]]}], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"\[Rho]", "(", 
         RowBox[{"x", ",", "t"}], ")"}]], 
       FractionBox[
        RowBox[{
         SuperscriptBox["\[PartialD]", "2"], 
         RowBox[{"\[Rho]", "(", 
          RowBox[{"x", ",", "t"}], ")"}]}], 
        RowBox[{"\[PartialD]", 
         SuperscriptBox["x", "2"]}]]}], "-", 
      RowBox[{
       FractionBox["1", "2"], 
       FractionBox["1", 
        SuperscriptBox[
         RowBox[{"\[Rho]", "(", 
          RowBox[{"x", ",", "t"}], ")"}], "2"]], 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{"\[PartialD]", 
           RowBox[{"\[Rho]", "(", 
            RowBox[{"x", ",", "t"}], ")"}]}], 
          RowBox[{"\[PartialD]", "x"}]], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
   3.998665336124662*^9}, {3.998665384509428*^9, 3.998665415945456*^9}, {
   3.9986663174183817`*^9, 3.99866631965902*^9}, {3.998673474405555*^9, 
   3.998673478512664*^9}, {3.99867352549179*^9, 3.9986735468166428`*^9}, 
   3.9986735910507193`*^9, {3.998674320944003*^9, 3.9986743242920437`*^9}, 
   3.9986749195950327`*^9, {3.9986786016070833`*^9, 3.9986786022813053`*^9}, {
   3.9986791191540728`*^9, 3.998679120674141*^9}, {3.9986792266256647`*^9, 
   3.998679254307065*^9}, {3.998727720741728*^9, 3.998727744711031*^9}, {
   3.998728179112956*^9, 3.99872823610931*^9}},
 FontSize->16,
 CellID->824558605,ExpressionUUID->"6262888d-c3ec-45b4-8338-b27d832d5d0b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}]}], "m"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
   3.998665336124662*^9}, {3.998665384509428*^9, 3.998665415945456*^9}, {
   3.9986663174183817`*^9, 3.99866631965902*^9}, {3.998673474405555*^9, 
   3.998673478512664*^9}, {3.99867352549179*^9, 3.9986735468166428`*^9}, 
   3.9986735910507193`*^9, {3.998674320944003*^9, 3.9986743242920437`*^9}, 
   3.9986749195950327`*^9, {3.9986786016070833`*^9, 3.9986786022813053`*^9}, {
   3.9986791191540728`*^9, 3.998679120674141*^9}, {3.9986792266256647`*^9, 
   3.998679254307065*^9}, {3.998727720741728*^9, 3.998727744711031*^9}, 
   3.9987282265367327`*^9},
 FontSize->16,
 CellID->1798485045,ExpressionUUID->"780867b5-aa91-4df1-8ae8-8ec8d2ac4887"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The spatial gradient of the quantum potential yields the quantum force, which \
acts sequentially alongside classical external forces to dictate the \
acceleration of the fluid elements:\
\>", "Text",
 CellID->809506130,ExpressionUUID->"19445eb0-cb43-4e08-8198-eec2b86f7b1c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["F", "Q"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{"Q", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "x"}]]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{"4", 
       SuperscriptBox["\[HBar]", "2"]}], "m"], 
     SuperscriptBox[
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], "2"], 
     RowBox[{"(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "t"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
  3.998665336124662*^9}, {3.998665384509428*^9, 3.998665457942409*^9}, {
  3.99867434076523*^9, 3.9986743416242743`*^9}, {3.998674937315954*^9, 
  3.998675014897758*^9}, {3.998678603800861*^9, 3.998678604447907*^9}, {
  3.998679261081417*^9, 3.9986792836930103`*^9}, {3.998727751306879*^9, 
  3.99872776087506*^9}},
 FontSize->16,
 CellID->1060623165,ExpressionUUID->"a3c08e23-3172-4199-ae21-45fccdc354c9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The quantum force acting on the fluid can be viewed macroscopically as \
arising from an internal dispersive pressure. This is quantified by the \
quantum stress density, which is defined such that its spatial gradient \
exactly equals the local probability-weighted quantum force (the force \
density):\
\>", "Text",
 CellChangeTimes->{{3.998666546025383*^9, 3.998666550266405*^9}, 
   3.998672775746653*^9, {3.9986738529970818`*^9, 3.9986738744866867`*^9}, {
   3.998675646966443*^9, 3.9986756653250103`*^9}, {3.99867590673062*^9, 
   3.998675907425918*^9}},
 CellID->1964568486,ExpressionUUID->"8235fa3b-c70f-4959-83c4-8fcdca48d6e4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     RowBox[{
      SubscriptBox["\[Sigma]", "Q"], "(", 
      RowBox[{"x", ",", "t"}], ")"}]}], 
    RowBox[{"\[PartialD]", "x"}]], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], " ", 
    RowBox[{
     SubscriptBox["F", "Q"], "(", 
     RowBox[{"x", ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
   3.998665336124662*^9}, {3.998665384509428*^9, 3.998665457942409*^9}, {
   3.998672806309188*^9, 3.998672844355316*^9}, {3.99867375175804*^9, 
   3.9986737726758223`*^9}, {3.9986744778311987`*^9, 3.998674484453597*^9}, {
   3.998674868663043*^9, 3.998674870620101*^9}, 3.998675354958289*^9, {
   3.998678608198143*^9, 3.998678609008111*^9}, {3.998727768301772*^9, 
   3.998727774372973*^9}},
 FontSize->16,
 CellID->1217717648,ExpressionUUID->"1d3fecc8-5d20-4ddf-aa1d-b56c1c7922e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The general analytical definition in terms of the probability fluid is:\
\>", "Text",
 CellChangeTimes->{3.998673842179223*^9},
 CellID->757563811,ExpressionUUID->"4b06e0ad-562b-47b5-a0c5-5cd7c0abc590"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[Sigma]", "Q"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"4", "m"}]], 
     RowBox[{"\[Rho]", "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "ln"}], " ", 
       RowBox[{"\[Rho]", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["x", "2"]}]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[HBar]", "2"], "m"]}], 
     RowBox[{"Re", "(", 
      SubscriptBox["\[Alpha]", "t"], ")"}], 
     RowBox[{"\[Rho]", "(", 
      RowBox[{"x", ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.9986652968652163`*^9}, {3.998665327020936*^9, 
   3.998665336124662*^9}, {3.998665384509428*^9, 3.998665457942409*^9}, {
   3.998672806309188*^9, 3.998672844355316*^9}, {3.998674490239106*^9, 
   3.998674503085972*^9}, 3.998675365839126*^9, {3.998675911790348*^9, 
   3.998675912762458*^9}, 3.9986782463662786`*^9, {3.998727776810728*^9, 
   3.998727791247723*^9}},
 FontSize->16,
 CellID->174092871,ExpressionUUID->"1e07c38c-73c3-4e02-bc3e-d40989c5af37"]
}, Open  ]],

Cell["\<\
Because the spatial probability density of a generalized Gaussian wavepacket \
is perfectly Gaussian, the second derivative of its logarithm is a spatial \
constant. This allows the quantum stress density to be evaluated exactly \
algebraically in the last equality above.\
\>", "Text",
 CellChangeTimes->{{3.998675842295824*^9, 3.998675848767673*^9}, {
   3.998727861537918*^9, 3.9987278793624153`*^9}, 3.998744514751725*^9},
 CellID->83013604,ExpressionUUID->"fb915dea-8e8f-4607-b4d5-0a51e2350e85"],

Cell["\<\
This demonstrates an elegant property of the GWP: its local quantum stress is \
strictly proportional to its position-space probability density, scaled by a \
negative constant derived from the real shape parameter. Physically, this \
negative stress acts as a compressive pressure centered at the peak of the \
wavepacket, generating the outward quantum force that drives spatial \
dispersion.\
\>", "Text",
 CellID->479154322,ExpressionUUID->"589c1512-d3e8-4a9c-bfed-afe5d353e464"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Asymmetry of Phase-Space Hydrodynamics", "Subsection",
 CellChangeTimes->{{3.998694042473464*^9, 3.99869406141306*^9}},
 CellID->218119123,ExpressionUUID->"8c8b5ebf-2ba6-4cca-91ac-eb677716fbcd"],

Cell[CellGroupData[{

Cell[TextData[{
 "While the polar decomposition applies equally to both position-space and \
momentum-space domains, the position space is mathematically privileged in ",
 StyleBox["non-relativistic",
  FontWeight->"Bold"],
 " quantum hydrodynamics. Because the kinetic energy operator is strictly a \
local second-order spatial derivative"
}], "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693279298918*^9, 3.9986932793018847`*^9}, 3.998693312534964*^9, {
   3.998694098179576*^9, 3.9986941293197536`*^9}, {3.998694159704495*^9, 
   3.998694170136386*^9}, {3.998694322614642*^9, 3.998694338312089*^9}},
 CellID->1829630637,ExpressionUUID->"867b7789-9791-4575-a428-12f8e7c5630d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["T", "^"], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], 
      RowBox[{"2", "m"}]]}], 
    FractionBox[
     SuperscriptBox["\[PartialD]", "2"], 
     RowBox[{"\[PartialD]", 
      SuperscriptBox["x", "2"]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998693292512281*^9, 
  3.998693308729375*^9}, {3.998694209428694*^9, 3.998694233352777*^9}},
 FontSize->16,
 CellID->1389795900,ExpressionUUID->"0b0431f8-f8c2-4c22-934a-c54d7664c7e0"]
}, Open  ]],

Cell["\<\
the position-space Madelung equations always decouple into perfectly \
localized flow and osmotic fields, regardless of the external potential. \
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693279298918*^9, 3.9986932793018847`*^9}, 3.998693312534964*^9, {
   3.998694098179576*^9, 3.9986941293197536`*^9}, {3.998694159704495*^9, 
   3.99869415970774*^9}},
 CellID->254189216,ExpressionUUID->"89cf9b83-166a-41d3-aa05-158f0cf1d8da"],

Cell[CellGroupData[{

Cell["\<\
In momentum space, the roles reverse. The potential energy operator acts as a \
pseudo-differential operator\
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693279298918*^9, 3.9986932793018847`*^9}, 3.998693312534964*^9, {
   3.998694098179576*^9, 3.9986941293197536`*^9}},
 CellID->1958155702,ExpressionUUID->"361cfa67-6797-4639-a131-5b2f3f56c82b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox["V", "^"], "=", 
   RowBox[{"V", "(", 
    RowBox[{"\[ImaginaryI]", " ", "\[HBar]", 
     FractionBox["\[PartialD]", 
      RowBox[{"\[PartialD]", "p"}]]}], ")"}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
   3.998682594210277*^9, 3.998682649755145*^9}, {3.998693292512281*^9, 
   3.998693308729375*^9}, 3.99869551109604*^9},
 FontSize->16,
 CellID->730088209,ExpressionUUID->"531d2327-09d3-49e6-b04a-c1da9c5ffeb6"]
}, Open  ]],

Cell["\<\
If the potential contains cubic or higher-order anharmonic terms, this \
operator becomes non-local, transforming the momentum transport equations \
into complex convolution integrals, where local concepts of \"flow\" and \
\"diffusion\" completely break down. \
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693401171455*^9, 3.9986934217285633`*^9}, 3.998693907807476*^9, {
   3.998694289488304*^9, 3.9986942975487223`*^9}, 3.998694379305797*^9},
 CellID->2050535088,ExpressionUUID->"6439b49d-dc39-45a3-ab4a-5a1cde6853c2"],

Cell[CellGroupData[{

Cell["\<\
However, for systems where the external potential is at most quadratic, i.e., \
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693401171455*^9, 3.9986934217285633`*^9}, 3.998693907807476*^9, 
   3.998694289488304*^9, {3.998694436129917*^9, 3.9986944361316*^9}, {
   3.998694498727789*^9, 3.9986945253850403`*^9}},
 CellID->472042195,ExpressionUUID->"c6a581ce-33d6-413e-9624-75c14a37ce29"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", "x", ")"}], "=", 
   RowBox[{
    SubscriptBox["V", "0"], "+", 
    RowBox[{
     SubscriptBox["V", "1"], "x"}], "+", 
    RowBox[{
     SubscriptBox["V", "2"], 
     SuperscriptBox["x", "2"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998693292512281*^9, 
  3.998693308729375*^9}, {3.99869444669024*^9, 3.998694464085166*^9}},
 FontSize->16,
 CellID->1307285349,ExpressionUUID->"613617d1-7fc0-42b0-aefe-adb15f91593f"]
}, Open  ]],

Cell["\<\
then the momentum-space operator remains strictly second-order. \
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693401171455*^9, 3.9986934217285633`*^9}, 3.998693907807476*^9, 
   3.998694289488304*^9, 3.998694467790794*^9, {3.9986945301750183`*^9, 
   3.998694549551711*^9}},
 CellID->369638798,ExpressionUUID->"4fea1ca0-d9b4-47f5-8857-7ebcb50de97e"],

Cell[TextData[{
 "This form perfectly preserves the mathematical symmetry between the \
position-space and momentum-space domains, where the spatial curvature of the \
potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "V_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44afba08-08af-4558-b980-b6a4f185460b"],
 " exactly mirrors the role of the inverse mass factor ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        RowBox[{"(", 
          RowBox[{"2", 
            StyleBox["m", "TI"]}], ")"}], "-1"], TraditionalForm], 
     "errors" -> {}, "input" -> "(2m)^{-1}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "433be266-cc9a-418b-bffd-e5b72b0345da"],
 " in the position-space domain."
}], "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693401171455*^9, 3.9986934217285633`*^9}, 3.998693907807476*^9, 
   3.998694289488304*^9, 3.998694467790794*^9, {3.9986945301750183`*^9, 
   3.99869453133115*^9}, {3.998694564479487*^9, 3.9986946016305943`*^9}, {
   3.998694645092668*^9, 3.998694706606572*^9}, {3.9986947536803637`*^9, 
   3.998694753683034*^9}, {3.9986950994404793`*^9, 3.99869512573251*^9}},
 CellID->1872647400,ExpressionUUID->"71eecf8d-fbe0-44a5-8ca1-ee8a01cd8cf0"],

Cell["\<\
The local hydrodynamic fields presented in the next subsection are therefore \
not approximations, but rather the exact and most general possible forms for \
local momentum-space fluid dynamics. \
\>", "Text",
 CellChangeTimes->{{3.9986930241094112`*^9, 3.99869306199333*^9}, {
   3.998693401171455*^9, 3.9986934217285633`*^9}, 3.998693907807476*^9, 
   3.998694289488304*^9, 3.998694467790794*^9, {3.9986945301750183`*^9, 
   3.99869453133115*^9}, {3.998694564479487*^9, 3.9986946016305943`*^9}, {
   3.998694645092668*^9, 3.998694706606572*^9}, {3.9986951366429787`*^9, 
   3.998695149767111*^9}, 3.9987445639201612`*^9},
 CellID->63427420,ExpressionUUID->"f1a85676-18b5-4415-bfac-1b85303cb5e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Momentum-Space Hydrodynamics", "Subsection",
 CellChangeTimes->{{3.9986650727294693`*^9, 3.9986650849912977`*^9}, {
  3.9986654701580687`*^9, 3.998665477685912*^9}},
 CellID->1933537249,ExpressionUUID->"de6b7078-182d-4932-91e3-6d159fce7053"],

Cell[CellGroupData[{

Cell["\<\
The exact same polar decomposition can be applied to the momentum-space \
wavefunction\
\>", "Text",
 CellChangeTimes->{{3.998665485252578*^9, 3.998665509425202*^9}},
 CellID->747634013,ExpressionUUID->"8a5619c2-2008-4b6c-8b7e-5c6e151d5cf7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalPsi]", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      OverscriptBox["R", "~"], "(", 
      RowBox[{"p", ",", "t"}], ")"}], 
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        OverscriptBox["S", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], ")"}]}], "=", 
    RowBox[{
     SqrtBox[
      RowBox[{
       OverscriptBox["\[Rho]", "~"], "(", 
       RowBox[{"p", ",", "t"}], ")"}]], 
     RowBox[{"exp", "(", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        OverscriptBox["S", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.9986655179831047`*^9, 3.998665536723853*^9}, {3.9986663267584887`*^9, 
   3.9986663270251427`*^9}, {3.998680067938051*^9, 3.998680073212619*^9}, {
   3.9986806534759493`*^9, 3.9986806726544323`*^9}, {3.998680719649049*^9, 
   3.998680734282756*^9}, 3.998682311137292*^9, {3.998727931641686*^9, 
   3.9987279610959883`*^9}},
 FontSize->16,
 CellID->1830927106,ExpressionUUID->"0084c8eb-8a79-4a76-8d98-10bda95596bd"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        OverscriptBox[
         StyleBox["R", "TI"], "~"], TraditionalForm], "errors" -> {}, "input" -> 
      "\\tilde{R}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"p", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "00a99eaf-a181-462a-96c3-1baa9f4b9f27"],
 " is the amplitude (note that AP is the symbol used in the code), ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        OverscriptBox["\[Rho]", "~"], TraditionalForm], "errors" -> {}, 
      "input" -> "\\tilde{\\rho}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"p", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "ffb7bff5-aef6-4fcc-8677-e638c9e66fe5"],
 " is the momentum-space probability density, and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        OverscriptBox[
         StyleBox["S", "TI"], "~"], TraditionalForm], "errors" -> {}, "input" -> 
      "\\tilde{S}", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], 
    RowBox[{"(", 
     RowBox[{"p", ",", "t"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "9b75fb24-d16d-49c7-abde-33cc2b9e61d1"],
 " is the momentum-space phase."
}], "Text",
 CellChangeTimes->{{3.9986808455716457`*^9, 3.9986808993108063`*^9}, {
  3.998680974952016*^9, 3.9986810336014433`*^9}, {3.998692949712981*^9, 
  3.9986929638449917`*^9}, {3.9987279672294416`*^9, 3.998727979439413*^9}},
 CellID->1295893347,ExpressionUUID->"6fbe1bcf-b672-4d90-9dbc-1225bfbd2f51"],

Cell[CellGroupData[{

Cell["For a GWP in momentum space, the density is given by", "Text",
 CellChangeTimes->{{3.998680364743472*^9, 3.998680375887224*^9}, {
  3.998681083282137*^9, 3.998681113239718*^9}},
 CellID->203425187,ExpressionUUID->"380e2c5d-1a7b-4b15-81e5-450b059609ef"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Rho]", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{"2", "\[Pi]", " ", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], 
        RowBox[{"2", 
         SuperscriptBox["\[HBar]", "2"], 
         SuperscriptBox[
          RowBox[{"\[LeftBracketingBar]", 
           SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], 
          "2"]}]]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"p", "-", 
         SubscriptBox["p", "t"]}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.9986661676166887`*^9, 3.9986661907322206`*^9}, {3.9986784847802057`*^9, 
   3.9986785164344997`*^9}, {3.9986801453569107`*^9, 3.998680200875682*^9}, {
   3.998681090257115*^9, 3.99868109475519*^9}, {3.998682377492093*^9, 
   3.998682458328106*^9}, 3.9987279864518833`*^9},
 FontSize->16,
 CellID->173151885,ExpressionUUID->"4c45c25b-e440-4e0f-bea9-c748d5a980e2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["and the phase is ", "Text",
 CellChangeTimes->{{3.9986803857922897`*^9, 3.9986804164896297`*^9}, {
  3.99868109756188*^9, 3.9986811207739573`*^9}},
 CellID->323389510,ExpressionUUID->"9a8f4fe6-78b9-4e2c-89f7-9356c6adda72"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["S", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Gamma]", "t"], ")"}], "+", 
    RowBox[{
     FractionBox[
      RowBox[{"Im", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{"4", "\[HBar]", 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"p", "-", 
        SubscriptBox["p", "t"]}], ")"}], "2"]}], "-", 
    RowBox[{
     SubscriptBox["x", "t"], " ", "p"}], "-", 
    RowBox[{
     FractionBox["\[HBar]", "2"], 
     RowBox[{"arctan", "(", 
      FractionBox[
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.9986661676166887`*^9, 3.9986661907322206`*^9}, {3.9986784847802057`*^9, 
   3.9986785164344997`*^9}, {3.9986801453569107`*^9, 3.998680261617053*^9}, {
   3.998681122924879*^9, 3.998681126993248*^9}, {3.998682467226346*^9, 
   3.9986825646704903`*^9}, 3.998727988796577*^9},
 FontSize->16,
 CellID->2073867660,ExpressionUUID->"a72aab9a-55dd-4233-8136-a14c1fe1439d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
This enables a mathematically symmetric suite of momentum-space hydrodynamic \
fields. Most notably, the gradient of the momentum-space phase yields the \
phase-space position field, while the kinematic flow of momentum itself is \
described by the force flow velocity:\
\>", "Text",
 CellChangeTimes->{{3.9986655398090982`*^9, 3.9986655703141108`*^9}, {
  3.998666335363493*^9, 3.998666338401452*^9}, {3.998681141510109*^9, 
  3.998681144088524*^9}},
 CellID->40551364,ExpressionUUID->"e8c9544c-68cd-41f2-aeec-eec2f454b331"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["x", "p"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       OverscriptBox["S", "~"]}], 
      RowBox[{"\[PartialD]", "p"}]]}], "=", 
    RowBox[{
     SubscriptBox["x", "t"], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"2", "\[HBar]", 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]], 
      RowBox[{"(", 
       RowBox[{"p", "-", 
        SubscriptBox["p", "t"]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
   3.998682594210277*^9, 3.998682649755145*^9}, 3.9987280084072123`*^9},
 FontSize->16,
 CellID->753347037,ExpressionUUID->"3cb6948c-541c-4d0f-94b4-a5331bb8aabd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The kinematic flow of momentum itself is described by the force flow field, \
which for a quadratic potential, represents the classical external force \
evaluated across the conjugate position-space field:\
\>", "Text",
 CellChangeTimes->{{3.998682715172926*^9, 3.9986827192149878`*^9}, {
  3.998695212589036*^9, 3.998695229491343*^9}, {3.99869531617907*^9, 
  3.998695319909157*^9}},
 CellID->1730647702,ExpressionUUID->"eda7bb46-979c-41f6-b756-9b0a1bc283ce"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["v", "p"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["F", "ext"], "(", 
     SubscriptBox["x", "p"], ")"}], "=", 
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["V", "1"]}], "-", 
     RowBox[{"2", 
      RowBox[{
       SubscriptBox["V", "2"], "(", 
       RowBox[{
        SubscriptBox["x", "t"], "-", 
        RowBox[{
         FractionBox[
          RowBox[{"Im", "(", 
           SubscriptBox["\[Alpha]", "t"], ")"}], 
          RowBox[{"2", "\[HBar]", 
           SuperscriptBox[
            RowBox[{"\[LeftBracketingBar]", 
             SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], 
            "2"]}]], 
         RowBox[{"(", 
          RowBox[{"p", "-", 
           SubscriptBox["p", "t"]}], ")"}]}]}], ")"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
   3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
   3.998682806049759*^9}, 3.998695545675761*^9, 3.99872801322138*^9},
 FontSize->16,
 CellID->541154621,ExpressionUUID->"1c74dded-d80d-41bd-9811-1129604e6051"]
}, Open  ]],

Cell["\<\
These dual fields provide deep insights into the internal transport \
mechanisms of the wavepacket in the conjugate momentum-space domain.\
\>", "Text",
 CellChangeTimes->{{3.998695253569704*^9, 3.99869525667521*^9}},
 CellID->1592909388,ExpressionUUID->"2f17acc4-3a20-4aeb-87e7-c08a5c9bed94"],

Cell[CellGroupData[{

Cell[TextData[{
 "The osmotic flow in momentum space describes the quantum diffusion of the \
momentum distribution. It is derived symmetrically from the amplitude \
gradient, but scaled by the external potential curvature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "V_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "69390e8a-10f1-47e4-8b83-5132fb15f8de"],
 " rather than mass:"
}], "Text",
 CellChangeTimes->{{3.9986952799294147`*^9, 3.998695283773733*^9}},
 CellID->1105724224,ExpressionUUID->"3e493fe6-4ca1-4008-8968-d7a4a1b1c62c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["u", "p"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[HBar]", " ", 
     SubscriptBox["V", "2"], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[PartialD]", " ", "ln"}], 
       RowBox[{
        OverscriptBox["\[Rho]", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "p"}]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Re", 
        RowBox[{"(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], 
        SubscriptBox["V", "2"]}], 
       RowBox[{"\[HBar]", 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]]}], 
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "t"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685479232555*^9, 3.998685584192178*^9}, {
  3.998728019944931*^9, 3.9987280292162333`*^9}},
 FontSize->16,
 CellID->1731035277,ExpressionUUID->"1ec0ea30-eca4-4349-8be3-7f0d1313a9d7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The internal non-classical behavior of the momentum fluid is governed by the \
momentum-space quantum potential, representing the curvature of the momentum \
amplitude:\
\>", "Text",
 CellID->891724437,ExpressionUUID->"3f1ae9a6-b1e1-4dff-88bb-fa60c2b54166"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      SubscriptBox["V", "2"]}], 
     SuperscriptBox["\[HBar]", "2"], 
     FractionBox["1", 
      RowBox[{
       OverscriptBox["R", "~"], "(", 
       RowBox[{"p", ",", "t"}], ")"}]], 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[PartialD]", "2"], 
       RowBox[{
        OverscriptBox["R", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["p", "2"]}]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SubscriptBox["V", "2"], 
        SuperscriptBox["\[HBar]", "2"]}], "2"]}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{
          OverscriptBox["\[Rho]", "~"], "(", 
          RowBox[{"p", ",", "t"}], ")"}]], 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[PartialD]", "2"], 
          RowBox[{
           OverscriptBox["\[Rho]", "~"], "(", 
           RowBox[{"p", ",", "t"}], ")"}]}], 
         RowBox[{"\[PartialD]", 
          SuperscriptBox["p", "2"]}]]}], "-", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", 
          SuperscriptBox[
           RowBox[{
            OverscriptBox["\[Rho]", "~"], "(", 
            RowBox[{"p", ",", "t"}], ")"}], "2"]}]], 
        SuperscriptBox[
         RowBox[{"(", 
          FractionBox[
           RowBox[{"\[PartialD]", 
            RowBox[{
             OverscriptBox["\[Rho]", "~"], "(", 
             RowBox[{"p", ",", "t"}], ")"}]}], 
           RowBox[{"\[PartialD]", "p"}]], ")"}], "2"]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685619053261*^9, 3.998685753277947*^9}, {
  3.998687571742365*^9, 3.9986876428438663`*^9}, {3.9987280339652157`*^9, 
  3.9987281402034616`*^9}},
 FontSize->16,
 CellID->2071723893,ExpressionUUID->"0c2908a2-5ec3-44ff-932b-d0a3d39ce7b0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["Q", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      SubscriptBox["V", "2"]}], 
     RowBox[{"4", 
      SuperscriptBox["\[HBar]", "2"], 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "4"]}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}], "-", 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"p", "-", 
          SubscriptBox["p", "t"]}], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685619053261*^9, 3.998685753277947*^9}, {
  3.998687571742365*^9, 3.9986876428438663`*^9}, {3.9987280339652157`*^9, 
  3.998728054047208*^9}},
 FontSize->16,
 CellID->1976207216,ExpressionUUID->"dec00baa-ffd3-4cac-b7b5-62135ad76fa8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The gradient of the quantum potential with respect to momentum yields the \
internal momentum-space quantum force, which acts to broaden or squeeze the \
momentum distribution over time:\
\>", "Text",
 CellID->1034400299,ExpressionUUID->"246305a3-37f6-494f-b298-e4e59e37bb2f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["F", "~"], "Q"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      RowBox[{"\[PartialD]", 
       RowBox[{
        OverscriptBox["Q", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", "p"}]]}], "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox[
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], "2"], 
       SubscriptBox["V", "2"]}], 
      RowBox[{"2", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "4"]}]], 
     RowBox[{"(", 
      RowBox[{"p", "-", 
       SubscriptBox["p", "t"]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685619053261*^9, 3.998685753277947*^9}, {
  3.998687571742365*^9, 3.9986878678716183`*^9}, {3.998687975636404*^9, 
  3.998688014144*^9}, {3.99874380073831*^9, 3.9987438340020638`*^9}},
 FontSize->16,
 CellID->1285702828,ExpressionUUID->"54644d10-fc28-44dd-beeb-5fa9594f2349"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Finally, the momentum-space quantum stress density provides the internal \
dispersive pressure of the conjugate fluid, defined such that its gradient \
perfectly balances the probability-weighted momentum quantum force:\
\>", "Text",
 CellID->1964050707,ExpressionUUID->"a09fa44b-02de-4dfe-993e-9fe0dc83a329"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[PartialD]", 
     RowBox[{
      SubscriptBox[
       OverscriptBox["\[Sigma]", "~"], "Q"], "(", 
      RowBox[{"p", ",", "t"}], ")"}]}], 
    RowBox[{"\[PartialD]", "p"}]], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Rho]", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}], 
    RowBox[{
     SubscriptBox[
      OverscriptBox["F", "~"], "Q"], "(", 
     RowBox[{"p", ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685619053261*^9, 3.998685753277947*^9}, {
  3.998687571742365*^9, 3.9986878678716183`*^9}, {3.998687975636404*^9, 
  3.998688014144*^9}, {3.998688058462801*^9, 3.998688123419187*^9}, {
  3.998743841050911*^9, 3.9987438512399807`*^9}},
 FontSize->16,
 CellID->829094512,ExpressionUUID->"91887fb0-b970-4f30-8161-8a1084090187"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The general analytical definition in terms of the momentum probability fluid \
is:\
\>", "Text",
 CellChangeTimes->{3.998688145672031*^9},
 CellID->1261610735,ExpressionUUID->"43f39fb6-29c0-4139-b165-c8474d6bcb93"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[Sigma]", "~"], "Q"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox[
      RowBox[{
       SubscriptBox["V", "2"], 
       SuperscriptBox["\[HBar]", "2"]}], "2"], 
     RowBox[{
      OverscriptBox["\[Rho]", "~"], "(", 
      RowBox[{"p", ",", "t"}], ")"}], 
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["\[PartialD]", "2"], "ln"}], " ", 
       RowBox[{
        OverscriptBox["\[Rho]", "~"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], 
      RowBox[{"\[PartialD]", 
       SuperscriptBox["p", "2"]}]]}], "=", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"Re", 
        RowBox[{"(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], 
        SubscriptBox["V", "2"]}], 
       RowBox[{"2", 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]]}], 
     RowBox[{
      OverscriptBox["\[Rho]", "~"], "(", 
      RowBox[{"p", ",", "t"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.99867593770782*^9, 3.998675938402237*^9}, {
  3.998682594210277*^9, 3.998682649755145*^9}, {3.998682738425803*^9, 
  3.998682806049759*^9}, {3.998685619053261*^9, 3.998685753277947*^9}, {
  3.998687571742365*^9, 3.9986878678716183`*^9}, {3.998687975636404*^9, 
  3.998688014144*^9}, {3.998688058462801*^9, 3.998688123419187*^9}, {
  3.998690500818919*^9, 3.998690600139639*^9}, {3.9987438544825277`*^9, 
  3.9987438805823174`*^9}, {3.998743939122673*^9, 3.9987439436043253`*^9}, {
  3.998744013116247*^9, 3.998744032798066*^9}},
 FontSize->16,
 CellID->1942157760,ExpressionUUID->"9b462e37-0d8a-4aa0-a82c-d76cf978160f"]
}, Open  ]],

Cell["\<\
Because the momentum-space probability density of the GWP is perfectly \
Gaussian, the second derivative of its logarithm is a constant. This allows \
the momentum quantum stress to evaluate exactly algebraically as shown in the \
second equality above.\
\>", "Text",
 CellChangeTimes->{{3.998690624327424*^9, 3.9986906424733553`*^9}, 
   3.9986907134104633`*^9},
 CellID->1553413069,ExpressionUUID->"c04bb83d-8be2-43aa-b2ed-9a2653b8ecc3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Bohmian Trajectories and C-Space Mapping", "Subsection",
 CellChangeTimes->{{3.998665902602613*^9, 3.998665911682516*^9}},
 CellID->1121306041,ExpressionUUID->"38387287-d9bf-4dbc-8371-5d190ce7c6fe"],

Cell["\<\
Bohmian mechanics defines deterministic particle trajectories that flow along \
the streamlines of the probability current. In one dimension, these \
continuous fluid streamlines never cross. This non-crossing property, \
combined with global probability conservation, means that the total amount of \
probability density located \"to the left\" of a given trajectory remains \
perfectly constant over time.\
\>", "Text",
 CellChangeTimes->{{3.9986659431630573`*^9, 3.998665965042788*^9}, 
   3.9986965500277033`*^9, {3.998696867974761*^9, 3.9986968984017363`*^9}, 
   3.998697961600342*^9},
 CellID->1112774115,ExpressionUUID->"72903d99-ee99-48a8-b16e-47d7a4d1b9dd"],

Cell[TextData[{
 "We can formalize this using the cumulative distribution function (CDF), \
which measures the accumulated probability from ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"-", "\[Infinity]"}], TraditionalForm], "errors" -> {}, 
     "input" -> "-\\infty", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d6cf89a5-240f-48a9-8311-532d8aa9f9ad"],
 " up to a spatial position ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d101a5a-0428-4919-9a29-b905ca9f18f8"],
 ". If a trajectory is initially located at a position where the CDF equals a \
specific quantile ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[Element]", 
         RowBox[{"[", 
           RowBox[{"0", ",", "1"}], "]"}]}], TraditionalForm], "errors" -> {},
      "input" -> "c \\in [0,1]", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "879deb19-7ead-481e-bf66-fc2b60ebd893"],
 " (e.g., ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["c", "TI"], "\[LongEqual]", "1", "/", "10"}], 
       TraditionalForm], "errors" -> {}, "input" -> "c = 1/10", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ff1ebb07-b02e-4043-accc-74b38dd87d68"],
 ", meaning 10% of the probability fluid is to its left), it will ride the \
fluid flow such that it remains at that exact quantile forever."
}], "Text",
 CellChangeTimes->{{3.998723006997085*^9, 3.9987230473248987`*^9}},
 CellID->1665272227,ExpressionUUID->"7216a88e-a4e8-4d3b-8a82-29f6b9eb9c14"],

Cell[TextData[{
 "By mapping the physical coordinate domain to this bounded cumulative \
probability space (C-Space), the continuum of individual trajectories forms a \
continuous trajectory field, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "(", 
         RowBox[{
           StyleBox["c", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "x(c,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a9cc5f8d-c0c4-453b-9558-832253d0a150"],
 ". Because the quantile ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1890b98c-d81d-4799-b11e-02bd8bd24827"],
 " is a constant of motion, we can generate this entire field analytically \
simply by inverting the CDF."
}], "Text",
 CellChangeTimes->{
  3.998696704526883*^9, 3.9986980179457903`*^9, {3.998723076670697*^9, 
   3.998723123482239*^9}, {3.998744089002898*^9, 3.998744089670713*^9}},
 CellID->2106952729,ExpressionUUID->"2eab2050-9ea5-423f-a92d-c89b432eae4f"],

Cell[CellGroupData[{

Cell[TextData[{
 "For a 1D generalized Gaussian wavepacket, the CDF involves the standard \
error function. The exact analytical expression for the Bohmian trajectory ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["c", "TI"]], "(", 
         StyleBox["t", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "x_c(t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ae35a637-ed25-4fdf-8e0c-242967648ed8"],
 " is therefore evaluated algebraically using the inverse error function:"
}], "Text",
 CellChangeTimes->{{3.9986659883612328`*^9, 3.9986659974469633`*^9}},
 CellID->1696660920,ExpressionUUID->"2beaa63d-63a7-4143-85a1-93c79214af6a"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"x", "(", 
    RowBox[{"c", ",", "t"}], ")"}], "=", 
   RowBox[{
    SubscriptBox["x", "t"], "+", 
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]}]]], 
     RowBox[{
      SuperscriptBox["erf", 
       RowBox[{"-", "1"}]], "(", 
      RowBox[{
       RowBox[{"2", "c"}], "-", "1"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.99874409399717*^9, 3.998744095767733*^9}},
 FontSize->16,
 CellID->1494808591,ExpressionUUID->"570bc375-21a3-4ed5-b85a-3d25679a92f4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "This exact C-Space mapping is identically applied to the momentum-space \
density to evaluate continuous momentum trajectories. The analytical \
expression for the momentum trajectory mapped to quantile ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b3e0bc2c-c860-4f44-8f54-8e434affb182"],
 " is given by:"
}], "Text",
 CellChangeTimes->{{3.998696966516386*^9, 3.998697003862565*^9}, {
  3.998723166444284*^9, 3.9987231754965467`*^9}},
 CellID->884644776,ExpressionUUID->"57fd60b5-5b71-4a6a-aed2-d28f661f029b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"p", "(", 
    RowBox[{"c", ",", "t"}], ")"}], "=", 
   RowBox[{
    SubscriptBox["p", "t"], "+", 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{"2", 
        SuperscriptBox["\[HBar]", "2"], 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}], 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]]], 
     RowBox[{
      SuperscriptBox["erf", 
       RowBox[{"-", "1"}]], "(", 
      RowBox[{
       RowBox[{"2", "c"}], "-", "1"}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.9986724355317802`*^9, 3.998672514630517*^9}, {
  3.99869898319104*^9, 3.998699011927919*^9}, {3.998744098564713*^9, 
  3.9987440997266083`*^9}},
 FontSize->16,
 CellID->1195462051,ExpressionUUID->"771a077e-4838-4c57-a088-45bf02fd30c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "To evaluate external forces, potentials, and local hydrodynamic fields \
directly along these trajectories, the GWPHydrodynamics package must rapidly \
calculate arbitrary higher-order derivatives of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "(", 
         RowBox[{
           StyleBox["c", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "x(c,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e9cd7aae-8078-4f40-984a-e0c72b5695e9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], "(", 
         RowBox[{
           StyleBox["c", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "p(c,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "857121ea-a092-44cf-bbc3-f1e82856cca6"],
 " with respect to ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["c", "TI"], TraditionalForm], "errors" -> {}, "input" -> "c", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3e6e0341-9167-4f7a-ba0e-4656cf82862b"],
 ". Because the mapping utilizes the highly non-linear inverse error function \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["w", "TI"], "\[LongEqual]", 
         SuperscriptBox["erf", "-1"], 
         RowBox[{"(", 
           RowBox[{"2", 
             StyleBox["c", "TI"], "-", "1"}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "w = \\text{erf}^{-1}(2c - 1)", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "560546bc-ab71-42ef-9c9d-9558f1823f7e"],
 ", evaluating analytical derivatives requires repeated, computationally \
heavy chain-rule expansions involving:"
}], "Text",
 CellChangeTimes->{{3.9986660770587597`*^9, 3.998666105598034*^9}, 
   3.998672553802466*^9, {3.998697033891423*^9, 3.998697078798337*^9}, {
   3.998697144433762*^9, 3.998697144948897*^9}, {3.998697784857078*^9, 
   3.9986977893327827`*^9}, 3.998698650220133*^9, {3.998723199628764*^9, 
   3.998723244429104*^9}, {3.998744123924492*^9, 3.9987441723700037`*^9}},
 CellID->1863703016,ExpressionUUID->"dcc5fded-e829-4f93-a1b2-156679b9751d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{"\[DifferentialD]", "w"}], 
    RowBox[{"\[DifferentialD]", "c"}]], "=", 
   RowBox[{
    FractionBox[
     SqrtBox["\[Pi]"], "2"], 
    SuperscriptBox["\[ExponentialE]", 
     SuperscriptBox["w", "2"]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.9986724355317802`*^9, 3.998672514630517*^9}, {
  3.9986971010464687`*^9, 3.998697137779346*^9}, {3.998723275259656*^9, 
  3.9987232797429943`*^9}},
 FontSize->16,
 CellID->222296506,ExpressionUUID->"977d1e20-9a1a-47ee-b4b9-0f73db5fb608"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "To bypass generic symbolic calculus entirely, the underlying code relies on \
the GWP1DInverseGaussianEngine. Starting from  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], "1"], 
         RowBox[{"(", 
           StyleBox["w", "TI"], ")"}], "\[LongEqual]", "1"}], 
       TraditionalForm], "errors" -> {}, "input" -> "P_1(w) = 1", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "448cfd22-d649-4b90-be5a-3e7b7545d13a"],
 " the framework dynamically generates an exact polynomial ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["n", "TI"]], "(", 
         StyleBox["w", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_n(w)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "68d7e5c2-04f8-4528-a88c-6678a236e76b"],
 " for any required derivative order ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["n", "TI"], TraditionalForm], "errors" -> {}, "input" -> "n", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "fd58a544-9029-4e23-b482-025d32ff6cc1"],
 " by implementing a specialized algebraic recurrence relation:"
}], "Text",
 CellChangeTimes->{{3.99869718874231*^9, 3.998697204609997*^9}, 
   3.998698664577059*^9, 3.998698814616045*^9, {3.998723291894065*^9, 
   3.9987233006680727`*^9}, {3.9987234029265203`*^9, 3.998723450509419*^9}},
 CellID->1018933888,ExpressionUUID->"38ee5734-b8b9-43af-b2b4-34d5ebb41bbb"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", 
     RowBox[{"n", "+", "1"}]], "(", "w", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["P", "n", "\[Prime]"], "(", "w", ")"}], "+", 
    RowBox[{"2", "n", " ", "w", " ", 
     RowBox[{
      SubscriptBox["P", "n"], "(", "w", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.9986725791240873`*^9, 3.9986726185991707`*^9}, {
  3.998698839882203*^9, 3.998698880206637*^9}, {3.998723304573382*^9, 
  3.998723309513289*^9}, {3.9987236947522907`*^9, 3.998723694855373*^9}},
 FontSize->16,
 CellID->1801066547,ExpressionUUID->"fced8624-10ae-4a6f-af7d-848b0779d2d5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Consequently, any arbitrary trajectory field derivatives can be explicitly \
evaluated as:\
\>", "Text",
 CellChangeTimes->{
  3.998698909684618*^9, {3.998723470610417*^9, 3.998723484842206*^9}},
 CellID->1583046051,ExpressionUUID->"b80b3085-e54f-44c8-bde5-dfdfbe022938"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "n"], 
     RowBox[{"x", "(", 
      RowBox[{"c", ",", "t"}], ")"}]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["c", "n"]}]], "=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[DifferentialD]", "w"}], 
       RowBox[{"\[DifferentialD]", "c"}]], ")"}], "n"], 
    RowBox[{
     SubscriptBox["P", "n"], "(", "w", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.9986725791240873`*^9, 3.9986726185991707`*^9}, {
  3.9986989182821712`*^9, 3.998698933027364*^9}, {3.9987233423622837`*^9, 
  3.998723342526778*^9}, {3.998723533320373*^9, 3.998723535302662*^9}, {
  3.998723672019434*^9, 3.998723672316235*^9}, {3.998744105674697*^9, 
  3.9987441078921003`*^9}},
 FontSize->16,
 CellID->1187254438,ExpressionUUID->"e547be3d-316f-442e-8e13-1552db9c56d6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "n"], 
     RowBox[{"p", "(", 
      RowBox[{"c", ",", "t"}], ")"}]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["c", "n"]}]], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}], 
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[DifferentialD]", "w"}], 
       RowBox[{"\[DifferentialD]", "c"}]], ")"}], "n"], 
    RowBox[{
     SubscriptBox["P", "n"], "(", "w", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.9986658735991583`*^9, 3.99866588002631*^9}, {3.998666009517202*^9, 
  3.998666036858342*^9}, {3.9986725791240873`*^9, 3.9986726185991707`*^9}, {
  3.9986989182821712`*^9, 3.998698933027364*^9}, {3.998698963163213*^9, 
  3.998699004649103*^9}, {3.998723345261937*^9, 3.99872334541966*^9}, {
  3.998723538499359*^9, 3.998723539606634*^9}, {3.9987236737927113`*^9, 
  3.998723674079211*^9}, {3.99874411071629*^9, 3.998744114296097*^9}},
 FontSize->16,
 CellID->1824703582,ExpressionUUID->"55a3723d-287d-482c-b9be-cd0e94d69418"]
}, Open  ]],

Cell[TextData[{
 "By generating ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["P", "TI"], 
          StyleBox["n", "TI"]], "(", 
         StyleBox["w", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "P_n(w)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ca9e8d14-6430-4c89-932b-e43974660d96"],
 " algebraically, the system instantly evaluates multi-order trajectory \
fields with zero calculus overhead."
}], "Text",
 CellChangeTimes->{{3.998697221592146*^9, 3.9986972256232977`*^9}, 
   3.998699037996776*^9, {3.998723354235574*^9, 3.998723364355047*^9}},
 CellID->1813156002,ExpressionUUID->"5a660baa-6d96-4e7f-802d-07eff9807c4c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Energy Partitioning & Fisher Information", "Subsection",
 CellChangeTimes->{{3.9986650727294693`*^9, 3.9986650849912977`*^9}, {
  3.9986654701580687`*^9, 3.998665477685912*^9}, {3.998665615639824*^9, 
  3.9986656263051987`*^9}},
 CellID->1496940614,ExpressionUUID->"c2af8581-7788-4e9c-8011-a8219da753ac"],

Cell["\<\
The hydrodynamic representation allows global energy expectation values to be \
partitioned into independent classical (convective) and quantum (internal) \
components. The GWPHydrodynamics package explicitly calculates both the \
localized energy density fields at any given phase-space coordinate, as well \
as their global expectation values across the wavepacket.\
\>", "Text",
 CellChangeTimes->{3.998726148544735*^9},
 CellID->1993857569,ExpressionUUID->"7738ed89-3c20-434e-89ae-f1324d8a6196"],

Cell[CellGroupData[{

Cell["\<\
The local kinetic energy of the probability fluid can be partitioned at any \
point in space into convective and internal densities:\
\>", "Text",
 CellID->1839167808,ExpressionUUID->"29e74673-da2b-4fde-ae2f-f74b0d2b9738"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalT]", "conv"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], "m", " ", 
      SuperscriptBox[
       RowBox[{"v", "(", 
        RowBox[{"x", ",", "t"}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665771162572*^9}, {
  3.998675943733135*^9, 3.9986759601268806`*^9}, {3.9987261731242657`*^9, 
  3.998726188029554*^9}, {3.998727388936296*^9, 3.998727404635729*^9}},
 FontSize->16,
 CellID->13734138,ExpressionUUID->"5066ddf9-3433-4a13-8c7d-bce42bdba5d4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalT]", "int"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      FractionBox["1", "2"], "m", " ", 
      SuperscriptBox[
       RowBox[{"u", "(", 
        RowBox[{"x", ",", "t"}], ")"}], "2"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998675949098538*^9, 3.9986759638959084`*^9}, {3.9987261809136667`*^9, 
  3.99872619171521*^9}, {3.998727377356289*^9, 3.998727408565299*^9}},
 FontSize->16,
 CellID->1048907137,ExpressionUUID->"7d63fffa-7254-431c-9960-8faa72c021b4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Integrating these local densities over all space yields the exact partition \
of the global kinetic energy expectation value:\
\>", "Text",
 CellID->339288296,ExpressionUUID->"cbbe5469-2ec3-4909-b3a1-7cacfdb3cbd9"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "T", "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubscriptBox["T", "conv"], "+", 
    SubscriptBox["T", "int"]}]}], TraditionalForm]], "DisplayFormulaNumbered",\

 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665771162572*^9}, {
  3.998675943733135*^9, 3.9986759601268806`*^9}, {3.998726246605525*^9, 
  3.99872625952004*^9}},
 FontSize->16,
 CellID->849308087,ExpressionUUID->"9ded5ca7-105e-4592-ab03-66d0795be5aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["where", "Text",
 CellChangeTimes->{{3.998726266932447*^9, 3.9987262673399553`*^9}},
 CellID->738524548,ExpressionUUID->"1090710d-3358-4b83-a5e4-dd351323aed4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["T", "conv"], "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalT]", "conv"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.998665743909482*^9, 3.998665771162572*^9}, {
   3.998675943733135*^9, 3.9986759601268806`*^9}, 3.998726281769102*^9, {
   3.9987273599008923`*^9, 3.9987273697171183`*^9}},
 FontSize->16,
 CellID->1137009771,ExpressionUUID->"1ad0af17-0ed0-4996-ac84-5040b1800f10"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["T", "int"], "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalT]", "int"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
   3.998675949098538*^9, 3.9986759638959084`*^9}, 3.998726287233794*^9, {
   3.998727365116696*^9, 3.9987273734463787`*^9}},
 FontSize->16,
 CellID->1684260753,ExpressionUUID->"4d7abcac-f3a0-4c51-8372-6e096a7fe72f"]
}, Open  ]],

Cell[TextData[{
 "Symmetrically, for systems where the external potential is at most \
quadratic (preserving a constant curvature ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["V", "TI"], "2"], TraditionalForm], "errors" -> {}, "input" -> 
     "V_2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "94cfe855-fb5d-4cce-9f4f-5ef7ca4662b4"],
 "), the momentum-space Madelung transformation allows the local potential \
energy in the conjugate domain to be identically partitioned."
}], "Text",
 CellChangeTimes->{{3.998744213167996*^9, 3.998744216752038*^9}},
 CellID->1987789971,ExpressionUUID->"c7a1beca-0c97-4da1-9599-bc6d09d1c80c"],

Cell[CellGroupData[{

Cell[TextData[{
 "The convective potential energy density evaluates the macroscopic classical \
potential strictly along the conjugate position field ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["p", "TI"]], "(", 
         RowBox[{
           StyleBox["p", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "x_p(p,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "bfa2d369-317a-4d3c-a7bf-54742bcfff50"],
 ":"
}], "Text",
 CellChangeTimes->{{3.998744236619274*^9, 3.998744266814302*^9}},
 CellID->382946218,ExpressionUUID->"a5d5378c-52ef-4773-bc5c-f6bbf8f92e00"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalV]", "conv"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Rho]", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["V", "0"], "+", 
      RowBox[{
       SubscriptBox["V", "1"], 
       RowBox[{
        SubscriptBox["x", "p"], "(", 
        RowBox[{"p", ",", "t"}], ")"}]}], "+", 
      RowBox[{
       SubscriptBox["V", "2"], 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["x", "p"], "(", 
         RowBox[{"p", ",", "t"}], ")"}], "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
  3.998666642911071*^9}, {3.998673020738063*^9, 3.998673116725312*^9}, {
  3.998726340368219*^9, 3.998726396828677*^9}, {3.998727294100108*^9, 
  3.998727352752697*^9}},
 FontSize->16,
 CellID->168595867,ExpressionUUID->"e844293c-5de6-4b1e-8163-952d19989faa"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "In contrast, the internal potential energy density arises strictly from the \
momentum-space quantum potential ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["Q", "TI"], "~"], "(", 
         RowBox[{
           StyleBox["p", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\tilde{Q}(p,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "aec76fd2-d5ca-4ee3-b15d-43ad38a31961"],
 ", representing the purely quantum-mechanical energy cost of the wavepacket \
interacting with the local potential curvature:"
}], "Text",
 CellChangeTimes->{
  3.9987264234154367`*^9, {3.998744302978586*^9, 3.998744316606799*^9}},
 CellID->592453428,ExpressionUUID->"0fe1b759-d0fc-4315-b6fe-4c0c26daa9a6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalV]", "int"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Rho]", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}], " ", 
    RowBox[{
     OverscriptBox["Q", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
  3.998666642911071*^9}, {3.998673020738063*^9, 3.998673116725312*^9}, {
  3.998726340368219*^9, 3.998726396828677*^9}, {3.998726438022496*^9, 
  3.9987264509398823`*^9}, {3.99872727907656*^9, 3.998727289780621*^9}},
 FontSize->16,
 CellID->750528183,ExpressionUUID->"73973a43-8ffa-4cf7-bdb6-ef2964f309c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Integrating these momentum-space densities partitions the global potential \
energy expectation value into its convective and internal components:\
\>", "Text",
 CellID->2022725002,ExpressionUUID->"1e2af569-951a-490f-965d-b66569d6a3b0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "V", "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "conv"], "(", "t", ")"}], "+", 
    RowBox[{
     SubscriptBox["V", "int"], "(", "t", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
  3.998666642911071*^9}, {3.998666694206572*^9, 3.998666705087644*^9}, {
  3.998727271740533*^9, 3.9987272755929327`*^9}},
 FontSize->16,
 CellID->1272976604,ExpressionUUID->"0dc39a6c-c7be-428d-9f4a-98f67ac6102a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["where", "Text",
 CellChangeTimes->{{3.998726485053443*^9, 3.9987264854333057`*^9}},
 CellID->1821408074,ExpressionUUID->"8e5c65eb-c307-449d-9018-72931ce50294"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "conv"], "(", "t", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SubscriptBox["\[ScriptCapitalV]", "conv"], "(", 
      RowBox[{"p", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "p"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
  3.998666642911071*^9}, {3.998673020738063*^9, 3.998673116725312*^9}, {
  3.998726501825905*^9, 3.998726525767836*^9}, {3.998727244614682*^9, 
  3.998727245235327*^9}, {3.998744588918103*^9, 3.9987445899887323`*^9}},
 FontSize->16,
 CellID->1834926365,ExpressionUUID->"3ff9e9e9-ef85-4d8f-bbc7-649d9cf85f01"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "int"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[ScriptCapitalV]", "int"], "(", 
       RowBox[{"p", ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "p"}]}]}], "=", 
    FractionBox[
     RowBox[{
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      SubscriptBox["V", "2"]}], 
     RowBox[{"4", 
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]]}]}],
   TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
   3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
   3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
   3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
   3.998666642911071*^9}, {3.998673020738063*^9, 3.998673116725312*^9}, 
   3.998726543681158*^9, {3.998727247145617*^9, 3.998727248394953*^9}, {
   3.9987445924805613`*^9, 3.998744593581161*^9}},
 FontSize->16,
 CellID->1686203911,ExpressionUUID->"4dd93a2e-0727-4d0e-89d6-8ea760aa60c3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Combining these partitions yields a complete hydrodynamic accounting of the \
total conserved energy of the wavepacket:\
\>", "Text",
 CellChangeTimes->{3.998726563412882*^9},
 CellID->895698666,ExpressionUUID->"2246a21c-9525-4291-ab20-d4e2dcee9721"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", "E", "\[RightAngleBracket]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", "T", "\[RightAngleBracket]"}], "+", 
     RowBox[{"\[LeftAngleBracket]", "V", "\[RightAngleBracket]"}]}], "=", 
    RowBox[{
     RowBox[{
      SubscriptBox["T", "conv"], "(", "t", ")"}], "+", 
     RowBox[{
      SubscriptBox["T", "int"], "(", "t", ")"}], "+", 
     RowBox[{
      SubscriptBox["V", "conv"], "(", "t", ")"}], "+", 
     RowBox[{
      SubscriptBox["V", "int"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.998666616244369*^9, 
  3.998666642911071*^9}, {3.998666694206572*^9, 3.998666705087644*^9}, {
  3.998726570719919*^9, 3.998726622692254*^9}, {3.998727252886092*^9, 
  3.998727260116125*^9}},
 FontSize->16,
 CellID->241788305,ExpressionUUID->"7c2078b9-30d0-46e5-a1f9-44c0d9a5e09d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Finally, the framework quantifies the structural sharpness of the wavepacket \
in both domains using spatial and momentum Fisher information densities:\
\>", "Text",
 CellID->615210022,ExpressionUUID->"072f7e9a-d665-4d3e-b38e-bcc578a7c09b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["\[ScriptCapitalI]", "F"], "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Rho]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"\[PartialD]", "ln"}], " ", 
        RowBox[{"\[Rho]", "(", 
         RowBox[{"x", ",", "t"}], ")"}]}], 
       RowBox[{"\[PartialD]", "x"}]], ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.9986759845978403`*^9, 
  3.998675991133871*^9}, {3.998726859065537*^9, 3.998726883554656*^9}, {
  3.998727209419063*^9, 3.998727230092909*^9}},
 FontSize->16,
 CellID->1848563096,ExpressionUUID->"b92b959f-6c3d-4b86-8651-81e8832173bd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["\[ScriptCapitalI]", "~"], "F"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Rho]", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"\[PartialD]", "ln"}], " ", 
        RowBox[{
         OverscriptBox["\[Rho]", "~"], "(", 
         RowBox[{"p", ",", "t"}], ")"}]}], 
       RowBox[{"\[PartialD]", "p"}]], ")"}], "2"]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.9986759845978403`*^9, 
  3.998675991133871*^9}, {3.998726859065537*^9, 3.998726910440819*^9}, {
  3.998727206412972*^9, 3.9987272234464817`*^9}},
 FontSize->16,
 CellID->526322968,ExpressionUUID->"df9801ca-de21-45aa-8bea-46c6c35aa7c7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The internal kinetic energy is directly proportional to the spatial Fisher \
information ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["I", "TI"], 
        StyleBox["F", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "I_F", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4cb6a2a9-5e9d-453a-b7a8-4236ef0651d7"],
 ", a fundamental measure of the wavepacket's localization and structural \
sharpness:"
}], "Text",
 CellChangeTimes->{{3.998665812162785*^9, 3.998665815980957*^9}},
 CellID->1496158760,ExpressionUUID->"f325a54b-db4e-4b05-84e8-9518820d5e76"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["I", "F"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{
       SubscriptBox["\[ScriptCapitalI]", "F"], "(", 
       RowBox[{"x", ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{"2", "m"}], 
       SuperscriptBox["\[HBar]", "2"]], ")"}], "4", 
     RowBox[{
      SubscriptBox["T", "int"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
  3.998665593168294*^9}, {3.998665743909482*^9, 3.998665792515609*^9}, {
  3.998665828195759*^9, 3.998665857104254*^9}, {3.9986759845978403`*^9, 
  3.998675991133871*^9}, {3.998727007158163*^9, 3.998727034660325*^9}, {
  3.998727096889266*^9, 3.998727114514244*^9}, {3.998727187581884*^9, 
  3.998727203180784*^9}, {4.0004126174993467`*^9, 4.0004126218481293`*^9}},
 FontSize->16,
 CellID->549263110,ExpressionUUID->"12ea73bc-fb30-404b-b9cf-a25294a82287"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox[
     OverscriptBox["I", "~"], "F"], "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{
       SubscriptBox[
        OverscriptBox["I", "~"], "F"], "(", 
       RowBox[{"p", ",", "t"}], ")"}], 
      RowBox[{"\[DifferentialD]", "p"}]}]}], "=", 
    RowBox[{
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{
        SubscriptBox["V", "2"], 
        SuperscriptBox["\[HBar]", "2"]}]], ")"}], "4", 
     RowBox[{
      SubscriptBox["V", "int"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.99866513748503*^9, 3.998665161490872*^9}, {
  3.998665239722897*^9, 3.99866525968049*^9}, {3.99866558309538*^9, 
