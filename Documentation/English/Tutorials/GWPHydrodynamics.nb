Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DXC", "[", "c", "]"}], " ", "@", " ", "GWP1DVAL"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DXC", "[", "1", "]"}], "[", "c", "]"}], " ", "@", " ", 
  "GWP1DVAL"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DXC", "[", "2", "]"}], "[", "c", "]"}], " ", "@", " ", 
