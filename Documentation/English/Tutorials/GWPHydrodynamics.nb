Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    SuperscriptBox[
     RowBox[{"InverseErf", "[", 
      RowBox[{
       RowBox[{"-", "1"}], "+", 
       RowBox[{"2", " ", "c"}]}], "]"}], "2"]], " ", 
   SqrtBox[
    FractionBox["\[Pi]", "2"]]}], 
