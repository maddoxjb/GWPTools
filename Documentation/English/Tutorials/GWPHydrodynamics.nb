Cell[CellGroupData[{

Cell["Bohmian Trajectories", "Subsection",
 CellID->801534319,ExpressionUUID->"9f9ce615-84fb-419d-9cea-d7e599ae4b35"],

Cell["\<\
The BohmianTrajectories class maps physical coordinates to the cumulative \
probability (C-Space) domain enabling the exact analytical evaluation of \
Bohmian coordinate trajectories without numerical differential equation \
solving. \
\>", "Text",
 CellChangeTimes->{{3.99866051316324*^9, 3.998660528562943*^9}},
 CellID->222381802,ExpressionUUID->"6f88fc7e-886e-4fff-9254-217e838e7d63"],

