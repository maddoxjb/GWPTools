Cell[CellGroupData[{

Cell["\<\
Evaluate the convective (classical) kinetic energy for a dynamic harmonic \
oscillator.\
\>", "MathCaption",
 CellID->283964090,ExpressionUUID->"9d4929ba-e8bb-425d-bcf9-d463b9ed82fd"],

Cell[CellGroupData[{

