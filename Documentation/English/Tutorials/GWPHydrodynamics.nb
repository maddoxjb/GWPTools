Cell[BoxData[
 RowBox[{
  RowBox[{"GWP1DXC", "[", "c", "]"}], "[", 
  RowBox[{
  "RA", ",", "IA", ",", "RX", ",", "RP", ",", "RG", ",", "IG", ",", "NORM", ",",
    "HBAR", ",", "MASS", ",", 
   RowBox[{"{", 
    RowBox[{"V0", ",", "V1", ",", "V2"}], "}"}], ",", "INIT"}], 
  "]"}]], "Output",
