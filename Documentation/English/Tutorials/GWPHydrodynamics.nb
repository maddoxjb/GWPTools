Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"2", " ", 
     SuperscriptBox[
      RowBox[{"InverseErf", "[", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", " ", "c"}]}], "]"}], "2"]}]], " ", "\[Pi]", " ", 
   RowBox[{"InverseErf", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"2", " ", "c"}]}], "]"}]}], 
