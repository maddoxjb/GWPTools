Cell[CellGroupData[{

Cell["Phase-Space Hydrodynamic Fields", "Subsection",
 CellChangeTimes->{{3.998660347977768*^9, 3.998660354825799*^9}},
 CellID->667195234,ExpressionUUID->"28f2ece0-e9ae-4369-a1a9-c7e316d4347b"],

Cell["\<\
The HydrodynamicsX class provides access to real-valued spatial fields \
derived from the Madelung transformation, including probability current, flow \
velocity, osmotic velocity, and the quantum potential/force. The \
HydrodynamicsP class acts as its momentum-space dual.\
\>", "Text",
 CellChangeTimes->{3.998660366981393*^9},
 CellID->1538176851,ExpressionUUID->"6291be38-dc10-484f-837d-6f784205636d"],

Cell[CellGroupData[{

