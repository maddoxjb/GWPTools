     RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<HO\>\""}], "]"}], 
    "[", "\"\<ECKE\>\"", "]"}], "[", "t", "]"}], "//", "Simplify"}]], "Input",\

 CellChangeTimes->{{3.998660321188506*^9, 3.9986603225873013`*^9}},
