Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<HO\>\""}], "]"}], 
    "[", "\"\<XC\>\"", "]"}], "[", 
   RowBox[{"c", ",", " ", "t"}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.998660596707337*^9, 3.998660598174539*^9}},
