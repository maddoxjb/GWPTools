Cell[CellGroupData[{

Cell["\<\
Evaluate the dynamic spatial probability current density for a free particle.\
\
\>", "MathCaption",
 CellID->1199626973,ExpressionUUID->"027becea-e303-4a2c-9ffe-43a607b21ca1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<Free\>\""}], "]"}], 
    "[", "\"\<JX\>\"", "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.99842540778646*^9, 3.998425409871276*^9}},
 CellLabel->"In[11]:=",
 CellID->1554057175,ExpressionUUID->"482bbba9-765d-46f3-bd73-44e18df3a2ef"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox["x", "2"]}], 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}]]}]], " ", 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], " ", "t", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox["1", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}]], ")"}], 
   RowBox[{"3", "/", "2"}]], " ", "x"}]], "Output",
 CellChangeTimes->{4.000412940128756*^9},
 CellLabel->"Out[11]=",
 CellID->1153194731,ExpressionUUID->"034bf974-ff61-4d2f-a99b-5e9ba8fda7ae"]
}, Open  ]]
}, Open  ]],

