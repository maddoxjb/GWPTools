}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Limit", "[", 
   RowBox[{"%", ",", " ", 
    RowBox[{"\[Sigma]", " ", "->", " ", "\[CapitalDelta]x"}]}], "]"}], " ", "//",
   " ", "Simplify"}]], "Input",
 CellLabel->"In[24]:=",
