Cell[CellGroupData[{

Cell["\<\
Evaluate the dynamic 1D Wigner function for a forced harmonic oscillator with \
resonant sinusoidal driving using non-default parameters.\
\>", "MathCaption",
 CellID->1109296008,ExpressionUUID->"1c917a99-078d-417d-9e45-348a3b292a42"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"GWP1DWIG", "[", 
   RowBox[{"x", ",", " ", "p"}], "]"}], " ", "@", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"GWP1DFHORES", "[", 
     RowBox[{"1", ",", " ", 
      RowBox[{"1", "/", "10"}]}], "]"}], "[", "t", "]"}], " ", "@", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", " ", 
     RowBox[{"-", "1"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[20]:=",
 CellID->1632466849,ExpressionUUID->"b3bed01a-7047-4e56-979d-87d7b3a7bfbb"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "+", 
         RowBox[{
          FractionBox["1", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "2"}], "-", 
                 FractionBox["t", "10"]}], ")"}], " ", 
               RowBox[{"Cos", "[", "t", "]"}]}], ")"}]}], "-", 
            FractionBox[
             RowBox[{"Sin", "[", "t", "]"}], "10"]}], ")"}]}]}], ")"}], "2"], 
      
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "t", "]"}], "2"]}]]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"p", "-", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", 
           FractionBox["t", "10"]}], ")"}], " ", 
         RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "t", "]"}], "2"]}], ")"}]}]}]], 
  "\[Pi]"]], "Output",
 CellChangeTimes->{3.9982375344327793`*^9, 3.998853030057047*^9},
 CellLabel->"Out[20]=",
 CellID->1577974485,ExpressionUUID->"6627577b-a166-44bd-92b1-a403bd86ca54"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the Wehrl entropy as a function of the coherent state's uncertainty \
for a GWP with zero position-momentum covariance and show what happens as it \
approaches the uncertainty of the packet itself.\
\>", "MathCaption",
 CellID->619257071,ExpressionUUID->"e9b5e18b-6c18-4950-a8e6-ec5cdf11d6ea"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DWEHRL", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}], " ", "@", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Covariance\>\"", ",", " ", "\[CapitalDelta]x", ",", " ", 
      "0"}], "}"}], "]"}]}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->"In[21]:=",
 CellID->1147838935,ExpressionUUID->"c4e7d10b-edf5-44af-9de3-18c0bd90a0db"],

Cell[BoxData[
 RowBox[{"1", "+", 
  RowBox[{"Log", "[", 
   FractionBox[
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[CapitalDelta]x", "2"], "+", 
       SuperscriptBox["\[Sigma]", "2"]}], ")"}], "2"], 
    RowBox[{"4", " ", 
     SuperscriptBox["\[CapitalDelta]x", "2"], " ", 
     SuperscriptBox["\[Sigma]", "2"]}]], "]"}]}]], "Output",
 CellChangeTimes->{3.9982375370929728`*^9, 3.9988530300866327`*^9},
 CellLabel->"Out[21]=",
 CellID->1741612592,ExpressionUUID->"9efabf98-921a-42c6-a77d-0f3c2378def7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{"%", ",", " ", 
   RowBox[{"\[Sigma]", " ", "->", " ", "\[CapitalDelta]x"}]}], "]"}]], "Input",\

 CellLabel->"In[22]:=",
 CellID->883379544,ExpressionUUID->"972bb5a9-1961-4341-8a8a-f5b652fcf3b4"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.99823753822821*^9, 3.998853030112859*^9},
 CellLabel->"Out[22]=",
 CellID->1080725134,ExpressionUUID->"17c0a52d-140d-4710-848b-2d9b23175525"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Repeat the example for a GWP with non-zero position-momentum covariance.\
\>", "MathCaption",
 CellID->1405544297,ExpressionUUID->"2f683825-ce0b-4306-b231-19f91905df6a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DWEHRL", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{"4", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}], ")"}]}], "]"}], " ", "@", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"{", 
     RowBox[{"\"\<Covariance\>\"", ",", " ", "\[CapitalDelta]x", ",", " ", 
      "Cxp"}], "}"}], "]"}]}], " ", "//", " ", "Simplify"}]], "Input",
 CellLabel->"In[23]:=",
 CellID->662882679,ExpressionUUID->"d995a543-c2ff-455d-b784-e8568a45419a"],

Cell[BoxData[
 RowBox[{"1", "+", 
  RowBox[{"Log", "[", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[CapitalDelta]x", "4"], "+", 
