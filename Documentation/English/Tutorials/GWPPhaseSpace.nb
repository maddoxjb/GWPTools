Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"x", "-", 
         RowBox[{"Cos", "[", "t", "]"}]}], ")"}], "2"], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "t", "]"}], "2"]}]]}], "-", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"p", "+", 
        RowBox[{"Sin", "[", "t", "]"}]}], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Cos", "[", "t", "]"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"Sin", "[", "t", "]"}], "2"]}], ")"}]}]}]], 
  "\[Pi]"]], "Output",
 CellChangeTimes->{3.99823686622775*^9, 3.998237399982029*^9, 
