Cell[CellGroupData[{

Cell["\<\
Wigner function for a 1D coherent state of the standard harmonic oscillator.\
\>", "MathCaption",
 CellID->1936651204,ExpressionUUID->"badef7bc-5e97-428c-ae1d-d670b367df92"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<HO\>\""}]}], "]"}], 
   "[", "\"\<WIG\>\"", "]"}], "[", 
  RowBox[{"x", ",", " ", "p", ",", " ", "t"}], "]"}]], "Input",
