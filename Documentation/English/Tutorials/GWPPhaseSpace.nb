Cell[CellGroupData[{

Cell["Mathematical Definitions", "Section",
 CellID->1512484949,ExpressionUUID->"fc101cfa-d551-45cd-9a55-cec65c8a0adb"],

Cell["\<\
The density matrix, Wigner function, and Husimi Q-distribution provide \
distinct, complementary representations of a quantum state in phase space. \
For a pure continuous-variable state, these distributions are derived \
directly from the spatial wavefunction.  The following subsections provide \
mathematical definitions used by GWPPhaseSpace to define its functions.\
\>", "Text",
 CellChangeTimes->{{3.99822232153168*^9, 3.998222380228047*^9}, {
  3.998222577072658*^9, 3.998222612956132*^9}, {3.998222783116836*^9, 
  3.998222811584302*^9}, {3.9982277952474613`*^9, 3.9982278490309753`*^9}, {
  3.9982287053305893`*^9, 3.998228705927919*^9}, {3.998234431149337*^9, 
  3.998234432330797*^9}},
 CellID->802475777,ExpressionUUID->"2d1faccf-b3c0-4db6-b9dd-3ea62b38f184"],

Cell[CellGroupData[{

Cell["1D", "Subsection",
 CellChangeTimes->{{3.998225627946245*^9, 3.998225628694566*^9}},
 CellID->1013080879,ExpressionUUID->"b40c3b24-a7a5-4fc1-9475-d35d136fb6fa"],

Cell[CellGroupData[{

Cell["\<\
The position-space density matrix for a pure 1D state is defined as\
\>", "Text",
 CellChangeTimes->{{3.998222814425192*^9, 3.9982228672222652`*^9}, {
  3.998223054061771*^9, 3.998223055989428*^9}, {3.9982253505726624`*^9, 
  3.998225363050127*^9}},
 CellID->1599979937,ExpressionUUID->"c9799f84-eb15-4051-94f1-d580d1590466"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "y", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{"\[Psi]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], 
    RowBox[{
     SuperscriptBox["\[Psi]", "*"], "(", 
     RowBox[{"y", ",", "t"}], ")"}]}]}], TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998131071123982*^9, 3.998131082495512*^9}, {3.998222219123498*^9, 
  3.998222219621603*^9}},
 FontSize->16,
 CellID->72573425,ExpressionUUID->"bc83cd52-ae0c-4519-b893-9dd5c8b1a80f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["which for a generalized 1D GWP it has the form", "Text",
 CellChangeTimes->{{3.99822306079812*^9, 3.998223092933551*^9}, 
   3.9982235155512342`*^9, {3.9982254031957407`*^9, 3.998225466264299*^9}, {
   3.998228723556304*^9, 3.9982287252100563`*^9}},
 CellID->2118326126,ExpressionUUID->"05ed033f-033f-4e66-9cfd-a809d801faca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", 
    RowBox[{"(", 
     RowBox[{"x", ",", "y", ",", "t"}], ")"}]}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"2", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["\[Alpha]", "t"], "(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}], "-", 
      SuperscriptBox[
       RowBox[{
        SubsuperscriptBox["\[Alpha]", "t", "*"], "(", 
        RowBox[{"y", "-", 
         SubscriptBox["x", "t"]}], ")"}], "2"], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["p", "t"], "(", 
        RowBox[{"x", "-", "y"}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, 
   3.9982232351493893`*^9, {3.998223533791552*^9, 3.998223570541952*^9}},
 FontSize->16,
 CellID->1723299716,ExpressionUUID->"f9a1eca5-dd88-4191-9d86-8d0ffe6891bd"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],ExpressionUUID->
  "21fc3de8-f35a-47a8-a09e-66a09442b042"],
 " is the complex-valued shape parameter, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "bf104271-3bec-4a7d-849c-874a5b934a07"],
 " is the position center, and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],ExpressionUUID->
  "f4dda709-15c9-40f2-9884-9a5ecdc39a50"],
 " is the momentum center of the 1D GWP.  The global phase parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
  "088fcf52-6e63-436b-9a87-657313c937d1"],
 " cancels out."
}], "Text",
 CellChangeTimes->{{3.998225475805332*^9, 3.9982255247557993`*^9}, {
  3.998234470109626*^9, 3.998234506141135*^9}},
 CellID->386379723,ExpressionUUID->"a61d5e2c-a941-4680-aa89-94fa7d399474"],

Cell[CellGroupData[{

Cell["The momentum-space density matrix is defined similarly", "Text",
 CellChangeTimes->{{3.998225385952777*^9, 3.998225396691925*^9}, {
  3.99822874217785*^9, 3.998228745152645*^9}},
 CellID->2040939580,ExpressionUUID->"94fb4dab-d1b3-44b4-94b0-5293d3306eac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Rho]", "~"], "(", 
    RowBox[{"p", ",", 
     SuperscriptBox["p", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     OverscriptBox["\[Psi]", "~"], "(", 
     RowBox[{"p", ",", "t"}], ")"}], 
    RowBox[{
     SuperscriptBox[
      OverscriptBox["\[Psi]", "~"], "*"], "(", 
     RowBox[{
      SuperscriptBox["p", "\[Prime]"], ",", "t"}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998131071123982*^9, 3.998131082495512*^9}, {3.998222219123498*^9, 
  3.998222219621603*^9}, {3.998222390758871*^9, 3.998222403410681*^9}, {
  3.9982228804528913`*^9, 3.998222925724607*^9}},
 FontSize->16,
 CellID->315227529,ExpressionUUID->"c6cf1b8b-94c0-4856-b2f2-fd00d143a0ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["and has the following form for 1D GWP", "Text",
 CellChangeTimes->{{3.998225555835558*^9, 3.998225566176895*^9}, {
  3.9982287518412027`*^9, 3.9982287662962008`*^9}},
 CellID->186922754,ExpressionUUID->"9bc8ab89-960b-41c6-82f9-4d5661b0c423"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Rho]", "~"], "(", 
    RowBox[{"p", ",", 
     SuperscriptBox["p", "\[Prime]"], ",", "t"}], ")"}], "=", 
   RowBox[{
    SqrtBox[
     FractionBox[
      RowBox[{"Re", "(", 
       SubscriptBox["\[Alpha]", "t"], ")"}], 
      RowBox[{"2", "\[Pi]", " ", 
       SuperscriptBox["\[HBar]", "2"], 
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "2"]}]]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["1", 
         RowBox[{"4", 
          SuperscriptBox["\[HBar]", "2"], " ", 
          SubscriptBox["\[Alpha]", "t"]}]]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"p", "-", 
          SubscriptBox["p", "t"]}], ")"}], "2"]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"4", 
         SuperscriptBox["\[HBar]", "2"], " ", 
         SubsuperscriptBox["\[Alpha]", "t", "*"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["p", "\[Prime]"], "-", 
          SubscriptBox["p", "t"]}], ")"}], "2"]}], "-", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], 
       RowBox[{
        SubscriptBox["x", "t"], "(", 
        RowBox[{"p", "-", 
         SuperscriptBox["p", "\[Prime]"]}], ")"}]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998223240637331*^9, 3.998223415762762*^9}, {3.998223572958939*^9, 
  3.9982235756360197`*^9}, {3.9982255336422577`*^9, 3.99822554117208*^9}},
 FontSize->16,
 CellID->1989634564,ExpressionUUID->"76856cb9-b367-4339-9eee-de1486ae7024"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The purity of the density matrix", "Text",
 CellChangeTimes->{{3.9982338591404943`*^9, 3.998233900356876*^9}, {
   3.998233931934026*^9, 3.9982339863773623`*^9}, 3.998234035980091*^9, {
   3.99823463822678*^9, 3.998234668372879*^9}},
 CellID->1320249711,ExpressionUUID->"36d3e2f4-d5fd-47d5-8361-e02fd98a83b3"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"P", "(", "t", ")"}], "=", 
   RowBox[{
    RowBox[{"Tr", "(", 
     SuperscriptBox[
      OverscriptBox["\[Rho]", "^"], "2"], ")"}], "=", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       SuperscriptBox[
        RowBox[{"\[LeftBracketingBar]", 
         RowBox[{"\[Rho]", "(", 
          RowBox[{"x", ",", "y", ",", "t"}], ")"}], "\[RightBracketingBar]"}],
         "2"], 
       RowBox[{"\[DifferentialD]", "x"}], 
       RowBox[{"\[DifferentialD]", "y"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998131071123982*^9, 3.99813130962996*^9}, {3.998131702058853*^9, 
  3.998131767229809*^9}, {3.998131996000864*^9, 3.998132005236846*^9}, {
  3.998232688498809*^9, 3.998232688658558*^9}, {3.9982339627172337`*^9, 
  3.998233978021433*^9}},
 FontSize->16,
 CellID->1635851973,ExpressionUUID->"c4b4f0c6-8161-4bab-8915-501534748517"]
}, Open  ]],

Cell[CellGroupData[{

Cell["and the von Neumann entropy", "Text",
 CellChangeTimes->{{3.998234039829198*^9, 3.998234047590785*^9}, {
  3.998234537100281*^9, 3.998234537545156*^9}},
 CellID->1678461317,ExpressionUUID->"4cd1f629-ae88-4239-9395-e8922c79d366"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "vN"], "(", "t", ")"}], "=", 
   RowBox[{"-", 
    RowBox[{"Tr", "(", 
     RowBox[{
      OverscriptBox["\[Rho]", "^"], " ", "ln", " ", 
      OverscriptBox["\[Rho]", "^"]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
   3.998131071123982*^9, 3.998131329175075*^9}, {3.998131975582714*^9, 
   3.998131992129344*^9}, {3.998132135837463*^9, 3.99813217591006*^9}, {
   3.998232690624845*^9, 3.998232691148642*^9}, 3.998234057375228*^9},
 FontSize->16,
 CellID->554167827,ExpressionUUID->"a521e91c-4d57-48cb-9763-fd5289e2901a"]
}, Open  ]],

Cell["\<\
are trivially 1 and 0, respectively, for any pure state, including a 1D GWP.\
\>", "Text",
 CellChangeTimes->{{3.998233943243555*^9, 3.9982339512965317`*^9}, {
  3.9982340616528683`*^9, 3.998234062376045*^9}, {3.9982346864299583`*^9, 
  3.9982347010979147`*^9}},
 CellID->262091350,ExpressionUUID->"9f4f6c55-4905-4f19-8c36-e518ef7f78c0"],

Cell[CellGroupData[{

Cell["\<\
The Wigner quasi-probability distribution function for a 1D pure state is \
formally defined by\
\>", "Text",
 CellChangeTimes->{{3.998222955989472*^9, 3.998222965958034*^9}, {
  3.998223021814662*^9, 3.9982230383387423`*^9}, {3.9982287980539017`*^9, 
  3.9982287991642942`*^9}},
 CellID->480359453,ExpressionUUID->"35ce2176-91ca-4341-a489-46e054802a49"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"W", "(", 
    RowBox[{"x", ",", "p", ",", "t"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Pi]", " ", "\[HBar]"}]], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{"\[Rho]", "(", 
       RowBox[{
        RowBox[{"x", "-", "y"}], ",", 
        RowBox[{"x", "+", "y"}], ",", "t"}], ")"}], 
      RowBox[{"exp", "(", 
       RowBox[{
        FractionBox[
         RowBox[{"2", "\[ImaginaryI]"}], "\[HBar]"], "p", " ", "y"}], ")"}], 
      RowBox[{"\[DifferentialD]", "y"}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998131071123982*^9, 3.998131195326498*^9}, {3.998223561306938*^9, 
  3.998223565330819*^9}, {3.998242632010099*^9, 3.998242633855513*^9}},
 FontSize->16,
 CellID->1010297498,ExpressionUUID->"89407ae5-f7e2-469b-aa04-2bb0fe48803b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["and for the 1D GWP we have", "Text",
 CellChangeTimes->{{3.998225722170331*^9, 3.9982257304367733`*^9}},
 CellID->2064335704,ExpressionUUID->"434bce7a-8988-40d3-95b2-b78a2c013149"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"W", "(", 
    RowBox[{"x", ",", "p", ",", "t"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Pi]", " ", "\[HBar]"}]], 
    RowBox[{"exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox["2", 
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}]]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", 
         SuperscriptBox["\[HBar]", "2"], 
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"p", "-", 
          SubscriptBox["p", "t"]}], ")"}], "2"]}], "-", 
      RowBox[{
       FractionBox["2", "\[HBar]"], 
       FractionBox[
        RowBox[{"Im", "(", 
         SubscriptBox["\[Sigma]", "t"], ")"}], 
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}]], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"p", "-", 
         SubscriptBox["p", "t"]}], ")"}]}]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998073607464367*^9, 3.9980737306440277`*^9}},
 FontSize->16,
 CellID->544376196,ExpressionUUID->"67a38749-17b8-4355-8ea2-bd3c1a5c848c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The Husimi Q-distribution is the convolution of the \
system\[CloseCurlyQuote]s Wigner function with a reference Wigner function \
for a coherent state GWP with shape parameter ",
 Cell[BoxData[
  FormBox["s", TraditionalForm]],ExpressionUUID->
  "c0b7668d-b72e-4877-8ed8-cd7d660d9761"]
}], "Text",
 CellChangeTimes->{{3.998229490325574*^9, 3.998229541413261*^9}, {
  3.998230227921377*^9, 3.998230290471406*^9}, {3.998230990094541*^9, 
  3.998230993639028*^9}, {3.9982324698392267`*^9, 3.998232487741681*^9}, {
  3.998234734617742*^9, 3.998234738456092*^9}},
 CellID->1050389952,ExpressionUUID->"7b22e110-682e-4bfb-abac-0335b3eabfd1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"x", ",", "p", ",", 
     RowBox[{"t", ";", "s"}]}], ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      RowBox[{"W", "(", 
       RowBox[{
        SuperscriptBox["x", "\[Prime]"], ",", 
        SuperscriptBox["p", "\[Prime]"], ",", "t"}], ")"}], 
      RowBox[{
       SubscriptBox["W", "ref"], "(", 
       RowBox[{
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ",", 
        RowBox[{"p", "-", 
         SuperscriptBox["p", "\[Prime]"]}]}], ")"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["x", "\[Prime]"]}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["p", "\[Prime]"]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
   3.998131071123982*^9, 3.998131250439789*^9}, {3.998131551202243*^9, 
   3.998131645698913*^9}, 3.9982222329248543`*^9, {3.998225748625824*^9, 
   3.99822574892668*^9}, {3.998230306556625*^9, 3.9982303126972437`*^9}, {
   3.998230344446857*^9, 3.998230427543689*^9}, {3.998232407323249*^9, 
   3.998232422896937*^9}, {3.998232503402174*^9, 3.998232524106387*^9}, 
   3.9982325599212713`*^9},
 FontSize->16,
 CellID->1588344924,ExpressionUUID->"9f9cf768-b7c0-459a-8213-3d9f008b8c0e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["where", "Text",
 CellChangeTimes->{{3.998232564748664*^9, 3.998232565159328*^9}},
 CellID->2091405458,ExpressionUUID->"85901da2-f58f-4cc5-ae2e-88725c85d291"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["W", "ref"], "(", 
    RowBox[{"x", ",", "p"}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Pi]", " ", "\[HBar]"}]], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "2"}], "s", " ", 
       SuperscriptBox["x", "2"]}], "-", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", "s", " ", 
         SuperscriptBox["\[HBar]", "2"]}]], 
       SuperscriptBox["p", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
   3.998131071123982*^9, 3.998131250439789*^9}, {3.998131551202243*^9, 
   3.998131645698913*^9}, 3.9982222329248543`*^9, {3.998225748625824*^9, 
   3.99822574892668*^9}, {3.998230306556625*^9, 3.9982303126972437`*^9}, {
   3.998230344446857*^9, 3.998230427543689*^9}, {3.998232407323249*^9, 
   3.998232422896937*^9}, {3.998232571049748*^9, 3.99823262567461*^9}},
 FontSize->16,
 CellID->239198510,ExpressionUUID->"cc4c6fdc-35ea-4a2d-a874-f5224b0846f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["For a 1D GWP, the Husimi Q-function is given by", "Text",
 CellChangeTimes->{{3.9982326374607763`*^9, 3.998232666498788*^9}},
 CellID->119970386,ExpressionUUID->"db7962a0-8ae8-4cf2-a94e-f41415eccac0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Q", "(", 
    RowBox[{"x", ",", "p", ",", 
     RowBox[{"t", ";", " ", "s"}]}], ")"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Pi]", " ", "\[HBar]"}]], 
    SqrtBox[
     RowBox[{" ", 
      FractionBox[
       RowBox[{
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], "s"}], 
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         SubscriptBox["\[Alpha]", "t"], "+", "s"}], 
        "\[RightBracketingBar]"}]]}]], 
    RowBox[{"exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"2", 
          RowBox[{"s", "(", 
           RowBox[{
            RowBox[{"\[LeftBracketingBar]", 
             SubscriptBox["\[Alpha]", "t"], "\[RightBracketingBar]"}], "+", 
            RowBox[{"s", " ", "Re", 
             RowBox[{"(", 
              SubscriptBox["\[Alpha]", "t"], ")"}]}]}], ")"}]}], 
         SuperscriptBox[
          RowBox[{"\[LeftBracketingBar]", 
           RowBox[{
            SubscriptBox["\[Alpha]", "t"], "+", "s"}], 
           "\[RightBracketingBar]"}], "2"]]}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}], "-", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}], "+", "s"}], 
        RowBox[{"2", 
         SuperscriptBox["\[HBar]", "2"], 
         SuperscriptBox[
          RowBox[{"\[LeftBracketingBar]", 
           RowBox[{
            SubscriptBox["\[Alpha]", "t"], "+", "s"}], 
           "\[RightBracketingBar]"}], "2"]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"p", "-", 
          SubscriptBox["p", "t"]}], ")"}], "2"]}], "+", 
      RowBox[{
       FractionBox["2", "\[HBar]"], 
       FractionBox[
        RowBox[{"s", " ", "Im", 
         RowBox[{"(", 
          SubscriptBox["\[Alpha]", "t"], ")"}]}], 
        SuperscriptBox[
         RowBox[{"\[LeftBracketingBar]", 
          RowBox[{
           SubscriptBox["\[Alpha]", "t"], "+", "s"}], 
          "\[RightBracketingBar]"}], "2"]], 
       RowBox[{"(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}], 
       RowBox[{"(", 
        RowBox[{"p", "-", 
         SubscriptBox["p", "t"]}], ")"}]}]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998073607464367*^9, 3.998073920485319*^9}, {3.99813220466905*^9, 
  3.99813227770875*^9}, {3.9982320110908737`*^9, 3.9982320526627417`*^9}, {
  3.9982320883313093`*^9, 3.998232215381299*^9}, {3.998232257807362*^9, 
  3.9982323164712353`*^9}},
 FontSize->16,
 CellID->2002616616,ExpressionUUID->"1be9e458-8910-42e7-9c0d-f48e79c29049"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The Wehrl entropy measures phase space localization and is given by \
\>", "Text",
 CellChangeTimes->{{3.998233221489709*^9, 3.998233230336501*^9}, {
  3.9982342846971273`*^9, 3.998234296906304*^9}},
 CellID->466265681,ExpressionUUID->"1791e7f8-0687-4c2b-9a56-8d49ddb4df78"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "Wehrl"], "(", 
    RowBox[{"t", ";", "s"}], ")"}], "=", 
   RowBox[{"-", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       RowBox[{"Q", "(", 
        RowBox[{"x", ",", "p", ",", 
         RowBox[{"t", ";", "s"}]}], ")"}], "ln", " ", 
       RowBox[{"Q", "(", 
        RowBox[{"x", ",", "p", ",", 
         RowBox[{"t", ";", "s"}]}], ")"}], 
       RowBox[{"\[DifferentialD]", "x"}], 
       RowBox[{"\[DifferentialD]", "p"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
   3.998131071123982*^9, 3.998131404971504*^9}, 3.998131506559403*^9, {
   3.99822224459339*^9, 3.9982222650518017`*^9}, {3.998234304822351*^9, 
   3.998234305116994*^9}, {3.998234343480987*^9, 3.998234344629352*^9}},
 FontSize->16,
 CellID->359472664,ExpressionUUID->"1f4fdb39-cadf-425e-a6a3-63c4f49f14d0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["which for a 1D GWP, has the form", "Text",
 CellChangeTimes->{{3.998234299485187*^9, 3.998234351050873*^9}, {
  3.998235730969429*^9, 3.99823573533493*^9}},
 CellID->785564837,ExpressionUUID->"5db06d71-3ae6-446e-ba27-c28f8f5c64a4"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["S", "Wehrl"], "(", 
    RowBox[{"t", ";", "s"}], ")"}], "=", 
   RowBox[{"1", "+", 
    RowBox[{"ln", "(", 
     FractionBox[
      SuperscriptBox[
       RowBox[{"\[LeftBracketingBar]", 
        RowBox[{
         SubscriptBox["\[Alpha]", "t"], "+", "s"}], "\[RightBracketingBar]"}],
        "2"], 
      RowBox[{"4", "s", " ", 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}]}]], ")"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9980734596742992`*^9, 3.998073543881957*^9}, {
  3.998073607464367*^9, 3.998073920485319*^9}, {3.998132210404374*^9, 
  3.9981322433686657`*^9}, {3.9981322837551117`*^9, 3.99813229742669*^9}, {
  3.998222271410706*^9, 3.998222274564951*^9}, {3.998233007329152*^9, 
  3.998233008058353*^9}, {3.998234309356189*^9, 3.9982343096004467`*^9}},
 FontSize->16,
 CellID->258753703,ExpressionUUID->"f4402873-a1eb-47bc-a6ec-8677085cdcf8"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

