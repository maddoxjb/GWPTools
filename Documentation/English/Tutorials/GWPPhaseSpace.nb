Cell[BoxData[
 RowBox[{
  RowBox[{"GWP1DDMP", "[", 
   RowBox[{"p1", ",", " ", "p2"}], "]"}], " ", "@", " ", 
  "GWP1DVAL"}]], "Input",
 CellLabel->"In[17]:=",
 CellID->1650073795,ExpressionUUID->"5c105bc3-07ca-4ea0-8ed2-1f4207369ca8"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"p1", "-", "RP"}], ")"}], "2"], 
       RowBox[{"4", " ", 
        SuperscriptBox["HBAR", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"\[ImaginaryI]", " ", "IA"}], "+", "RA"}], ")"}]}]]}], "-", 
     
     FractionBox[
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"p2", "-", "RP"}], ")"}], "2"], 
      RowBox[{"4", " ", 
       SuperscriptBox["HBAR", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "IA"}], "+", "RA"}], ")"}]}]], 
     "-", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{"p1", "-", "p2"}], ")"}], " ", "RX"}], "HBAR"]}]], " ", 
   SqrtBox[
    FractionBox["RA", 
     RowBox[{
      SuperscriptBox["HBAR", "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["IA", "2"], "+", 
        SuperscriptBox["RA", "2"]}], ")"}]}]]]}], 
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]]]], "Output",
 CellChangeTimes->{3.998237527461631*^9, 3.998853029999277*^9},
 CellLabel->"Out[17]=",
 CellID->1222853120,ExpressionUUID->"eca33486-d38a-41b4-8baf-df6e7fd949fb"]
}, Open  ]],

