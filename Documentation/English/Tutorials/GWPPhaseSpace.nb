             SuperscriptBox["t", "2"], "4"]}], ")"}]}]]}], ")"}], " ", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"4", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["t", "2"], "4"]}], ")"}]}]], "+", 
        FractionBox[
         RowBox[{"\[ImaginaryI]", " ", "t"}], 
         RowBox[{"8", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            FractionBox[
             SuperscriptBox["t", "2"], "4"]}], ")"}]}]]}], ")"}], " ", 
      SuperscriptBox["y", "2"]}]}]], " ", 
   SqrtBox[
    FractionBox["1", 
     RowBox[{"1", "+", 
      FractionBox[
       SuperscriptBox["t", "2"], "4"]}]]]}], 
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]]]], "Output",
 CellChangeTimes->{3.99823686427853*^9, 3.998237398362856*^9, 
  3.998237494909255*^9, 3.998853029552717*^9},
 CellLabel->"Out[7]=",
 CellID->1494921890,ExpressionUUID->"1aeefe52-5928-457d-8664-5cb1baee078d"]
}, Open  ]]
