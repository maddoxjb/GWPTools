Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
    "IA", "|", "IG", "|", "MASS", "|", "RA", "|", "RG", "|", "RP", "|", 
     "RX"}], ")"}], "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"RA", ">", "0"}], "&&", 
  RowBox[{"\<\"HBAR\"\>", ">", "0"}], "&&", 
  RowBox[{"MASS", ">", "0"}]}]], "Output",
 CellChangeTimes->{3.99842064101728*^9, 3.9986452905166893`*^9, 
