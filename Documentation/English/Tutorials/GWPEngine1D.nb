Cell[CellGroupData[{

Cell["Probabilities", "Subsection",
 CellID->1920216384,ExpressionUUID->"250ae2c3-01be-4635-a8b0-9d33a456fc51"],

Cell["\<\
The Probabilities class handles all statistical density distributions. It \
exposes exact analytical probability densities across phase space and energy, \
alongside cumulative distribution functions (CDFs) for rapid, \
integration-free interval probability calculations.\
\>", "Text",
 CellID->692518772,ExpressionUUID->"1cadb6a9-a146-412d-905d-899fa440b6d2"],

