   RowBox[{"GWP1DFREE", "[", "t", "]"}], "@", "GWP1DVAL"}]}]], "Input",
 CellChangeTimes->{
  3.998417500676723*^9, {3.9984175962847548`*^9, 3.998417604184163*^9}, {
   3.998417642564015*^9, 3.998417674605754*^9}},
 CellLabel->"In[161]:=",
 CellID->1241333781,ExpressionUUID->"74b2a03d-02dd-4897-bcd9-7f03a2118102"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"HBAR", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IA", " ", "MASS"}], "-", 
      RowBox[{"2", " ", "HBAR", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["IA", "2"], "+", 
         SuperscriptBox["RA", "2"]}], ")"}], " ", "t"}]}], ")"}]}], 
   RowBox[{"2", " ", "MASS", " ", "RA"}]]}]], "Output",
 CellChangeTimes->{3.9984206451898317`*^9, 3.9986459292986526`*^9, 
  3.998852956206895*^9},
 CellLabel->"Out[161]=",
 CellID->1439992286,ExpressionUUID->"672d93c1-fec9-468f-a24f-09b61b30946f"]
}, Open  ]]
}, Open  ]],

Cell["\<\
The instantaneous environmental fields (PEX and FEX) dictate the local \
potential energy and forces acting upon the wavepacket. Potential-coupled \
expectations (such as the expected force EF1) evaluate exactly against these \
local landscapes.\
\>", "Text",
 CellID->1365372268,ExpressionUUID->"73ac21c3-e366-42bf-8ebb-19ddb18374c7"],

