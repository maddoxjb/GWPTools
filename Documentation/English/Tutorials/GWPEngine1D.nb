Cell[CellGroupData[{

Cell["\<\
Evaluate the base spatial wavefunction, its exact first spatial derivative, \
and its dynamic evolution under a free particle potential.\
\>", "MathCaption",
 CellID->400141909,ExpressionUUID->"84596b5b-d540-4e8c-80e6-2ba4950502ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DPSIX", "[", "x", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIX", "[", "1", "]"}], "[", "x", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIX", "[", "x", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.99841625014723*^9, 3.9984162517272387`*^9}},
 CellLabel->"In[130]:=",
 CellID->1413765806,ExpressionUUID->"6c8950ee-7da1-462b-bb7f-097e8a9b1160"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "4"]}]], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"2", " ", "\[Pi]"}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954944854*^9, 4.000412322590055*^9},
 CellLabel->"Out[130]=",
 CellID->946510981,ExpressionUUID->"bf9ca2f0-996d-4970-8a47-fdcc54187e02"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "4"]}]], " ", "x"}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], 
     RowBox[{"1", "/", "4"}]]}]]}]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954944854*^9, 4.000412322591303*^9},
 CellLabel->"Out[131]=",
 CellID->1598684338,ExpressionUUID->"bb91112d-6938-4fbf-8cc6-584027c40fc4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["x", "2"], 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]], "-", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"4", "+", 
     SuperscriptBox["t", "2"]}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954944854*^9, 4.000412322592293*^9},
 CellLabel->"Out[132]=",
 CellID->1919761149,ExpressionUUID->"c9853231-7bde-4d15-9049-641e300980a7"]
}, Open  ]]
}, Open  ]],

