Cell[CellGroupData[{

Cell["Energies", "Subsection",
 CellID->1410291723,ExpressionUUID->"b6babf07-0b23-42af-abd3-f9584316824d"],

Cell["\<\
The Energies class centralizes the thermodynamic and Hamiltonian observables. \
It includes evaluators for kinetic, potential, and total energy moments, \
their respective uncertainties, and energy cross-correlations.\
\>", "Text",
 CellID->995976522,ExpressionUUID->"8041ea4c-22f3-4d29-8cf1-2e80164d4c47"],

