Cell[CellGroupData[{

Cell["\<\
Extract the processed initial parameters (INIT) for a default wavepacket, and \
compare them against a wavepacket constructed with custom symbolic inputs.\
\>", "MathCaption",
 CellChangeTimes->{{3.998412893599098*^9, 3.998412895352159*^9}},
 CellID->1501116440,ExpressionUUID->"68520570-3a87-4ff5-8024-341fa09bdda2"],

