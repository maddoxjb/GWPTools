  3.998852941122553*^9, 4.000412309098632*^9},
 CellLabel->"Out[17]=",
 CellID->1843739478,ExpressionUUID->"48f4e868-4e7e-461c-bf05-b5119b14a8b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"OMEGA", " ", "t"}], "]"}]}], "+", 
  FractionBox[
   RowBox[{"RP", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}], 
   RowBox[{"MASS", " ", "OMEGA"}]]}]], "Output",
 CellChangeTimes->{3.998420641151086*^9, 3.998645367568573*^9, 
  3.998852941122553*^9, 4.000412309099992*^9},
 CellLabel->"Out[18]=",
 CellID->1687864183,ExpressionUUID->"676403c4-60c7-4e29-8726-6e08a6156ac7"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"OMEGA", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "MASS", " ", "OMEGA", " ", "RX"}], "-", 
      RowBox[{"A", " ", "t"}]}], ")"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", "+", 
      RowBox[{"2", " ", "OMEGA", " ", "RP"}]}], ")"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}]}], 
  RowBox[{"2", " ", "MASS", " ", 
   SuperscriptBox["OMEGA", "2"]}]]], "Output",
 CellChangeTimes->{3.998420641151086*^9, 3.998645367568573*^9, 
  3.998852941122553*^9, 4.0004123091010647`*^9},
 CellLabel->"Out[19]=",
 CellID->1821830458,ExpressionUUID->"aef2db5c-178d-4403-89fd-6ac0461c4ba1"]
}, Open  ]]
}, Open  ]],

