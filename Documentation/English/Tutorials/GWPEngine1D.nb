   RowBox[{"(", 
    FractionBox["2", "\[Pi]"], ")"}], 
   RowBox[{"1", "/", "4"}]]}]], "Output",
 CellChangeTimes->{3.998420644324901*^9, 3.998645889090526*^9, 
  3.9988529551494007`*^9, 4.0004123227405367`*^9},
 CellLabel->"Out[135]=",
 CellID->1133124450,ExpressionUUID->"18983677-4a2c-48ea-b7b6-9eeabf8b236b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}], ")"}]}], "+", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  RowBox[{
   SqrtBox[
    RowBox[{"-", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}], ")"}], 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{3.998420644324901*^9, 3.998645889090526*^9, 
  3.9988529551494007`*^9, 4.0004123227415323`*^9},
 CellLabel->"Out[136]=",
 CellID->537649554,ExpressionUUID->"f76ce7e9-88c2-4536-a283-e57d5ae561f6"]
}, Open  ]]
}, Open  ]],

Cell["\<\
Probability densities represent the physical statistical distributions across \
phase space and energy. While spatial and momentum densities support \
arbitrary-order recursive derivatives, the energy density (RHOE) acts purely \
as a field evaluator.\
\>", "Text",
 CellID->1160149762,ExpressionUUID->"c1776380-bbb2-483a-9e4f-a15bec518352"],

