   RowBox[{"GWP1DRHOE", "[", "e", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", "//", " ", 
  "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DRHOE", "[", "e", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DHO", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellLabel->"In[141]:=",
 CellID->55253229,ExpressionUUID->"530e27b4-7c5c-40fb-8be3-f8fb776ac22b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox[
    FractionBox["1", "e"]], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "4"}], " ", "e"}]]}], 
  SqrtBox["\[Pi]"]]], "Output",
 CellChangeTimes->{3.998420644491588*^9, 3.998645899081624*^9, 
  3.998852955334757*^9, 4.0004123228955193`*^9},
