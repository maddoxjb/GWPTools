Cell[CellGroupData[{

Cell["\<\
Evaluate momentum-space wavefunctions, including exact momentum derivatives \
and time-evolved dynamic states.\
\>", "MathCaption",
 CellID->925053517,ExpressionUUID->"58a465ff-eb5b-4489-88d8-aafeb61d2143"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DPSIP", "[", "p", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIP", "[", "1", "]"}], "[", "p", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIP", "[", "p", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellLabel->"In[134]:=",
 CellID->1740339586,ExpressionUUID->"3b83148a-4f6f-44d1-8f81-10bca3cca187"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    SuperscriptBox["p", "2"]}]], " ", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox["2", "\[Pi]"], ")"}], 
   RowBox[{"1", "/", "4"}]]}]], "Output",
 CellChangeTimes->{3.998420644324901*^9, 3.998645889090526*^9, 
  3.9988529551494007`*^9},
