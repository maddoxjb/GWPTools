Cell[CellGroupData[{

Cell["\<\
Care must be taken to respect the physical domain of the observables. \
Evaluating the energy probability (PROBE) with a negative lower bound \
mathematically forces the engine to evaluate the square root of a negative \
energy, resulting in unphysical complex outputs (Erfi).\
\>", "MathCaption",
 CellID->138062477,ExpressionUUID->"464c3647-7d0d-47ba-83ae-04a1a55ee690"],

