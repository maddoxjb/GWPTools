Cell[CellGroupData[{

Cell["Wavefunctions", "Subsection",
 CellID->1044946124,ExpressionUUID->"fe335c48-59a3-40d4-977b-a2102ca7992b"],

Cell["\<\
The Wavefunctions class registers the core spatial and momentum probability \
amplitudes. It provides access to the primary complex wavefunctions, their \
real and imaginary components, conjugate forms, and arbitrary-order spatial \
or momentum derivatives.\
\>", "Text",
 CellID->288240902,ExpressionUUID->"819fa786-11a7-4950-b9f2-1903d1481ced"],

