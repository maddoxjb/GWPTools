 CellID->1542178450,ExpressionUUID->"6dfe8047-4cd8-40ce-a87e-b79103d123be"],

Cell[BoxData[
 FractionBox[
  RowBox[{"9", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "\[ImaginaryI]"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "t"}], "]"}]}]}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"16", "-", 
     RowBox[{"8", " ", "\[ImaginaryI]", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}], "+", 
