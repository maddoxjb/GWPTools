Cell[CellGroupData[{

Cell["Compute position-momentum product expectation values.", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.998417544149523*^9, 3.998417581741465*^9}},
 CellID->293226662,ExpressionUUID->"34df7f08-b970-4ee9-853b-70f226fb8c46"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GWP1DEXP", " ", "@", " ", "GWP1DVAL"}], "\[IndentingNewLine]", 
 RowBox[{"GWP1DEPX", " ", "@", " ", "GWP1DVAL"}]}], "Input",
 CellChangeTimes->{{3.998417506053554*^9, 3.998417508658801*^9}},
 CellLabel->"In[157]:=",
 CellID->1521216628,ExpressionUUID->"dd8c0c10-956a-4919-9cb6-411c8d646e50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"(", 
    RowBox[{"RP", "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "IA"}], "+", "RA"}], ")"}], " ", 
      "RX"}]}], ")"}]}], "+", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "IA"}], "+", "RA"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", "RA"}]], "+", 
     SuperscriptBox["RX", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.998420645138262*^9, 3.9986459251161613`*^9, 
  3.99885295614924*^9},
 CellLabel->"Out[157]=",
 CellID->2018777936,ExpressionUUID->"59b18395-9948-4c0d-973f-557720490783"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"(", 
    RowBox[{"RP", "+", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "IA"}], "+", "RA"}], ")"}], " ",
       "RX"}]}], ")"}]}], "-", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "IA"}], "+", "RA"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", "RA"}]], "+", 
     SuperscriptBox["RX", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.998420645138262*^9, 3.9986459251161613`*^9, 
  3.998852956152891*^9},
 CellLabel->"Out[158]=",
 CellID->1506631399,ExpressionUUID->"a1e5614d-dc46-4fc0-bd2d-b47803c915a4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute arbitrary order position-momentum product expectation values.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.99841762520308*^9, 3.998417636684766*^9}},
 CellID->1812559409,ExpressionUUID->"c117f0dd-b56e-4811-a69f-207cdf3bb041"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEXP", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], " ", "@", " ", "GWP1DVAL"}], " ", "//",
   " ", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEPX", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], " ", "@", " ", "GWP1DVAL"}], " ", "//",
   " ", "Simplify"}]}], "Input",
 CellLabel->"In[159]:=",
 CellID->960831599,ExpressionUUID->"e70703ce-41b8-42ec-9170-ce692fe21f02"],

Cell[BoxData[
 FractionBox[
  RowBox[{"RP", "-", 
   RowBox[{"4", " ", "HBAR", " ", "IA", " ", "RX"}], "+", 
   RowBox[{"4", " ", "\[ImaginaryI]", " ", "HBAR", " ", "RA", " ", "RX"}], "+", 
   RowBox[{"4", " ", "RA", " ", "RP", " ", 
    SuperscriptBox["RX", "2"]}]}], 
  RowBox[{"4", " ", "RA"}]]], "Output",
 CellChangeTimes->{3.998420645163013*^9, 3.998645926780261*^9, 
  3.998852956175375*^9},
 CellLabel->"Out[159]=",
 CellID->974241216,ExpressionUUID->"2ef0d25c-4fd0-4664-be59-05668e220ca8"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "HBAR"}], " ", 
    RowBox[{"(", 
     RowBox[{"IA", "+", 
      RowBox[{"\[ImaginaryI]", " ", "RA"}]}], ")"}], " ", "RP"}], "+", 
   RowBox[{
    SuperscriptBox["HBAR", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["IA", "2"], "+", 
      SuperscriptBox["RA", "2"]}], ")"}], " ", "RX"}], "+", 
   RowBox[{"RA", " ", 
    SuperscriptBox["RP", "2"], " ", "RX"}]}], "RA"]], "Output",
 CellChangeTimes->{3.998420645163013*^9, 3.998645926780261*^9, 
  3.998852956180498*^9},
 CellLabel->"Out[160]=",
 CellID->1656792584,ExpressionUUID->"1cdf799b-6d74-415f-9eb2-4d927d0cd18b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute the position-momentum covariance for a free particle.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.99841762520308*^9, 3.998417685455014*^9}},
 CellID->346664729,ExpressionUUID->"2681fc04-89de-4701-b44f-4ce7373b2662"],

