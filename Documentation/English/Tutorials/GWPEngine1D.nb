Cell[CellGroupData[{

Cell["\<\
GWP1DINPUT retrieves the exact symbolic arguments initially passed to the \
constructor, whereas GWP1DINIT extracts the final evaluated state.\
\>", "MathCaption",
 CellID->169779064,ExpressionUUID->"fc2487cb-eb71-46fe-8ca2-a43a2199baee"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GWP1DINPUT", "@", "GWP1DVAL"}], "\n", 
 RowBox[{"GWP1DINPUT", "@", 
  RowBox[{"GWP1DPARAM", "[", 
   RowBox[{
    RowBox[{"RA", " ", "+", " ", 
     RowBox[{"I", "*", "IA"}]}], ",", " ", 
    RowBox[{"RX", " ", "+", " ", 
     RowBox[{"I", "*", "IX"}]}], ",", " ", 
    RowBox[{"RP", " ", "+", " ", 
     RowBox[{"I", "*", "IP"}]}], ",", " ", 
    RowBox[{"RG", " ", "+", " ", 
     RowBox[{"I", "*", "IG"}]}]}], "]"}]}], "\n", 
 RowBox[{"GWP1DINIT", "@", "GWP1DVAL"}]}], "Input",
 CellLabel->"In[99]:=",
 CellID->1618445432,ExpressionUUID->"dbab79d4-2050-4a84-bcf6-8fe40fdf8fbf"],

Cell[BoxData["INIT"], "Output",
