Cell[CellGroupData[{

Cell["Dynamic Parameters", "Subsection",
 CellID->512085829,ExpressionUUID->"dd311052-0890-4597-b142-84391fc178c3"],

Cell["\<\
The DynamicParameters class tracks the real-time kinematics of the \
wavepacket. It exposes the time-dependent centers, spreading shapes, phases, \
their exact time derivatives, and the instantaneous coefficients of the local \
potential environment.\
\>", "Text",
 CellChangeTimes->{{3.998413031447012*^9, 3.998413031945826*^9}},
 CellID->1659554474,ExpressionUUID->"ad4366a8-198f-4758-943e-68dd28bb75e1"],

Cell[CellGroupData[{

Cell["\<\
Inspect the dynamic kinematic parameters, their time derivatives, and local \
potential coefficients.\
\>", "MathCaption",
