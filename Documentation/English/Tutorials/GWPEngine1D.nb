 CellID->1702729937,ExpressionUUID->"2634cfd9-d84f-40d6-9a97-123d0a7d6c48"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", 
   FractionBox["5", "8"], ",", 
   FractionBox["43", "64"], ",", 
   FractionBox["755", "512"], ",", 
   FractionBox["19993", "4096"], ",", "$Failed"}], "}"}]], "Output",
 CellChangeTimes->{3.9984206420971727`*^9, 3.998645544647421*^9, 
  3.998852942239964*^9, 4.0004123102917852`*^9},
 CellLabel->"Out[79]=",
 CellID->414971237,ExpressionUUID->"90a6e4b4-4046-46bc-8eeb-73b9c509cbf4"]
}, Open  ]]
