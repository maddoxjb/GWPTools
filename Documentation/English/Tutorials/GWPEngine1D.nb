Cell[BoxData[
 RowBox[{"2", " ", 
  SqrtBox[
   FractionBox["1", "e"]], " ", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"8", " ", "e"}], 
    RowBox[{
     RowBox[{"-", "5"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]], " ", 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], " ", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{"5", "-", 
     RowBox[{"3", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]]}]], "Output",
 CellChangeTimes->{3.998420644491588*^9, 3.998645899081624*^9, 
  3.998852955334757*^9, 4.000412322920705*^9},
 CellLabel->"Out[142]=",
 CellID->1875828412,ExpressionUUID->"32311621-f87e-41f6-86d9-c174a39f4d78"]
}, Open  ]]
}, Open  ]],

Cell["\<\
To avoid costly and inaccurate numerical integration, the engine implements \
exact analytical Cumulative Distribution Functions (CDFs) for space, \
momentum, and energy. These are utilized internally to evaluate bounded \
probabilities.\
\>", "Text",
 CellID->1471296059,ExpressionUUID->"b11988a6-2c92-4ace-b1ea-76a3be32ee26"],

