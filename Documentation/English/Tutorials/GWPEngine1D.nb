Cell[CellGroupData[{

Cell["\<\
Evaluate the potential for a generic parameter bus and a time-evolved \
non-resonant forced harmonic oscillator.\
\>", "MathCaption",
 CellChangeTimes->{{3.998417881348628*^9, 3.998417901303344*^9}},
 CellID->1822954783,ExpressionUUID->"60a34e61-0050-42a9-b0dd-f23dcb382fea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DPEX", "[", "x", "]"}], " ", "@", " ", "GWP1DVAL"}], "\n", 
 RowBox[{
  RowBox[{"GWP1DPEX", "[", "x", "]"}], " ", "@", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"GWP1DFHONON", "[", 
     RowBox[{"OMEGA", ",", " ", "A", ",", " ", "OMEGA1"}], "]"}], "[", "t", 
    "]"}], " ", "@", " ", "GWP1DVAL"}]}]}], "Input",
