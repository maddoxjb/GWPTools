 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<EKEPE\>\"", "]"}], "[", "t", "]"}], " ", "//", 
  " ", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", 
    RowBox[{"\"\<EKEPE\>\"", ",", " ", "2", ",", " ", "1"}], "]"}], "[", "t", 
   "]"}], " ", "//", " ", "Simplify"}]}], "Input",
 CellLabel->"In[80]:=",
 CellID->861872454,ExpressionUUID->"5c32bd36-4a68-46d8-8502-72bad8a32ba9"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "64"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", "\[ImaginaryI]"}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"Cos", "[", "t", "]"}], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", "\[ImaginaryI]"}], "+", 
