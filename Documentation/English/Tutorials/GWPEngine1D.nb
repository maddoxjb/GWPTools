  3.998852941122553*^9},
 CellLabel->"Out[17]=",
 CellID->280847555,ExpressionUUID->"27c27ff0-49ef-4359-8306-ad93d5ce1c1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"Cos", "[", 
    RowBox[{"OMEGA", " ", "t"}], "]"}]}], "+", 
  FractionBox[
   RowBox[{"RP", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}], 
   RowBox[{"MASS", " ", "OMEGA"}]]}]], "Output",
 CellChangeTimes->{3.998420641151086*^9, 3.998645367568573*^9, 
  3.998852941123836*^9},
 CellLabel->"Out[18]=",
 CellID->35800779,ExpressionUUID->"b5a64764-9de8-4093-a958-3fce73a7c408"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"OMEGA", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", "MASS", " ", "OMEGA", " ", "RX"}], "-", 
      RowBox[{"A", " ", "t"}]}], ")"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"A", "+", 
      RowBox[{"2", " ", "OMEGA", " ", "RP"}]}], ")"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"OMEGA", " ", "t"}], "]"}]}]}], 
  RowBox[{"2", " ", "MASS", " ", 
   SuperscriptBox["OMEGA", "2"]}]]], "Output",
 CellChangeTimes->{3.998420641151086*^9, 3.998645367568573*^9, 
  3.9988529411248617`*^9},
 CellLabel->"Out[19]=",
 CellID->408271493,ExpressionUUID->"31e28352-b10e-4c70-8c5b-982e69804f69"]
}, Open  ]]
}, Open  ]],

