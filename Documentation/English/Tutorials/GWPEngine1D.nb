       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}], ")"}], 
