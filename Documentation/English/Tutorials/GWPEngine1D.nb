Cell[CellGroupData[{

Cell["\<\
Evaluate the potential for a generic parameter bus and a time-evolved \
non-resonant forced harmonic oscillator.\
\>", "MathCaption",
 CellChangeTimes->{{3.998417881348628*^9, 3.998417901303344*^9}},
 CellID->1822954783,ExpressionUUID->"60a34e61-0050-42a9-b0dd-f23dcb382fea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DPEX", "[", "x", "]"}], " ", "@", " ", "GWP1DVAL"}], "\n", 
 RowBox[{
  RowBox[{"GWP1DPEX", "[", "x", "]"}], " ", "@", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"GWP1DFHONON", "[", 
     RowBox[{"OMEGA", ",", " ", "A", ",", " ", "OMEGA1"}], "]"}], "[", "t", 
    "]"}], " ", "@", " ", "GWP1DVAL"}]}]}], "Input",
 CellChangeTimes->{{3.9984178599012403`*^9, 3.9984178617962418`*^9}, {
  3.9984179047304373`*^9, 3.9984179120503063`*^9}},
 CellLabel->"In[166]:=",
 CellID->1047914876,ExpressionUUID->"55163928-635c-412c-b35c-82b6ec86f0f4"],

Cell[BoxData[
 RowBox[{"V0", "+", 
  RowBox[{"V1", " ", "x"}], "+", 
  RowBox[{"V2", " ", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{3.998420645424754*^9, 3.9986459422237062`*^9, 
  3.99885295645798*^9, 4.0004123238482647`*^9},
 CellLabel->"Out[166]=",
 CellID->799158520,ExpressionUUID->"cfedc27d-220f-4f31-9154-d978986d099a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["1", "2"], " ", "MASS", " ", 
   SuperscriptBox["OMEGA", "2"], " ", 
   SuperscriptBox["x", "2"]}], "-", 
  RowBox[{"A", " ", "x", " ", 
   RowBox[{"Sin", "[", 
    RowBox[{"OMEGA1", " ", "t"}], "]"}]}]}]], "Output",
 CellChangeTimes->{3.998420645424754*^9, 3.9986459422237062`*^9, 
  3.99885295645798*^9, 4.0004123238494587`*^9},
