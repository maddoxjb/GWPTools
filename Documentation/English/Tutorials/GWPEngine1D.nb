Cell[CellGroupData[{

Cell["\<\
Instantiate a static wavepacket alongside two dynamic wavepackets in \
different trap environments.\
\>", "MathCaption",
 CellID->1727647586,ExpressionUUID->"70dbc279-27cc-4e2d-97d0-ea22a5ada6cb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<HO\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ3", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", " ", "->", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<ResonantForcedHO\>\"", ",", " ", "1", ",", " ", 
       RowBox[{"1", "/", "10"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[68]:=",
 CellID->446586815,ExpressionUUID->"f33d4ca0-4cec-4a85-9ec8-929e128ad22c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the external potential energy field (PEX). Environmental properties \
gracefully fail with a descriptive warning if the wavepacket lacks an active \
potential.\
\>", "MathCaption",
 CellID->329253440,ExpressionUUID->"980f0f73-1213-49c8-8d27-f935dbc63a0f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", "[", "\"\<PEX\>\"", "]"}], "[", 
  RowBox[{"x", ",", " ", "t"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", "[", "\"\<PEX\>\"", "]"}], "[", 
  RowBox[{"x", ",", " ", "t"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"OBJ3", "[", "\"\<PEX\>\"", "]"}], "[", 
  RowBox[{"x", ",", " ", "t"}], "]"}]}], "Input",
 CellLabel->"In[71]:=",
 CellID->1844691408,ExpressionUUID->"49f78dd3-b651-4e09-888a-37758677adf9"],

