Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "RX", ",", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"4", " ", "RA"}]], "+", 
    SuperscriptBox["RX", "2"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"3", " ", "RX"}], 
     RowBox[{"4", " ", "RA"}]], "+", 
    SuperscriptBox["RX", "3"]}], ",", 
   RowBox[{
    FractionBox["3", 
     RowBox[{"16", " ", 
      SuperscriptBox["RA", "2"]}]], "+", 
    FractionBox[
     RowBox[{"3", " ", 
      SuperscriptBox["RX", "2"]}], 
     RowBox[{"2", " ", "RA"}]], "+", 
    SuperscriptBox["RX", "4"]}], ",", 
   RowBox[{
    FractionBox[
     RowBox[{"15", " ", "RX"}], 
     RowBox[{"16", " ", 
      SuperscriptBox["RA", "2"]}]], "+", 
    FractionBox[
     RowBox[{"5", " ", 
      SuperscriptBox["RX", "3"]}], 
     RowBox[{"2", " ", "RA"}]], "+", 
    SuperscriptBox["RX", "5"]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9984206448758717`*^9, 3.998645915728356*^9, 
  3.998852955815411*^9},
