   FractionBox["1", "4"], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", ",", 
   FractionBox["1", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], 
     RowBox[{"1", "/", "4"}]]], ",", "1", ",", "1", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "4"], ",", "0", ",", "0", ",", "0", ",", "0", ",", "0", 
     ",", "0", ",", "0"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.998420642972308*^9, 3.9986457887640753`*^9, 
  3.998852943116769*^9, 4.0004123111646767`*^9},
 CellLabel->"Out[94]=",
 CellID->1012069097,ExpressionUUID->"d9e2d9d1-56f3-4e2e-8d7f-7f36f18805f4"]
}, Open  ]]
