Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}], "[", "\"\<INIT\>\"", 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"RA", " ", "+", " ", 
     RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP", ",", " ", 
    RowBox[{"RG", " ", "+", " ", 
     RowBox[{"I", "*", "IG"}]}], ",", " ", 
    RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}], ",", " ", 
    RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "\"\<HBAR\>\""}]}], "]"}], 
  "[", "\"\<INIT\>\"", "]"}]}], "Input",
