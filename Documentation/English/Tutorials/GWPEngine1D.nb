Cell[CellGroupData[{

Cell["\<\
Evaluate the kinetic energy expectation (EKE). Because kinetic energy depends \
solely on momentum-space kinematics, it evaluates perfectly even for static \
wavepackets.\
\>", "MathCaption",
 CellID->507082517,ExpressionUUID->"0d377ffe-2538-4abc-91a2-899de2a6465a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"OBJ1", "[", "\"\<EKE\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<EKE\>\"", "]"}], "[", "t", "]"}], "//", 
  "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ3", "[", "\"\<EKE\>\"", "]"}], "[", "t", "]"}], "//", 
  "Simplify"}]}], "Input",
 CellChangeTimes->{{3.9984142278697023`*^9, 3.998414234184207*^9}},
