      Text[""]], 
     PaneBox[
      InterpretationBox[Cell[BoxData[
        FormBox[
         StyleBox["\<\"A1 = RA + I*IA\"\>",
          StripOnInput->False,
          TextAlignment->Left,
          LineIndent->0], TextForm]], "InlineText",ExpressionUUID->
        "5e8238fd-f131-41be-b320-d5a97ec19100"],
