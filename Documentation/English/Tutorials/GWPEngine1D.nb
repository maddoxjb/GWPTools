 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"GWP1DEX", "[", "#", "]"}], " ", "@", " ", "GWP1DVAL"}], " ", 
   "&"}], " ", "/@", " ", 
  RowBox[{"Range", "[", 
   RowBox[{"0", ",", " ", "5"}], "]"}]}]], "Input",
