Cell[CellGroupData[{

Cell["\<\
Evaluate exact arbitrary order kinetic-potential energy cross-moments and \
covariance.\
\>", "MathCaption",
 CellChangeTimes->{{3.998419320797418*^9, 3.998419323449847*^9}, {
  3.998420258269321*^9, 3.998420275786791*^9}},
 CellID->175586749,ExpressionUUID->"ce881c00-29b9-4cb8-85ad-89c4a1f8182e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEKEPE", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DHO", "[", "t", "]"}], "@", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", " ", "//", " ", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEPEKE", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], "@", " ", 
   RowBox[{
    RowBox[{"GWP1DHO", "[", "t", "]"}], "@", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellLabel->"In[177]:=",
 CellID->889298162,ExpressionUUID->"13d630a7-ff34-4b0b-bcdc-7afaa80305c6"],

Cell[BoxData[
 FractionBox[
  RowBox[{"9", " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"4", " ", "\[ImaginaryI]"}], "+", 
      RowBox[{"3", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "t"}], "]"}]}]}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"16", "-", 
     RowBox[{"8", " ", "\[ImaginaryI]", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}], "+", 
     RowBox[{"15", " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", "t"}], "]"}], "2"]}]}], ")"}]}], 
  RowBox[{"4096", " ", 
   RowBox[{"(", 
    RowBox[{"5", "+", 
     RowBox[{"3", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.9984206458703547`*^9, 3.998645958801072*^9, 
  3.998852956949594*^9, 4.000412324294572*^9},
 CellLabel->"Out[177]=",
 CellID->355614507,ExpressionUUID->"b4b63012-17ba-4ca5-a13e-99dee01ebcd6"],

Cell[BoxData[
 FractionBox[
  RowBox[{"9", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"4", " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "t", "]"}], "2"]}], "+", 
     SuperscriptBox[
      RowBox[{"Sin", "[", "t", "]"}], "2"]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "\[ImaginaryI]"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "4"}], " ", "\[ImaginaryI]"}], "+", 
     RowBox[{"5", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}], ")"}]}], "2048"]], "Output",
 CellChangeTimes->{3.9984206458703547`*^9, 3.998645958801072*^9, 
  3.998852956949594*^9, 4.000412324298766*^9},
 CellLabel->"Out[178]=",
 CellID->366029548,ExpressionUUID->"12886bb0-4e61-4dd5-aa44-9afada4e48d2"]
}, Open  ]],

