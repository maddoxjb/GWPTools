}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate analytical energy probability densities under different driving \
potentials.\
\>", "MathCaption",
 CellChangeTimes->{{3.9984164581568003`*^9, 3.99841646552565*^9}},
 CellID->666826458,ExpressionUUID->"d0e69a58-df0a-46fe-9b3d-82f3cc59f484"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DRHOE", "[", "e", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", "//", " ", 
  "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DRHOE", "[", "e", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DHO", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], " ", "//", " ", 
  "Simplify"}]}], "Input",
 CellLabel->"In[141]:=",
 CellID->55253229,ExpressionUUID->"530e27b4-7c5c-40fb-8be3-f8fb776ac22b"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", 
   SqrtBox[
    FractionBox["1", "e"]], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", "4"}], " ", "e"}]]}], 
  SqrtBox["\[Pi]"]]], "Output",
 CellChangeTimes->{3.998420644491588*^9, 3.998645899081624*^9, 
  3.998852955334757*^9},
 CellLabel->"Out[141]=",
 CellID->929016038,ExpressionUUID->"01f12b7e-6526-4ca8-a24b-5ef799b8796c"],

Cell[BoxData[
 RowBox[{"2", " ", 
  SqrtBox[
   FractionBox["1", "e"]], " ", 
  SuperscriptBox["\[ExponentialE]", 
   FractionBox[
    RowBox[{"8", " ", "e"}], 
    RowBox[{
     RowBox[{"-", "5"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]], " ", 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], " ", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{"5", "-", 
     RowBox[{"3", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]]}]], "Output",
 CellChangeTimes->{3.998420644491588*^9, 3.998645899081624*^9, 
  3.998852955369433*^9},
 CellLabel->"Out[142]=",
 CellID->1766436976,ExpressionUUID->"71445663-6529-428d-adaf-e6a5841b12ab"]
}, Open  ]]
}, Open  ]],

