Cell[CellGroupData[{

Cell["Expectation Values", "Subsection",
 CellID->1825676269,ExpressionUUID->"1fe9fb28-73a2-47cd-abaf-73f7b480f8cf"],

Cell["\<\
The ExpectationValues class maps to exact algebraic evaluators for \
statistical moments. It provides access to arbitrary-order position and \
momentum expectations, cross-correlations, uncertainties, and \
potential-coupled force expectations.\
\>", "Text",
 CellID->894704747,ExpressionUUID->"2dfcb17d-41a3-4a6b-8e64-e3a1e86f1ae8"],

