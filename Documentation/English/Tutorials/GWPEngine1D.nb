        StyleBox["\<\"Description\"\>",
         StripOnInput->False,
         FontSize->14,
         FontWeight->Bold], TextForm]], "InlineText",ExpressionUUID->
       "753b4211-5f77-42df-b3d3-87acc5594eaf"],
      Text[
       Style["Description", Bold, 14]]]},
    {
     InterpretationBox[Cell[BoxData[
       FormBox["\<\"GWP1DASSUMPTIONS[param, opts]\"\>", TextForm]], 
       "InlineText",ExpressionUUID->"f76f950b-a60a-424e-8065-f3c7fd1e9322"],
      Text["GWP1DASSUMPTIONS[param, opts]"]], 
     PaneBox[
      InterpretationBox[Cell[BoxData[
        FormBox[
         StyleBox["\<\"Generates real-domain assumptions for the parameters \
and variables.\"\>",
          StripOnInput->False,
          TextAlignment->Left,
          LineIndent->0], TextForm]], "InlineText",ExpressionUUID->
        "247b3c6d-41ac-41d1-a2c0-1c1a8bc2a2ae"],
       Text[
        Style[
        "Generates real-domain assumptions for the parameters and variables.",
          TextAlignment -> Left, LineIndent -> 0]]],
      ImageSize->{
        UpTo[425], Automatic}]}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Top}}},
