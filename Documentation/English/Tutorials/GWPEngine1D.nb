  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DRHOX", "[", "x", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "//", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DRHOX", "[", "1", "]"}], "[", "x", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "Input",
