Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}], ")"}]}], "+", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  RowBox[{
   SqrtBox[
    RowBox[{"-", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}], ")"}], 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{3.998420644324901*^9, 3.998645889090526*^9, 
  3.998852955152686*^9},
 CellLabel->"Out[136]=",
 CellID->1174759393,ExpressionUUID->"32c3e535-6964-4df8-8519-d88ffc901d49"]
}, Open  ]]
}, Open  ]],

Cell["\<\
Probability densities represent the physical statistical distributions across \
phase space and energy. While spatial and momentum densities support \
arbitrary-order recursive derivatives, the energy density (RHOE) acts purely \
as a field evaluator.\
\>", "Text",
 CellID->1160149762,ExpressionUUID->"c1776380-bbb2-483a-9e4f-a15bec518352"],

Cell[CellGroupData[{

