Cell[CellGroupData[{

Cell["\<\
Instantiate a default static wavepacket and a dynamic free-particle \
wavepacket.\
\>", "MathCaption",
 CellID->1343244573,ExpressionUUID->"10f9fe04-9ac9-404b-994f-3fd890fa3e07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<Free\>\""}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[27]:=",
 CellID->1563441147,ExpressionUUID->"0f6a3a88-5a20-4172-a47c-b70d90795930"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the position-space wavefunction. The static object returns a \
function of space (x), while the dynamic object returns a field over space \
and time (x, t).\
\>", "MathCaption",
 CellID->145452937,ExpressionUUID->"2e63a16a-b8b5-4c80-b889-0d3fca1e3273"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", "[", "\"\<PSIX\>\"", "]"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<PSIX\>\"", "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998413226729312*^9, 3.998413228570528*^9}},
 CellLabel->"In[29]:=",
 CellID->791121873,ExpressionUUID->"aae3a3bf-12c1-43b5-ac22-6193a2d4a063"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "4"]}]], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"2", " ", "\[Pi]"}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.9984206413265867`*^9, 3.998645463468347*^9, 
  3.998852941283401*^9},
 CellLabel->"Out[29]=",
 CellID->262541329,ExpressionUUID->"72b0af21-027f-4dab-b44f-3a6839faa468"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["x", "2"], 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]], "-", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"4", "+", 
     SuperscriptBox["t", "2"]}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.9984206413265867`*^9, 3.998645463468347*^9, 
  3.9988529413002768`*^9},
 CellLabel->"Out[30]=",
 CellID->1600705565,ExpressionUUID->"1b4b7724-8d21-405b-b25e-caf578977251"]
}, Open  ]]
}, Open  ]],

