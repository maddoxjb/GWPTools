}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the position-space probability density (RHOX) and its first spatial \
derivative using the integer order argument.\
\>", "MathCaption",
 CellID->31155449,ExpressionUUID->"0698f87a-1ec0-4600-af88-b37d9714a440"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<RHOX\>\"", "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{"OBJ1", "[", 
   RowBox[{"\"\<RHOX\>\"", ",", " ", "1"}], "]"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", 
    RowBox[{"\"\<RHOX\>\"", ",", " ", "1"}], "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998413427676793*^9, 3.998413437057023*^9}},
 CellLabel->"In[42]:=",
 CellID->1791105122,ExpressionUUID->"78b969b3-2539-48f2-bd9e-094d1a1e840e"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"]}]], 
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]]]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941656831*^9},
 CellLabel->"Out[42]=",
 CellID->211416945,ExpressionUUID->"68f642f9-01c9-42fc-9195-5217dc61648b"],

Cell[BoxData[
 RowBox[{"2", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", 
      SuperscriptBox["x", "2"]}], 
     RowBox[{"5", "+", 
      RowBox[{"3", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "t"}], "]"}]}]}]]}]], " ", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{
     RowBox[{"5", " ", "\[Pi]"}], "+", 
     RowBox[{"3", " ", "\[Pi]", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941676692*^9},
 CellLabel->"Out[43]=",
 CellID->1346642477,ExpressionUUID->"482a636d-efdd-48e3-a661-17fea454f03c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}]], " ", "x"}], 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.99885294167817*^9},
 CellLabel->"Out[44]=",
 CellID->689955206,ExpressionUUID->"a3b756c3-5fe9-452e-9f3e-e1665403195b"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"16", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox["x", "2"]}], 
       RowBox[{"5", "+", 
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "t"}], "]"}]}]}]]}]], " ", "x", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"5", "+", 
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "t"}], "]"}]}]}]], ")"}], 
     RowBox[{"3", "/", "2"}]]}], 
   SqrtBox["\[Pi]"]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.9988529416887693`*^9},
