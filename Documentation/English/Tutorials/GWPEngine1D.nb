     RowBox[{"\[ImaginaryI]", " ", "t"}]}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}], ")"}], 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
