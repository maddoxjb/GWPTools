          RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]], "-", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]], " ", "x"}], 
