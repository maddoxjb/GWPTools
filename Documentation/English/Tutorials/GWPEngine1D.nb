Cell[CellGroupData[{

Cell["Compute position-momentum product expectation values.", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.998417544149523*^9, 3.998417581741465*^9}},
 CellID->293226662,ExpressionUUID->"34df7f08-b970-4ee9-853b-70f226fb8c46"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GWP1DEXP", " ", "@", " ", "GWP1DVAL"}], "\[IndentingNewLine]", 
 RowBox[{"GWP1DEPX", " ", "@", " ", "GWP1DVAL"}]}], "Input",
 CellChangeTimes->{{3.998417506053554*^9, 3.998417508658801*^9}},
 CellLabel->"In[157]:=",
 CellID->1521216628,ExpressionUUID->"dd8c0c10-956a-4919-9cb6-411c8d646e50"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"(", 
    RowBox[{"RP", "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[ImaginaryI]", " ", "IA"}], "+", "RA"}], ")"}], " ", 
      "RX"}]}], ")"}]}], "+", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"\[ImaginaryI]", " ", "IA"}], "+", "RA"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", "RA"}]], "+", 
     SuperscriptBox["RX", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.998420645138262*^9, 3.9986459251161613`*^9, 
  3.99885295614924*^9, 4.0004123235510817`*^9},
 CellLabel->"Out[157]=",
 CellID->2079827753,ExpressionUUID->"d584aa63-dfc7-44a0-934a-c0cc32a4dd76"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RX", " ", 
   RowBox[{"(", 
    RowBox[{"RP", "+", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", "IA"}], "+", "RA"}], ")"}], " ",
       "RX"}]}], ")"}]}], "-", 
  RowBox[{"2", " ", "\[ImaginaryI]", " ", "HBAR", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], " ", "IA"}], "+", "RA"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"4", " ", "RA"}]], "+", 
     SuperscriptBox["RX", "2"]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.998420645138262*^9, 3.9986459251161613`*^9, 
  3.99885295614924*^9, 4.000412323552351*^9},
 CellLabel->"Out[158]=",
 CellID->1073722452,ExpressionUUID->"7c36f69f-2da1-40ad-ada6-3b624b805b9e"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute arbitrary order position-momentum product expectation values.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.99841762520308*^9, 3.998417636684766*^9}},
 CellID->1812559409,ExpressionUUID->"c117f0dd-b56e-4811-a69f-207cdf3bb041"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEXP", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], " ", "@", " ", "GWP1DVAL"}], " ", "//",
   " ", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DEPX", "[", 
    RowBox[{"2", ",", " ", "1"}], "]"}], " ", "@", " ", "GWP1DVAL"}], " ", "//",
   " ", "Simplify"}]}], "Input",
 CellLabel->"In[159]:=",
 CellID->960831599,ExpressionUUID->"e70703ce-41b8-42ec-9170-ce692fe21f02"],

Cell[BoxData[
 FractionBox[
  RowBox[{"RP", "-", 
   RowBox[{"4", " ", "HBAR", " ", "IA", " ", "RX"}], "+", 
   RowBox[{"4", " ", "\[ImaginaryI]", " ", "HBAR", " ", "RA", " ", "RX"}], "+", 
   RowBox[{"4", " ", "RA", " ", "RP", " ", 
    SuperscriptBox["RX", "2"]}]}], 
  RowBox[{"4", " ", "RA"}]]], "Output",
 CellChangeTimes->{3.998420645163013*^9, 3.998645926780261*^9, 
  3.998852956175375*^9, 4.0004123235770407`*^9},
 CellLabel->"Out[159]=",
 CellID->748165023,ExpressionUUID->"b402403b-842a-4e3d-b3a3-78f65379b66c"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{
    RowBox[{"-", "HBAR"}], " ", 
    RowBox[{"(", 
     RowBox[{"IA", "+", 
      RowBox[{"\[ImaginaryI]", " ", "RA"}]}], ")"}], " ", "RP"}], "+", 
   RowBox[{
    SuperscriptBox["HBAR", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["IA", "2"], "+", 
      SuperscriptBox["RA", "2"]}], ")"}], " ", "RX"}], "+", 
   RowBox[{"RA", " ", 
    SuperscriptBox["RP", "2"], " ", "RX"}]}], "RA"]], "Output",
 CellChangeTimes->{3.998420645163013*^9, 3.998645926780261*^9, 
  3.998852956175375*^9, 4.00041232361614*^9},
 CellLabel->"Out[160]=",
 CellID->892788376,ExpressionUUID->"aab67b7d-56f7-450b-bcec-78013c8b7ae4"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Compute the position-momentum covariance for a free particle.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9984173522842293`*^9, {3.99841762520308*^9, 3.998417685455014*^9}},
 CellID->346664729,ExpressionUUID->"2681fc04-89de-4701-b44f-4ce7373b2662"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GWP1DCOVXP", " ", "@", " ", 
  RowBox[{
   RowBox[{"GWP1DFREE", "[", "t", "]"}], "@", "GWP1DVAL"}]}]], "Input",
 CellChangeTimes->{
  3.998417500676723*^9, {3.9984175962847548`*^9, 3.998417604184163*^9}, {
   3.998417642564015*^9, 3.998417674605754*^9}},
 CellLabel->"In[161]:=",
 CellID->1241333781,ExpressionUUID->"74b2a03d-02dd-4897-bcd9-7f03a2118102"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"HBAR", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"IA", " ", "MASS"}], "-", 
      RowBox[{"2", " ", "HBAR", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["IA", "2"], "+", 
         SuperscriptBox["RA", "2"]}], ")"}], " ", "t"}]}], ")"}]}], 
   RowBox[{"2", " ", "MASS", " ", "RA"}]]}]], "Output",
 CellChangeTimes->{3.9984206451898317`*^9, 3.9986459292986526`*^9, 
  3.998852956206895*^9, 4.000412323642825*^9},
 CellLabel->"Out[161]=",
 CellID->625993843,ExpressionUUID->"17d0ca8d-7c91-405b-8367-5ed2448d0364"]
}, Open  ]]
}, Open  ]],

Cell["\<\
The instantaneous environmental fields (PEX and FEX) dictate the local \
potential energy and forces acting upon the wavepacket. Potential-coupled \
expectations (such as the expected force EF1) evaluate exactly against these \
local landscapes.\
\>", "Text",
 CellID->1365372268,ExpressionUUID->"73ac21c3-e366-42bf-8ebb-19ddb18374c7"],

