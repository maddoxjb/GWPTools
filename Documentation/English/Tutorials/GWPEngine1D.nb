  "Grid"]], "Output",
 CellChangeTimes->{3.998421519097868*^9, 3.9986458502995987`*^9, 
  3.998852944030726*^9, 4.0004123120489483`*^9},
 CellLabel->"Out[120]=",
 CellID->2076336950,ExpressionUUID->"780c46f2-1038-4bf1-bf35-9ccc8af26b77"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Extract the raw list of symbolic assumptions. Note that GWP1DASSUMPTIONS must \
be called on an evaluated parameter bus (which populates the INIT list) \
rather than the raw GWP1DVAL routing macro.\
\>", "MathCaption",
 CellChangeTimes->{
  3.9984215566955853`*^9, {3.9984219450154657`*^9, 3.9984220001930237`*^9}, 
   3.998422083702322*^9},
 CellID->1667675419,ExpressionUUID->"d5685af7-ee9f-444c-a5b1-e4808878c377"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM", "=", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{
     RowBox[{"RA", "+", 
      RowBox[{"I", "*", "IA"}]}], ",", "RX", ",", "RP", ",", 
     RowBox[{"RG", "+", 
      RowBox[{"I", "*", "IG"}]}], ",", 
     RowBox[{"\"\<MASS\>\"", "->", "MASS"}], ",", 
     RowBox[{"\"\<HBAR\>\"", "->", "HBAR"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ASSUM", "=", 
  RowBox[{"GWP1DASSUMPTIONS", "@", "PARAM"}]}]}], "Input",
 CellChangeTimes->{
  3.998421564543936*^9, {3.998421613385992*^9, 3.998421668812236*^9}, {
   3.998421870286162*^9, 3.99842189138447*^9}},
 CellLabel->"In[121]:=",
 CellID->1811690136,ExpressionUUID->"c9706600-0ee6-49b6-ae49-4a77242414e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
    "HBAR", "|", "IA", "|", "IG", "|", "MASS", "|", "RA", "|", "RG", "|", 
     "RP", "|", "RX"}], ")"}], "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"RA", ">", "0"}], "&&", 
  RowBox[{"HBAR", ">", "0"}], "&&", 
  RowBox[{"MASS", ">", "0"}]}]], "Output",
 CellChangeTimes->{
  3.998421565197176*^9, {3.9984216166173964`*^9, 3.9984216254052973`*^9}, 
   3.99842166943287*^9, {3.9984218840811357`*^9, 3.99842189226126*^9}, 
   3.998645854432699*^9, 3.998852944052225*^9, 4.0004123120765667`*^9},
 CellLabel->"Out[122]=",
 CellID->385854900,ExpressionUUID->"2c04c51b-6e4b-4a69-845d-1c22499cb9bf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The presence of these assumptions is critical for backend evaluation speed. \
To demonstrate this, extract the generic spatial probability density (RHOX).\
\>", "MathCaption",
 CellChangeTimes->{3.998421702665193*^9},
 CellID->659510286,ExpressionUUID->"f63cd07d-7649-47a6-9ea4-bc8cc87a824b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rho", "=", 
  RowBox[{
   RowBox[{"GWP1DRHOX", "[", "x", "]"}], "@", "PARAM"}]}]], "Input",
 CellChangeTimes->{
  3.998421712077221*^9, {3.9984217618696632`*^9, 3.998421792932722*^9}, {
   3.998421902090506*^9, 3.998421903075673*^9}},
 CellLabel->"In[123]:=",
 CellID->1226274635,ExpressionUUID->"8b41ceb0-1478-4a06-8e47-b6a17894cecf"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{
    RowBox[{"-", "2"}], " ", "RA", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "RX"}], "+", "x"}], ")"}], "2"]}]], " ", 
  SqrtBox[
   FractionBox["2", "\[Pi]"]], " ", 
  SqrtBox["RA"]}]], "Output",
 CellChangeTimes->{3.998421762711067*^9, 3.998421793767565*^9, 
  3.998421903728547*^9, 3.998645856515539*^9, 3.9988529440692873`*^9, 
  4.0004123120886602`*^9},
 CellLabel->"Out[123]=",
 CellID->1810174007,ExpressionUUID->"14761fa9-1db0-4ff8-bf86-4ecd97b0974d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Attempt to integrate the density over all space without passing the physical \
assumptions. Depending on the Mathematica version, this may take \
significantly longer and will likely return an unresolved \
ConditionalExpression because the kernel does not know that the spatial \
spread parameter is strictly positive.\
\>", "MathCaption",
 CellChangeTimes->{{3.9984218358988457`*^9, 3.998421845817903*^9}},
 CellID->578234482,ExpressionUUID->"54e36f26-2c7f-48bd-81f1-c5e8bdd47700"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{"Integrate", "[", 
   RowBox[{"rho", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.998421726748166*^9, 3.998421726749009*^9}},
 CellLabel->"In[124]:=",
 CellID->1457651275,ExpressionUUID->"6625fcf2-caa1-4887-9728-7a1ca5b6f4cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"9.15417`", ",", 
   TemplateBox[{"1", 
     RowBox[{
       RowBox[{"Re", "[", "RA", "]"}], "\[GreaterEqual]", "0"}]},
    "ConditionalExpression"]}], "}"}]], "Output",
 CellChangeTimes->{
  3.998421736681766*^9, {3.9984217750088453`*^9, 3.998421804570162*^9}, 
   3.998421855310595*^9, 3.998421914786632*^9, 3.9986458681873817`*^9, 
   3.998852953348323*^9, 4.000412321262745*^9},
 CellLabel->"Out[124]=",
 CellID->193708600,ExpressionUUID->"48b4e340-2d0e-4575-809e-6bbafc83acda"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Now, perform the exact same integration while passing the generated \
assumptions to the kernel. The evaluation resolves almost instantly to the \
exact analytical normalization factor.\
\>", "MathCaption",
 CellChangeTimes->{3.9984218303435173`*^9},
 CellID->1291565594,ExpressionUUID->"ae9cd447-61d4-4b1c-8128-dd6dee0ca005"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"AbsoluteTiming", "[", 
  RowBox[{"Integrate", "[", 
   RowBox[{"rho", ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", "ASSUM"}]}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.9984217428042707`*^9, 3.998421742804594*^9}, {
  3.998421804187271*^9, 3.998421804864201*^9}, {3.998421912537545*^9, 
  3.998421913429419*^9}},
 CellLabel->"In[125]:=",
 CellID->1239385947,ExpressionUUID->"9b0c437a-115d-49bc-9728-c33028bbcf7e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0.805119`", ",", "1"}], "}"}]], "Output",
 CellChangeTimes->{3.998421806831861*^9, 3.998421855725758*^9, 
  3.99842191655018*^9, 3.998645869062222*^9, 3.9988529543858023`*^9, 
  4.0004123221569023`*^9},
 CellLabel->"Out[125]=",
 CellID->75231348,ExpressionUUID->"05aca362-cc32-4564-84df-7ae8466c9a69"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Potential Models & Propagation", "Subsection",
 CellID->1458986342,ExpressionUUID->"ea16d2cb-eca7-4021-9b49-9e2cff7831ed"],

Cell["\<\
Potential energy models function as exact analytical time-evolution \
propagators. They utilize a curried signature architecture (e.g., \
GWP1DHARMONIC[omega][t][param]) to analytically propagate the wavepacket \
shape, centers, and phases.\
\>", "Text",
 CellChangeTimes->{{3.998416146450576*^9, 3.9984161485334587`*^9}},
 CellID->1215168548,ExpressionUUID->"6a96727b-00bd-426b-8745-5a97aef4ddb1"],

Cell[CellGroupData[{

Cell["\<\
Inspect the developer usage metadata and curried signatures for all \
analytical potential models.\
\>", "MathCaption",
 CellID->768303266,ExpressionUUID->"c2c18a2e-f001-48d3-90ff-157bf8aa06b4"],

