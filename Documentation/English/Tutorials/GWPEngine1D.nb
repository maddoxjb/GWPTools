Cell[CellGroupData[{

Cell["\<\
Evaluate the base spatial wavefunction, its exact first spatial derivative, \
and its dynamic evolution under a free particle potential.\
\>", "MathCaption",
 CellID->400141909,ExpressionUUID->"84596b5b-d540-4e8c-80e6-2ba4950502ef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"GWP1DPSIX", "[", "x", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIX", "[", "1", "]"}], "[", "x", "]"}], " ", "@", " ", 
  RowBox[{"GWP1DPARAM", "[", "]"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GWP1DPSIX", "[", "x", "]"}], " ", "@", " ", 
   RowBox[{
    RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.99841625014723*^9, 3.9984162517272387`*^9}},
 CellLabel->"In[130]:=",
 CellID->1413765806,ExpressionUUID->"6c8950ee-7da1-462b-bb7f-097e8a9b1160"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "4"]}]], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"2", " ", "\[Pi]"}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954944854*^9},
 CellLabel->"Out[130]=",
 CellID->1782421026,ExpressionUUID->"e249d574-7d7e-4237-88da-d38b62058777"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "4"]}]], " ", "x"}], 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"2", " ", "\[Pi]"}], ")"}], 
     RowBox[{"1", "/", "4"}]]}]]}]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954946806*^9},
 CellLabel->"Out[131]=",
 CellID->1900791979,ExpressionUUID->"9a871e65-5cb2-4bcf-97ae-b612ad296e4b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        SuperscriptBox["x", "2"], 
        RowBox[{
         RowBox[{
          RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]], "-", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"4", "+", 
     SuperscriptBox["t", "2"]}], ")"}], 
   RowBox[{"1", "/", "4"}]]]], "Output",
 CellChangeTimes->{3.99842064416374*^9, 3.998645883363079*^9, 
  3.998852954948155*^9},
 CellLabel->"Out[132]=",
 CellID->644058281,ExpressionUUID->"51f18538-bfee-41d0-b3c8-b0aec660ceb1"]
}, Open  ]]
}, Open  ]],

