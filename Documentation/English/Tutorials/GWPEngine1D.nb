Cell[CellGroupData[{

Cell["\<\
Instantiate three symbolic wavepackets: one static (no potential), one in a \
standard harmonic trap, and one in a driven resonant trap.\
\>", "MathCaption",
 CellID->57936731,ExpressionUUID->"8a105a7e-545b-486e-b90e-d72baabdd13f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}], ",", " ", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Harmonic\>\"", ",", " ", "OMEGA"}], "}"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ3", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}], ",", " ", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<ResonantForcedHO\>\"", ",", " ", "OMEGA", ",", " ", "A"}],
        "}"}]}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[14]:=",
 CellID->932545826,ExpressionUUID->"ea5a98b1-b294-484f-aad6-9edbbbf9eced"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the position center. Notice how the static wavepacket returns a \
constant, while the trapped wavepackets return functions of time (t).\
\>", "MathCaption",
 CellID->962041776,ExpressionUUID->"764ce5f3-1bce-4c5e-bd3b-64f439b4824f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"OBJ1", "[", "\"\<PositionCenter\>\"", "]"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", "[", "\"\<PositionCenter\>\"", "]"}], "[", "t", "]"}], "\n", 
 RowBox[{
  RowBox[{"OBJ3", "[", "\"\<PositionCenter\>\"", "]"}], "[", "t", 
  "]"}]}], "Input",
 CellLabel->"In[17]:=",
 CellID->631750969,ExpressionUUID->"835a00a7-0831-4b55-a34c-b160f9eccba2"],

Cell[BoxData["RX"], "Output",
