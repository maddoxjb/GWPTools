Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    SuperscriptBox["p", "2"]}]], " ", "p", " ", 
  SuperscriptBox[
   RowBox[{"(", 
    FractionBox["2", "\[Pi]"], ")"}], 
   RowBox[{"1", "/", "4"}]]}]], "Output",
 CellChangeTimes->{3.998420644324901*^9, 3.998645889090526*^9, 
