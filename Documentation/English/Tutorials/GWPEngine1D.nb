Cell[CellGroupData[{

Cell["\<\
Generate the core physical and real-domain assumptions for that same symbolic \
wavepacket to aid in analytical simplification.\
\>", "MathCaption",
 CellID->564667768,ExpressionUUID->"8a4822d8-81ec-409f-b9df-a4749cb3ca2c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{
    RowBox[{"RA", " ", "+", " ", 
     RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP", ",", " ", 
    RowBox[{"RG", " ", "+", " ", 
     RowBox[{"I", "*", "IG"}]}], ",", " ", 
    RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}], ",", " ", 
    RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "\"\<HBAR\>\""}]}], "]"}], 
  "[", "\"\<Assumptions\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.998412858179699*^9, 3.998412858396941*^9}},
 CellLabel->"In[12]:=",
 CellID->640940683,ExpressionUUID->"077f85d1-e916-4156-9024-a71d86690ace"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
    "IA", "|", "IG", "|", "MASS", "|", "RA", "|", "RG", "|", "RP", "|", 
     "RX"}], ")"}], "\[Element]", 
   TemplateBox[{},
    "Reals"]}], "&&", 
  RowBox[{"RA", ">", "0"}], "&&", 
  RowBox[{"\<\"HBAR\"\>", ">", "0"}], "&&", 
  RowBox[{"MASS", ">", "0"}]}]], "Output",
 CellChangeTimes->{3.99842064101728*^9, 3.9986452905166893`*^9, 
  3.9988529409922113`*^9},
