  3.998415959710104*^9, 3.998415960978478*^9}, {3.9984160399039097`*^9, 
  3.998416049398796*^9}},
 CellLabel->"In[116]:=",
 CellID->2060526713,ExpressionUUID->"de7b4382-81d9-43e5-ade4-a011859ec337"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"HBAR", " ", "THETA"}], ",", 
   RowBox[{
    RowBox[{"-", "HBAR"}], " ", 
    RowBox[{"Log", "[", "AMP", "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.998420643702259*^9, 3.998645845939166*^9, 
  3.998852943955607*^9},
 CellLabel->"Out[117]=",
 CellID->1386395939,ExpressionUUID->"ad04c45f-1ae3-4b05-aa34-b3bc03c12e39"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM4", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"RA", " ", ",", " ", "RX", ",", " ", "RP", ",", " ", 
