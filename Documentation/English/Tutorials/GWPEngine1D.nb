Cell[CellGroupData[{

Cell["\<\
Evaluate complex kinetic-potential energy cross-correlations (EKEPE) as \
continuous functions of time, including higher-order arbitrary cross-moments.\
\
\>", "MathCaption",
 CellID->694753999,ExpressionUUID->"d5c117f3-90c9-4499-8b1e-b4bd32f1fb19"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<EKEPE\>\"", "]"}], "[", "t", "]"}], " ", "//", 
  " ", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", 
    RowBox[{"\"\<EKEPE\>\"", ",", " ", "2", ",", " ", "1"}], "]"}], "[", "t", 
   "]"}], " ", "//", " ", "Simplify"}]}], "Input",
 CellLabel->"In[80]:=",
 CellID->861872454,ExpressionUUID->"5c32bd36-4a68-46d8-8502-72bad8a32ba9"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "64"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", "\[ImaginaryI]"}], "+", 
    RowBox[{"3", " ", 
     RowBox[{"Cos", "[", "t", "]"}], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"2", " ", "\[ImaginaryI]"}], "+", 
    RowBox[{"9", " ", 
     RowBox[{"Cos", "[", "t", "]"}], " ", 
     RowBox[{"Sin", "[", "t", "]"}]}]}], ")"}]}]], "Output",
