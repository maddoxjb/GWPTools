Cell[CellGroupData[{

Cell["Physical constants can be overridden globally via options.", \
"MathCaption",
 CellID->1133220518,ExpressionUUID->"ac2bfaa1-78ff-4b58-b3a9-8754277d08ea"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Options", "[", "GWP1DPARAM", "]"}], "\n", 
 RowBox[{"GWP1DPARAM", "[", 
  RowBox[{
   RowBox[{"RA", " ", "+", " ", 
    RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP", ",", 
   RowBox[{"RG", " ", "+", " ", 
    RowBox[{"I", "*", "IG"}]}], ",", " ", 
   RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}], ",", " ", 
   RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.998414642500008*^9, 3.998414644972872*^9}},
 CellLabel->"In[95]:=",
 CellID->4780783,ExpressionUUID->"1219885a-bf17-4977-bd4c-e5295f2db413"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"HBAR\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"MASS\"\>", "\[Rule]", "1"}]}], "}"}]], "Output",
 CellChangeTimes->{3.99842064299772*^9, 3.998645800230997*^9, 
  3.99885294314006*^9, 4.000412311189548*^9},
 CellLabel->"Out[95]=",
 CellID->1774829039,ExpressionUUID->"9d59240f-8f44-4656-88d0-aa015cda7292"],

Cell[BoxData[
 RowBox[{"Sequence", "[", 
  RowBox[{"RA", ",", "IA", ",", "RX", ",", "RP", ",", "RG", ",", "IG", ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox["IG", "HBAR"]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["2", "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], " ", 
    SuperscriptBox["RA", 
     RowBox[{"1", "/", "4"}]]}], ",", "HBAR", ",", "MASS", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "RA", ",", "IA", ",", "RX", ",", "0", ",", "RP", ",", "0", ",", "RG", ",",
      "IG"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.99842064299772*^9, 3.998645800230997*^9, 
  3.99885294314006*^9, 4.000412311190873*^9},
 CellLabel->"Out[96]=",
 CellID->1003801643,ExpressionUUID->"7532c26f-fb98-4333-9fba-7e0225b8ac6d"]
}, Open  ]]
}, Open  ]],

