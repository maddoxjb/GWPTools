 RowBox[{
  RowBox[{"OBJ1", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"RA", " ", "+", " ", 
      RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"OBJ2", " ", "=", " ", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"RA", " ", "+", " ", 
      RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<Free\>\""}]}], "]"}]}],
   ";"}]}], "Input",
 CellLabel->"In[55]:=",
 CellID->524171376,ExpressionUUID->"034a7dad-a42c-43e0-9642-54af61496f5a"]
}, Open  ]],

