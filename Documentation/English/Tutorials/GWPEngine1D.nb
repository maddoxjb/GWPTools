Cell[CellGroupData[{

Cell["\<\
GWP1DPARAM supports variable arity. Omitted parameter slots gracefully fall \
back to their standard 1D initial state defaults.\
\>", "MathCaption",
 CellID->679745895,ExpressionUUID->"10cc6357-d866-4254-8747-59667ca63c24"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GWP1DPARAM", "[", 
  RowBox[{
   RowBox[{"RA", " ", "+", " ", 
    RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP", ",", " ", 
   RowBox[{"RG", " ", "+", " ", 
    RowBox[{"I", "*", "IG"}]}]}], "]"}], "\n", 
 RowBox[{"GWP1DPARAM", "[", 
  RowBox[{
   RowBox[{"RA", " ", "+", " ", 
    RowBox[{"I", "*", "IA"}]}], ",", " ", "RX", ",", " ", "RP"}], "]"}], "\n", 
 RowBox[{"GWP1DPARAM", "[", 
  RowBox[{
   RowBox[{"RA", " ", "+", " ", 
    RowBox[{"I", "*", "IA"}]}], ",", " ", "RX"}], "]"}], "\n", 
 RowBox[{"GWP1DPARAM", "[", 
  RowBox[{"RA", " ", "+", " ", 
   RowBox[{"I", "*", "IA"}]}], "]"}], "\n", 
 RowBox[{"GWP1DPARAM", "[", "]"}]}], "Input",
 CellLabel->"In[90]:=",
