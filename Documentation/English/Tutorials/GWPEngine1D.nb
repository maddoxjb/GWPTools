Cell[BoxData[
 RowBox[{"Sequence", "[", 
  RowBox[{"RA", ",", "IA", ",", "RX", ",", "RP", ",", "RG", ",", "IG", ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox["IG", "HBAR"]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["2", "\[Pi]"], ")"}], 
     RowBox[{"1", "/", "4"}]], " ", 
    SuperscriptBox["RA", 
     RowBox[{"1", "/", "4"}]]}], ",", "HBAR", ",", "MASS", ",", 
   RowBox[{"{", 
    RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
    "RA", ",", "IA", ",", "RX", ",", "0", ",", "RP", ",", "0", ",", "RG", ",",
      "IG"}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{3.99842064299772*^9, 3.998645800230997*^9, 
  3.9988529431412573`*^9},
 CellLabel->"Out[96]=",
