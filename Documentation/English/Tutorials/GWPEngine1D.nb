Cell[CellGroupData[{

Cell["\<\
Define the wavepacket shape using the Covariance dictionary, then verify it \
by simplifying the resulting spatial uncertainty and cross-covariance against \
the generated assumptions.\
\>", "MathCaption",
 CellID->1927804386,ExpressionUUID->"be307a4c-78e4-47a5-95d6-201435d3b154"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Covariance\>\"", ",", " ", "UX", ",", " ", "COVXP"}], 
      "}"}], ",", " ", 
     RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"GWP1DRA", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DIA", "@", "PARAM"}]}], "}"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"GWP1DUX", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DASSUMPTIONS", "@", "PARAM"}]}], "]"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"GWP1DCOVXP", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DASSUMPTIONS", "@", "PARAM"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9984160075224648`*^9, 3.998416008347022*^9}},
 CellLabel->"In[103]:=",
 CellID->1522533213,ExpressionUUID->"e5037651-15ee-4fda-bec7-2549f54fdd00"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"4", " ", 
     SuperscriptBox["UX", "2"]}]], ",", 
   RowBox[{"-", 
    FractionBox["COVXP", 
     RowBox[{"2", " ", "HBAR", " ", 
      SuperscriptBox["UX", "2"]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{3.998420643583823*^9, 3.998645832704093*^9, 
  3.9988529437662287`*^9},
 CellLabel->"Out[104]=",
 CellID->1638846617,ExpressionUUID->"fb70c68b-bf41-46f1-a471-b40dbadd783f"],

Cell[BoxData["UX"], "Output",
 CellChangeTimes->{3.998420643583823*^9, 3.998645832704093*^9, 
  3.998852943767399*^9},
 CellLabel->"Out[105]=",
 CellID->469835497,ExpressionUUID->"43d76693-f4e5-4b5b-9221-76f8e767ea8a"],

Cell[BoxData["COVXP"], "Output",
 CellChangeTimes->{3.998420643583823*^9, 3.998645832704093*^9, 
  3.99885294376823*^9},
 CellLabel->"Out[106]=",
 CellID->227828060,ExpressionUUID->"0a9b828d-dbb3-4229-bb17-653594d8cff2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Alternatively, define the shape using the Uncertainty dictionary and an \
optional correlation coefficient.\
\>", "MathCaption",
 CellID->1948056886,ExpressionUUID->"6c196eb9-b346-43eb-9b4b-dbeefe873b62"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Uncertainty\>\"", ",", " ", "UX", ",", " ", "UP", ",", " ",
        "1"}], "}"}], ",", " ", 
     RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"GWP1DRA", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DIA", "@", "PARAM"}]}], "}"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"GWP1DUX", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DASSUMPTIONS", "@", "PARAM"}]}], "]"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"GWP1DUP", "@", "PARAM"}], ",", " ", 
   RowBox[{"GWP1DASSUMPTIONS", "@", "PARAM"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.998415995573279*^9, 3.998415997826663*^9}},
 CellLabel->"In[107]:=",
 CellID->456400840,ExpressionUUID->"12476abd-ffcf-466e-89e3-418c4d2e5c80"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"4", " ", 
     SuperscriptBox["UX", "2"]}]], ",", 
   FractionBox[
    SqrtBox[
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox["UP", "2"], " ", 
        SuperscriptBox["UX", "2"]}], 
       SuperscriptBox["HBAR", "2"]]}]], 
    RowBox[{"4", " ", 
     SuperscriptBox["UX", "2"]}]]}], "}"}]], "Output",
 CellChangeTimes->{3.998420643605564*^9, 3.9986458359780197`*^9, 
  3.998852943834958*^9},
 CellLabel->"Out[108]=",
 CellID->142861819,ExpressionUUID->"9a05fdd7-ab61-4884-ad7e-727f715eb04a"],

Cell[BoxData["UX"], "Output",
 CellChangeTimes->{3.998420643605564*^9, 3.9986458359780197`*^9, 
  3.998852943850613*^9},
 CellLabel->"Out[109]=",
 CellID->191874587,ExpressionUUID->"610777b9-f8ee-45ee-b383-1e84236f0456"],

Cell[BoxData["UP"], "Output",
 CellChangeTimes->{3.998420643605564*^9, 3.9986458359780197`*^9, 
  3.9988529438516912`*^9},
 CellLabel->"Out[110]=",
 CellID->1463229562,ExpressionUUID->"52f1a61c-301c-4a72-980a-05ab64740337"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Define the momentum center by specifying a target classical Kinetic Energy.\
\>", "MathCaption",
 CellID->2064814443,ExpressionUUID->"c84eea61-66e5-40b3-9195-e423bf79e71d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GWP1DRP", "@", 
  RowBox[{"GWP1DPARAM", "[", 
   RowBox[{
    RowBox[{"1", "/", "4"}], ",", " ", "0", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<KineticEnergy\>\"", ",", " ", "KE", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}], ",", " ", 
    RowBox[{"\"\<MASS\>\"", " ", "->", " ", "MASS"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.998415985156928*^9, 3.998415987493312*^9}},
 CellLabel->"In[111]:=",
 CellID->607981,ExpressionUUID->"c016c1d9-2385-42ac-843a-67b8d369690c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   SqrtBox["2"]}], " ", 
  SqrtBox[
   RowBox[{"KE", " ", "MASS"}]]}]], "Output",
 CellChangeTimes->{3.9984206436313467`*^9, 3.998645838838725*^9, 
  3.998852943880206*^9},
 CellLabel->"Out[111]=",
 CellID->1664006737,ExpressionUUID->"84bd82f0-2eda-4df5-a72a-b1f01b9a3e7b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The global phase parameter supports a wide variety of specialized dictionary \
injections (Action, Displacement, Coefficient, Evolution).\
\>", "MathCaption",
 CellID->1628402079,ExpressionUUID->"ecbd13c6-22ce-4130-9593-532bcdc93c0d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM1", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Action\>\"", ",", " ", "S", ",", " ", "MU"}], "}"}], ",", 
     " ", 
     RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Through", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"GWP1DRG", ",", " ", "GWP1DIG"}], "}"}], "[", "PARAM1", "]"}], 
   "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.998415034928001*^9, 3.9984150393448*^9}, {
   3.998415100846837*^9, 3.998415128981728*^9}, {3.998415168180501*^9, 
   3.998415175562669*^9}, 3.9984152143495913`*^9, {3.99841525284694*^9, 
   3.9984152539120913`*^9}, {3.998415929995379*^9, 3.998415950475919*^9}},
 CellLabel->"In[112]:=",
 CellID->1022144385,ExpressionUUID->"da499f71-d0a1-43a5-bb5d-5578658a48a1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "HBAR", " ", "MU", " ", "\[Pi]"}], "+", 
    "S"}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], " ", "HBAR", " ", 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"2", " ", "RA"}], "\[Pi]"], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.9984206436583443`*^9, 3.998645842259129*^9, 
  3.99885294390587*^9},
 CellLabel->"Out[113]=",
 CellID->281693878,ExpressionUUID->"dc258904-2165-4c1e-aeed-ecd911ea9ece"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM2", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Displacement\>\"", ",", " ", "X0", ",", " ", "P0"}], "}"}],
      ",", " ", 
     RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Through", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"GWP1DRG", ",", " ", "GWP1DIG"}], "}"}], "[", "PARAM2", "]"}], 
   "]"}], " "}]}], "Input",
 CellChangeTimes->{{3.998415189607798*^9, 3.998415218372554*^9}, {
  3.998415935932138*^9, 3.9984159556545057`*^9}},
 CellLabel->"In[114]:=",
 CellID->1698057948,ExpressionUUID->"962482ff-a0af-4711-bd24-b55d39aae7e1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "P0"}], "+", "RP"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"RX", "-", "X0"}], ")"}]}], ",", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", "4"]}], " ", "HBAR", " ", 
    RowBox[{"Log", "[", 
     FractionBox[
      RowBox[{"2", " ", "RA"}], "\[Pi]"], "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.998420643677361*^9, 3.9986458441103773`*^9, 
  3.998852943932579*^9},
 CellLabel->"Out[115]=",
 CellID->1375049558,ExpressionUUID->"818cb254-7f37-45d2-96fb-1e788d311d58"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"PARAM3", " ", "=", " ", 
   RowBox[{"GWP1DPARAM", "[", 
    RowBox[{"RA", ",", " ", "RX", ",", " ", "RP", ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Coefficient\>\"", ",", " ", "THETA", ",", " ", "AMP"}], 
      "}"}], ",", " ", 
     RowBox[{"\"\<HBAR\>\"", " ", "->", " ", "HBAR"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Through", "[", 
