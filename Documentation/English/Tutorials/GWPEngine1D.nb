   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{"\"\<Potential\>\"", " ", "->", " ", "\"\<HO\>\""}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[40]:=",
 CellID->294774554,ExpressionUUID->"61ebebbc-8a06-4c98-b1da-6ded8bc623e6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Evaluate the position-space probability density (RHOX) and its first spatial \
derivative using the integer order argument.\
\>", "MathCaption",
 CellID->31155449,ExpressionUUID->"0698f87a-1ec0-4600-af88-b37d9714a440"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"OBJ1", "[", "\"\<RHOX\>\"", "]"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", "\"\<RHOX\>\"", "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}], "\n", 
 RowBox[{
  RowBox[{"OBJ1", "[", 
   RowBox[{"\"\<RHOX\>\"", ",", " ", "1"}], "]"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"OBJ2", "[", 
    RowBox[{"\"\<RHOX\>\"", ",", " ", "1"}], "]"}], "[", 
   RowBox[{"x", ",", " ", "t"}], "]"}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998413427676793*^9, 3.998413437057023*^9}},
 CellLabel->"In[42]:=",
 CellID->1791105122,ExpressionUUID->"78b969b3-2539-48f2-bd9e-094d1a1e840e"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["x", "2"], "2"]}]], 
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]]]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941656831*^9, 4.000412309685183*^9},
 CellLabel->"Out[42]=",
 CellID->118203166,ExpressionUUID->"0249d8c0-fcd3-45ac-b600-7b2b857111f8"],

Cell[BoxData[
 RowBox[{"2", " ", 
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", 
      SuperscriptBox["x", "2"]}], 
     RowBox[{"5", "+", 
      RowBox[{"3", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", "t"}], "]"}]}]}]]}]], " ", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{
     RowBox[{"5", " ", "\[Pi]"}], "+", 
     RowBox[{"3", " ", "\[Pi]", " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"2", " ", "t"}], "]"}]}]}]]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941656831*^9, 4.000412309710245*^9},
 CellLabel->"Out[43]=",
 CellID->218237487,ExpressionUUID->"d269de40-c7e5-41ac-883a-e55552beb451"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], "2"]}]], " ", "x"}], 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941656831*^9, 4.000412309711598*^9},
 CellLabel->"Out[44]=",
 CellID->15374933,ExpressionUUID->"a0631ade-a2d3-4a74-be67-9d2cfbb3c110"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"16", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"4", " ", 
        SuperscriptBox["x", "2"]}], 
       RowBox[{"5", "+", 
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "t"}], "]"}]}]}]]}]], " ", "x", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"5", "+", 
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "t"}], "]"}]}]}]], ")"}], 
     RowBox[{"3", "/", "2"}]]}], 
   SqrtBox["\[Pi]"]]}]], "Output",
 CellChangeTimes->{3.99842064153517*^9, 3.9986454918548193`*^9, 
  3.998852941656831*^9, 4.0004123097163553`*^9},
 CellLabel->"Out[45]=",
 CellID->708461291,ExpressionUUID->"4882e455-e31a-43d0-98ee-21de5e0337d5"]
}, Open  ]]
}, Open  ]],

