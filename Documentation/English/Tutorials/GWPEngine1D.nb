Cell[CellGroupData[{

Cell["Mathematical Definitions", "Section",
 CellChangeTimes->{{3.998329906301896*^9, 3.998329910548485*^9}},
 CellID->1915346704,ExpressionUUID->"5386336e-c61b-45c5-bde5-eaf46c9427d2"],

Cell[CellGroupData[{

Cell["GWP Definition and the 4-8-6 Model", "Subsection",
 CellChangeTimes->{{3.998825563968564*^9, 3.99882557614466*^9}, {
  3.9988437321900806`*^9, 3.9988437422846813`*^9}},
 CellID->210064920,ExpressionUUID->"65ffa435-128a-408a-9906-5a878fc31393"],

Cell[TextData[{
 "The notation and parameterization utilized throughout the GWPTools \
framework are based strictly on the formalism presented in Chapter 3 of David \
Tannor's ",
 StyleBox["Introduction to Quantum Mechanics: A Time-Dependent Perspective",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellID->317772612,ExpressionUUID->"fbac3c7f-dd1f-404d-85ac-84567087cf37"],

Cell[CellGroupData[{

Cell["\<\
The mathematical form of a generalized, complex-valued Gaussian wavepacket in \
one spatial dimension is defined as:\
\>", "Text",
 CellID->12459795,ExpressionUUID->"0ffb7e08-5adb-428d-92c7-2759d55536c5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", "x", ")"}], "\[Proportional]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      SuperscriptBox[
       RowBox[{
        SuperscriptBox["\[Alpha]", "\[Prime]"], "(", 
        RowBox[{"x", "-", 
         SuperscriptBox["x", "\[Prime]"]}], ")"}], "2"]}], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], " ", 
      RowBox[{
       SuperscriptBox["p", "\[Prime]"], "(", 
       RowBox[{"x", "-", 
        SuperscriptBox["x", "\[Prime]"]}], ")"}]}], "+", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "\[HBar]"], " ", 
      SuperscriptBox["\[Gamma]", "\[Prime]"]}]}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998824990424766*^9, 3.998825044480611*^9}},
 FontSize->16,
 CellID->1159832385,ExpressionUUID->"5d7d0e94-b760-4eef-89a2-9aba1838e6a3"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["x", "TI"], TraditionalForm], "errors" -> {}, "input" -> "x", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "34b2397b-6057-4f2a-accc-41e780bfbe80"],
 " is the spatial coordinate, \[HBar] is the reduced Planck constant, and the \
four single-primed parameters (",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Alpha]", "\[Prime]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha^{\\prime}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6fc11547-5291-413b-97c1-4932f51b6416"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["x", "TI"], "\[Prime]"], TraditionalForm], "errors" -> {}, 
     "input" -> "x^{\\prime}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "11c1a930-2e46-4cf3-a3d1-f7f71d43063d"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox[
        StyleBox["p", "TI"], "\[Prime]"], TraditionalForm], "errors" -> {}, 
     "input" -> "p^{\\prime}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0fd1eeab-f0aa-4410-803a-2bb454943333"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SuperscriptBox["\[Gamma]", "\[Prime]"], TraditionalForm], 
     "errors" -> {}, "input" -> "\\gamma^{\\prime}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f5bc828b-52de-434a-9e8f-ecf847c3e5d0"],
 ") are complex-valued quantities. To represent a physical state, the \
normalization condition requires that ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Re", 
         RowBox[{"(", 
           SuperscriptBox["\[Alpha]", "\[Prime]"], ")"}], ">", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\text{Re}(\\alpha^{\\prime}) > 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "62bf43fa-da2c-4477-a732-0623aad74f3c"],
 ". Because each of the four parameters contains a real and imaginary \
component, up to eight real-valued numbers are required to uniquely specify \
this generalized wavefunction. "
}], "Text",
 CellChangeTimes->{{3.998825070716321*^9, 3.9988251801538553`*^9}, {
  3.998843538745626*^9, 3.9988435439171124`*^9}},
 CellID->1137541171,ExpressionUUID->"df69868a-6c4b-46fa-bb8c-0e3213d99899"],

Cell[CellGroupData[{

Cell["\<\
However, to ground the wavepacket in classical observables, Tannor's \
formalism rearranges the terms in the complex exponent. This algebraic \
rearrangement transforms the four single-primed parameters into a strictly \
real-centered representation (referred to as the double-primed parameters in \
Tannor's text), which GWPTools adopts as its standard time-dependent \
parameterization:\
\>", "Text",
 CellChangeTimes->{3.998843952125848*^9},
 CellID->184460367,ExpressionUUID->"25256363-a378-42f8-b19d-ff6e588b9d20"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalPsi]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{"N", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox[
        RowBox[{
         SubscriptBox["\[Alpha]", "t"], "(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], " ", 
       RowBox[{
        SubscriptBox["p", "t"], "(", 
        RowBox[{"x", "-", 
         SubscriptBox["x", "t"]}], ")"}]}], "+", 
      RowBox[{
       FractionBox["\[ImaginaryI]", "\[HBar]"], " ", 
       SubscriptBox["\[Gamma]", "t"]}]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->841612982,ExpressionUUID->"b5f8660f-992e-4b72-bcb4-5b994dffb0e7"]
}, Open  ]],

Cell[TextData[{
 "In this standard representation, the coordinate centers ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["x", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "x_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cbf35a31-e6e7-4b4d-8f0f-a0c8b6f8fccd"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["p", "TI"], 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "p_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9a4b6e5e-86a9-420e-8f5b-a6f0b40891fb"],
 " are strictly real-valued quantities, representing the exact center-of-mass \
position and momentum expectation values. This transformation is the \
mathematical basis of the backend's internal 4-8-6 model: four complex-valued \
input parameters are equivalent to eight real-valued parameters, which are \
always algebraically rearranged to yield a final set of six real-valued \
initial parameters used by the engine."
}], "Text",
 CellChangeTimes->{{3.998825244900981*^9, 3.9988252737038717`*^9}, {
  3.998825421991647*^9, 3.998825422820491*^9}, {3.998843969607523*^9, 
  3.998843996615367*^9}},
 CellID->172826165,ExpressionUUID->"66f6dc82-b91c-4e29-a5e4-8181501c7e35"],

Cell[TextData[{
 "The complex shape parameter, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Alpha]", 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\alpha_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "136028f9-5cf0-4ed1-976d-b0070590ccdf"],
 ", completely characterizes the phase-space uncertainty bounds of the state. \
Its real part, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", 
          StyleBox["t", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\text{Re}(\\alpha_t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b20f80c1-d256-468c-a5a2-84dcad1fdaac"],
 ", governs the spatial variance, while its imaginary part, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"Im", "(", 
         SubscriptBox["\[Alpha]", 
          StyleBox["t", "TI"]], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\text{Im}(\\alpha_t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b8a1cecb-6f6f-45f7-acaa-0fca2230827f"],
 ", dictates the position-momentum correlation, commonly referred to as the \
momentum \"chirp.\" Similarly, the complex phase parameter, ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Gamma]", 
        StyleBox["t", "TI"]], TraditionalForm], "errors" -> {}, "input" -> 
     "\\gamma_t", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cdd137fa-a81e-49e2-8e57-9ad1b8dd0d5a"],
 ", captures the global phase evolution. Its real component accumulates both \
the classical action and the quantum phase shift induced by wavepacket \
spreading, while its imaginary component ensures proper time-dependent \
normalization."
}], "Text",
 CellChangeTimes->{{3.998825244900981*^9, 3.9988252737038717`*^9}, {
  3.998825421991647*^9, 3.998825476233966*^9}, {3.9988440256834097`*^9, 
  3.9988440572733593`*^9}},
 CellID->1886702625,ExpressionUUID->"a140a69a-d488-4d5d-86f1-efb58d04d337"],

Cell[CellGroupData[{

Cell[TextData[{
 "The normalization constant ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["N", "TI"], TraditionalForm], "errors" -> {}, "input" -> "N", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7d9e04d7-3410-4f22-9e96-752a1115bc42"],
 " is purely real-valued and independent of time for quadratic systems, given \
by:"
}], "Text",
 CellChangeTimes->{
  3.9988252949386387`*^9, {3.998825508472007*^9, 3.9988255125277452`*^9}},
 CellID->2008084127,ExpressionUUID->"fe601f3c-d396-4c67-b15f-4c3f00ac28e6"],

Cell[BoxData[
 FormBox[
  RowBox[{"N", " ", "=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       FractionBox["2", "\[Pi]"], 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "0"], ")"}]}], ")"}], 
     RowBox[{"1", "/", "4"}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      FractionBox["1", "\[HBar]"], 
      RowBox[{"Im", "(", 
       SubscriptBox["\[Gamma]", "0"], ")"}]}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998824990424766*^9, 3.998825044480611*^9}, {
  3.9988252078019867`*^9, 3.998825224201375*^9}, {3.998825304894185*^9, 
  3.998825337866495*^9}, {3.99884407154426*^9, 3.998844078154746*^9}},
 FontSize->16,
 CellID->1667664980,ExpressionUUID->"b4796736-5401-4ece-b4e6-27bc345a3c94"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The position-space probability density is another important function for \
evaluating many properties and expectation values. For the GWP, it is \
analytically defined as:\
\>", "Text",
 CellChangeTimes->{{3.998338828827935*^9, 3.998338838784667*^9}, {
  3.998347279096631*^9, 3.998347283974255*^9}, {3.998392971114134*^9, 
  3.998392972658394*^9}, {3.998406231862256*^9, 3.9984062998538437`*^9}, {
  3.9984065126103487`*^9, 3.998406515724099*^9}, {3.9984067869686003`*^9, 
  3.998406788135738*^9}, {3.99841177728576*^9, 3.998411777650566*^9}, {
  3.9988441149138823`*^9, 3.9988441187107897`*^9}},
 CellID->1554846349,ExpressionUUID->"3c2673f8-7b9c-4dfb-8b1c-c21c7a43ebd0"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalPsi]", "*"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[CapitalPsi]", "(", 
      RowBox[{"x", ",", "t"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"2", 
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}]}], "\[Pi]"], ")"}], 
      RowBox[{"1", "/", "2"}]], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "2"}], 
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}], "2"]}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1721570947,ExpressionUUID->"e1f1cc4f-9968-4159-8e92-03ce5da8fee8"]
}, Open  ]],

Cell["\<\
A key architectural feature is that the backend code uses explicit real and \
imaginary components for the shape and phase parameters. This enables the use \
of Re and Im alongside ComplexExpand to directly generate and optimize usable \
backend code from the symbolic expressions.\
\>", "Text",
 CellChangeTimes->{{3.998346348449411*^9, 3.998346605993368*^9}, {
   3.998392711880851*^9, 3.998392788266715*^9}, {3.9983928533651457`*^9, 
   3.998392893246038*^9}, {3.998396957462533*^9, 3.9983969609221563`*^9}, {
   3.9983969975237217`*^9, 3.998397020279395*^9}, {3.998406808720744*^9, 
   3.998406815332687*^9}, {3.998410678509207*^9, 3.9984106809463263`*^9}, {
   3.998411797290608*^9, 3.998411818953887*^9}, 3.998844133006401*^9},
 CellID->1966295953,ExpressionUUID->"73977177-2a5a-4f63-896d-faf0c8e82033"]
}, Open  ]],

Cell[CellGroupData[{

Cell["GWP Parameter Equations of Motion", "Subsection",
 CellChangeTimes->{{3.9983299248606443`*^9, 3.9983299392262573`*^9}},
 CellID->1057590957,ExpressionUUID->"e469e2ce-25e9-4f97-96da-9282ac00c797"],

Cell[CellGroupData[{

Cell["\<\
It is well known that GWPs constitute a class of exact solutions to the \
time-dependent Schrodinger equation (TDSE) for systems where the external \
potential energy field is at most a quadratic function of position.  This \
section describes the GWP solutions for a 1D system where the potential \
energy field has the form\
\>", "Text",
 CellChangeTimes->{{3.99832841693686*^9, 3.998328516787511*^9}, {
  3.998329612472973*^9, 3.998329612643766*^9}, {3.998336568262389*^9, 
  3.998336575462152*^9}, {3.9983366452401533`*^9, 3.99833664671786*^9}, {
  3.998336714413281*^9, 3.998336767366806*^9}, {3.998337373626994*^9, 
  3.998337419890806*^9}, {3.998393322519003*^9, 3.998393328631262*^9}},
 CellID->209068080,ExpressionUUID->"b37092e1-233a-483b-bf65-81640fdfa7ca"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"V", "(", 
    RowBox[{"x", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["V", "0"], "(", "t", ")"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "1"], "(", "t", ")"}], " ", "x"}], "+", 
    RowBox[{
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}], 
     SuperscriptBox["x", "2"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->523974068,ExpressionUUID->"becedc91-4e59-4971-bba1-1d32740181b2"]
}, Open  ]],

Cell[TextData[{
 "The coefficients here may be constants or specific combinations of \
time-dependent functions that are presented later in this subsection.  Note \
that GWPEngine1D currently supports ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "=", "constant"}], TraditionalForm]],
  ExpressionUUID->"9b34bec5-b842-4d36-96ca-debbd40bd41d"],
 " and a few cases where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "1"], "(", "t", ")"}], TraditionalForm]],ExpressionUUID->
  "8f345ac7-5005-40c7-8100-4d5b6cd64cc3"],
 " is a constant or a linear or sinusoidal function of time."
}], "Text",
 CellChangeTimes->{{3.998329735546442*^9, 3.998329762241344*^9}, {
  3.998336593392288*^9, 3.99833670268996*^9}, {3.998336770152832*^9, 
  3.998336793748958*^9}, {3.99833743045947*^9, 3.9983374876745853`*^9}, {
  3.998393455248015*^9, 3.9983934582447166`*^9}, {3.998397588058899*^9, 
  3.9983976997015333`*^9}, {3.9983977522226877`*^9, 3.998397888989565*^9}, {
  3.998410842693637*^9, 3.998410867443191*^9}, {3.998410940399416*^9, 
  3.998410953128457*^9}},
 CellID->1749208176,ExpressionUUID->"e23b1cb6-e07c-490f-9816-777f44a38c66"],

Cell[CellGroupData[{

Cell[TextData[{
 "Substituting the GWP form into the TDSE and using a Taylor series expansion \
of the quadratic potential about ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "2cc177e2-4013-4b2b-b0e7-304499180665"],
 " (which is exact in this case) leads to the following equations of motion \
for the GWP parameters"
}], "Text",
 CellChangeTimes->{{3.9983285569087563`*^9, 3.9983286653432703`*^9}, {
   3.99832988783654*^9, 3.9983298909639683`*^9}, {3.998337508771267*^9, 
   3.9983375279865*^9}, {3.9983932284679747`*^9, 3.9983932463220253`*^9}, {
   3.998393315872039*^9, 3.998393316939567*^9}, {3.9983934668081837`*^9, 
   3.99839346886273*^9}, 3.998410981500271*^9},
 CellID->2038170249,ExpressionUUID->"f06e73f6-3011-4c2e-a7ed-f9ea5c5fd5ab"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[Alpha]", "."], "t"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       RowBox[{"2", " ", "\[ImaginaryI]", " ", "\[HBar]"}], "m"]}], 
     SubsuperscriptBox["\[Alpha]", "t", "2"]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     RowBox[{
      SubscriptBox["V", "2"], "(", "t", ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1015721646,ExpressionUUID->"071d225d-b682-45d2-a72e-40b1b988f12f"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["x", "."], "t"], "=", 
   FractionBox[
    SubscriptBox["p", "t"], "m"]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->886194319,ExpressionUUID->"456e9c01-9390-4359-a542-b71ad39f77f2"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["p", "."], "t"], "=", 
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["V", "1"], "(", "t", ")"}], " ", "+", 
      RowBox[{"2", 
       RowBox[{
        SubscriptBox["V", "2"], "(", "t", ")"}], 
       SubscriptBox["x", "t"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1468827488,ExpressionUUID->"ec683575-88c8-46ed-90cf-0d4aeaaddaac"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox[
    OverscriptBox["\[Gamma]", "."], "t"], "=", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["p", "t", "2"], 
     RowBox[{"2", "m"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["V", "0"], "(", "t", ")"}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "1"], "(", "t", ")"}], " ", 
       SubscriptBox["x", "t"]}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "2"], "(", "t", ")"}], 
       SubsuperscriptBox["x", "t", "2"]}]}], ")"}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     SubscriptBox["\[Alpha]", "t"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1259068551,ExpressionUUID->"b22fdb07-c4c9-49d6-b25b-e54b12f3baf0"]
}, Open  ]],

Cell[TextData[{
 "These are typically solved by first integrating the classical equations of \
motion to find ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "042bfe1a-9cb4-456b-bdcc-90315f700dd9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],ExpressionUUID->
  "7be0fa7a-dd94-4a0a-95da-1ffb99883697"],
 ", which is straightforward when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["V", "2"], "=", "constant"}], TraditionalForm]],
  ExpressionUUID->"94ed647a-0189-497a-80f0-df8adab5333f"],
 ".  Likewise, the equation of motion for the shape parameter can be directly \
integrated to find ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],ExpressionUUID->
  "86dde929-3e58-433e-aed6-de11eac5ecc2"],
 ".  Given ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
  "d65a4347-05a7-435a-bb02-43614cfe1824"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]],ExpressionUUID->
  "ccae475b-871f-460a-81a8-202bb57bc467"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]],ExpressionUUID->
  "74f7d162-dd4d-4bd5-8822-0149aba4075c"],
 ", the phase equation of motion can be solved for ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
  "b8626b34-df7a-4655-aba0-9ac065a388c3"],
 ".  "
}], "Text",
 CellChangeTimes->{{3.965379743534963*^9, 3.965379772600212*^9}, {
   3.965379873627339*^9, 3.965379994520755*^9}, {3.969717057960471*^9, 
   3.969717063404645*^9}, {3.970612469899426*^9, 3.970612489287705*^9}, {
   3.970612913481023*^9, 3.970612943281715*^9}, {3.970612980409542*^9, 
   3.970613055846562*^9}, {3.970744044139468*^9, 3.970744044973205*^9}, {
   3.970746565625165*^9, 3.9707466013482523`*^9}, {3.97074669299419*^9, 
   3.9707467309452744`*^9}, {3.9709652601808023`*^9, 3.970965282633312*^9}, {
   3.998336895791367*^9, 3.998336899168684*^9}, {3.998393493363606*^9, 
   3.9983935093012877`*^9}, {3.99839792534305*^9, 3.99839792889987*^9}, {
   3.9984110029861717`*^9, 3.998411038188634*^9}, 3.998411936917226*^9},
 CellID->2008762766,ExpressionUUID->"0157f346-8bbb-41a1-b956-7a4c914eee8b"],

Cell[CellGroupData[{

Cell["The solution to the phase equation has the form", "Text",
 CellChangeTimes->{{3.965379997145198*^9, 3.965380016859344*^9}, {
  3.97074406567274*^9, 3.970744066972314*^9}, {3.97102177913212*^9, 
  3.971021779383478*^9}},
 CellID->685393675,ExpressionUUID->"5bf3c6f3-2d6a-4934-a0c3-c00fb9ec2f97"],

Cell[BoxData[
 FormBox[
  RowBox[{
   SubscriptBox["\[Gamma]", "t"], "=", 
   RowBox[{
    SubscriptBox["\[Gamma]", "0"], "+", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "t"], 
     RowBox[{
      RowBox[{
       SubscriptBox["L", "class"], "(", 
       SuperscriptBox["t", "\[Prime]"], ")"}], 
      RowBox[{"\[DifferentialD]", 
       SuperscriptBox["t", "\[Prime]"]}]}]}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       SubscriptBox["\[Alpha]", 
        SuperscriptBox["t", "\[Prime]"]], 
       RowBox[{"\[DifferentialD]", 
        SuperscriptBox["t", "\[Prime]"]}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->309213217,ExpressionUUID->"4fae81d3-36ed-4e7b-b270-cd87f51e1044"]
}, Open  ]],

Cell[CellGroupData[{

Cell["where", "Text",
 CellChangeTimes->{{3.965380086469627*^9, 3.965380087880727*^9}},
 CellID->36112379,ExpressionUUID->"dbb05ca4-4bf5-4bf8-a992-b847cb6b0b66"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["L", "class"], "(", "t", ")"}], "=", 
   RowBox[{
    FractionBox[
     SubsuperscriptBox["p", "t", "2"], 
     RowBox[{"2", "m"}]], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SubscriptBox["V", "0"], "(", "t", ")"}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "1"], "(", "t", ")"}], " ", 
       SubscriptBox["x", "t"]}], "+", 
      RowBox[{
       RowBox[{
        SubscriptBox["V", "2"], "(", "t", ")"}], 
       SubsuperscriptBox["x", "t", "2"]}]}], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{3.9984111025721693`*^9},
 FontSize->16,
 CellID->1350365399,ExpressionUUID->"8a083428-2707-4c0a-a61a-a5ce7264a44a"]
}, Open  ]],

Cell["is the classical Lagrangian.", "Text",
 CellChangeTimes->{{3.965380106718552*^9, 3.965380115341385*^9}},
 CellID->984079497,ExpressionUUID->"3724b86d-7f95-4a75-bee6-9fbf51c1b066"],

Cell[CellGroupData[{

Cell["\<\
It is helpful to develop separate expressions for the real and imaginary \
parts of the shape and phase parameters.  The real and imaginary parts of the \
phase parameter are given by\
\>", "Text",
 CellChangeTimes->{{3.965380247610021*^9, 3.96538029134823*^9}, {
  3.965380351543791*^9, 3.96538039021119*^9}, {3.9697171194901733`*^9, 
  3.9697171669263783`*^9}, {3.9709653160647693`*^9, 3.970965345905987*^9}, {
  3.970996949655693*^9, 3.970997004031073*^9}},
 CellID->1652540532,ExpressionUUID->"ff903c1f-90f0-4bdd-a659-ff36e07d627e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Re", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Re", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "+", 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "t"], 
     RowBox[{
      RowBox[{
       SubscriptBox["L", "class"], "(", "t", ")"}], 
      RowBox[{"\[DifferentialD]", "t"}]}]}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"Re", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"\[DifferentialD]", "t"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->842714673,ExpressionUUID->"c3eb8711-3c2e-4e4a-b5a2-23060a70849b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Im", "(", 
    SubscriptBox["\[Gamma]", "t"], ")"}], "=", 
   RowBox[{
    RowBox[{"Im", "(", 
     SubscriptBox["\[Gamma]", "0"], ")"}], "-", 
    RowBox[{
     FractionBox[
      SuperscriptBox["\[HBar]", "2"], "m"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", "0", "t"], 
      RowBox[{
       RowBox[{"Im", "(", 
        SubscriptBox["\[Alpha]", "t"], ")"}], 
       RowBox[{"\[DifferentialD]", "t"}]}]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->850857146,ExpressionUUID->"955bb95e-ac09-4223-9a47-fd931ac71db4"]
}, Open  ]],

Cell["\<\
where it is worth noting that the time integral of the Lagrangian (i.e., the \
classical action integral) is real-valued and only enters into the real part \
of the phase parameter.\
\>", "Text",
 CellChangeTimes->{{3.970965350900128*^9, 3.970965414834233*^9}, {
  3.970997022995678*^9, 3.970997050662051*^9}, {3.9983935732612133`*^9, 
  3.998393574506856*^9}},
 CellID->262447449,ExpressionUUID->"842a0003-2308-4135-b283-c557729f1105"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Momentum-Space Definition", "Subsection",
 CellChangeTimes->{{3.9983482331521187`*^9, 3.998348247359911*^9}},
 CellID->1802238757,ExpressionUUID->"ed12ca5d-e67d-4d54-bb4b-e50bd1a7b689"],

Cell[CellGroupData[{

Cell["\<\
The momentum-space representation of a GWP wavefunction is also a Gaussian \
function and involves the same parameters described above for the \
position-space wavefunction.\
\>", "Text",
 CellChangeTimes->{{3.608387854933778*^9, 3.608387886059922*^9}, {
   3.608388780798854*^9, 3.608388791150051*^9}, 3.609780787372626*^9, {
   3.961878855586652*^9, 3.9618788589717712`*^9}, 3.96212794385641*^9, {
   3.969461092547219*^9, 3.969461093144919*^9}, {3.969703036301978*^9, 
   3.9697030442986937`*^9}, {3.9983984256286783`*^9, 
   3.9983984264057903`*^9}, {3.998406985565024*^9, 3.998407002775652*^9}},
 CellID->2117431611,ExpressionUUID->"c5ae7a34-5935-4a08-b6b2-488004231cc5"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[CapitalPsi]", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      SqrtBox[
       RowBox[{"2", "\[Pi]", " ", "\[HBar]"}]]], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
      RowBox[{
       RowBox[{"\[CapitalPsi]", "(", 
        RowBox[{"x", ",", "t"}], ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", "\[HBar]"]}], " ", "p", " ", "x"}]], 
       RowBox[{"\[DifferentialD]", "x"}]}]}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{"2", " ", "\[HBar]", " ", 
         SubscriptBox["\[Alpha]", "t"]}]], ")"}], 
      RowBox[{"1", "/", "2"}]], "N", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p", "-", 
            SubscriptBox["p", "t"]}], ")"}], "2"], 
         RowBox[{"4", 
          SuperscriptBox["\[HBar]", "2"], 
          SubscriptBox["\[Alpha]", "t"], " "}]]}], "-", 
       RowBox[{
        FractionBox["\[ImaginaryI]", "\[HBar]"], " ", "p", " ", 
        SubscriptBox["x", "t"]}], "+", 
       RowBox[{
        FractionBox["\[ImaginaryI]", "\[HBar]"], 
        SubscriptBox["\[Gamma]", "t"], " "}]}]]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1721571640,ExpressionUUID->"e05ba302-1d45-4e93-a78a-123d9c398bc3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
The momentum-space probability density is similarly defined as\
\>", "Text",
 CellChangeTimes->{{3.9983388221708*^9, 3.998338825352097*^9}, {
  3.9983467137732*^9, 3.99834673026158*^9}, {3.998393934443863*^9, 
  3.9983939501083717`*^9}},
 CellID->1395730198,ExpressionUUID->"45473225-15c0-495e-b84e-28a0e8786d5b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    OverscriptBox["\[Rho]", "~"], "(", 
    RowBox[{"p", ",", "t"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox[
       OverscriptBox["\[CapitalPsi]", "~"], "*"], "(", 
      RowBox[{"p", ",", "t"}], ")"}], 
     RowBox[{
      OverscriptBox["\[CapitalPsi]", "~"], "(", 
      RowBox[{"p", ",", "t"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       FractionBox[
        RowBox[{"Re", "(", 
         SubscriptBox["\[Alpha]", "t"], ")"}], 
        RowBox[{
         RowBox[{"2", "\[Pi]", " ", 
          SuperscriptBox["\[HBar]", "2"]}], "|", 
         SubscriptBox["\[Alpha]", "t"], 
         SuperscriptBox["|", "2"]}]], ")"}], 
      RowBox[{"1", "/", "2"}]], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"Re", "(", 
          SubscriptBox["\[Alpha]", "t"], ")"}], 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p", "-", 
            SubscriptBox["p", "t"]}], ")"}], "2"]}], 
        RowBox[{
         RowBox[{"2", 
          SuperscriptBox["\[HBar]", "2"]}], " ", "|", 
         SubscriptBox["\[Alpha]", "t"], 
         SuperscriptBox["|", "2"]}]]}]], " "}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998412002933915*^9, 3.998412009510531*^9}},
 FontSize->16,
 CellID->1073561605,ExpressionUUID->"1eb8c94f-7a50-4ebe-a857-ca604d56fd44"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Utilizing the classical definition of momentum ",
 Cell[BoxData[
  FormBox[
   RowBox[{"p", "=", 
    SqrtBox[
     RowBox[{"2", " ", "m", " ", "E"}]]}], TraditionalForm]],ExpressionUUID->
  "97f9e785-cf0a-4875-91fd-76fe5e4e6acc"],
 ", one can express the energy density of the GWP as "
}], "Text",
 CellChangeTimes->{{3.9983403356745243`*^9, 3.998340384370269*^9}, {
  3.9983405269571*^9, 3.99834055979111*^9}, {3.998346742661182*^9, 
  3.998346780674588*^9}},
 CellID->192293141,ExpressionUUID->"89247826-a17d-43dd-924b-ac513c7033d6"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[Rho]", "(", "E", ")"}], "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       OverscriptBox["\[Rho]", "~"], "(", 
       RowBox[{
        SqrtBox[
         RowBox[{"2", " ", "m", " ", "E"}]], ",", "t"}], ")"}], "+", 
      RowBox[{
       OverscriptBox["\[Rho]", "~"], "(", 
       RowBox[{
        RowBox[{"-", 
         SqrtBox[
          RowBox[{"2", " ", "m", " ", "E"}]]}], ",", "t"}], ")"}]}], ")"}], 
    FractionBox[
     RowBox[{"\[DifferentialD]", "p"}], 
     RowBox[{"\[DifferentialD]", "E"}]]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->2055415699,ExpressionUUID->"d55f600e-a080-495b-aea8-929caf8707f6"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "<=", "E", "<", "\[Infinity]"}], TraditionalForm]],
  ExpressionUUID->"38b6b1f2-d934-4489-8597-49f57352b5c9"],
 "."
}], "Text",
 CellChangeTimes->{{3.9983405631127872`*^9, 3.998340582914792*^9}, {
  3.9983467896374493`*^9, 3.998346796268415*^9}},
 CellID->949707451,ExpressionUUID->"3f294e05-83d5-4ed1-a434-fcdbdb2888f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Cumulative Distribution Functions", "Subsection",
 CellChangeTimes->{{3.998348296360523*^9, 3.998348315746814*^9}},
 CellID->1558444832,ExpressionUUID->"383fd243-971b-432b-b367-a9d6f0a53aed"],

Cell[CellGroupData[{

Cell["\<\
Cumulative distribution functions (CDFs) for position, momentum, and energy \
are defined by the integral\
\>", "Text",
 CellChangeTimes->{{3.998341735495281*^9, 3.998341742819045*^9}, {
   3.998341816793914*^9, 3.998341825591901*^9}, {3.998341976785922*^9, 
   3.998341984105179*^9}, 3.998398813566564*^9, {3.998407021606131*^9, 
   3.998407022353573*^9}, {3.998412053914584*^9, 3.9984120763905153`*^9}},
 CellID->2071732612,ExpressionUUID->"abebd6ef-22e6-472e-98b3-a8c75d677c99"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"C", "(", "\[Sigma]", ")"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     SubscriptBox["\[Sigma]", "min"], "\[Sigma]"], 
    RowBox[{
     RowBox[{"\[Rho]", "(", 
      SuperscriptBox["\[Sigma]", "\[Prime]"], ")"}], 
     RowBox[{"\[DifferentialD]", 
      SuperscriptBox["\[Sigma]", "\[Prime]"]}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->310157426,ExpressionUUID->"9cc13eb9-cbd5-4db2-93ed-38d69ba1a0be"]
}, Open  ]],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", "min"], TraditionalForm]],ExpressionUUID->
  "d55ec2d4-227e-47f5-b334-760865f51243"],
 " is the minimum value of the given domain.  For a GWP the CDFs are \
analytical expressions involving  error functions and the GWP parameters."
}], "Text",
 CellChangeTimes->{{3.998341987265965*^9, 3.998342056403995*^9}, {
  3.998342384183721*^9, 3.9983424168318233`*^9}, {3.998346949255403*^9, 
  3.998346953746087*^9}, {3.9983988374604597`*^9, 3.998398909079805*^9}, {
  3.998399200526684*^9, 3.998399207997073*^9}, {3.998399353788693*^9, 
  3.9983993719438133`*^9}, {3.998407035508232*^9, 3.9984070386247873`*^9}, {
  3.998407071702757*^9, 3.99840710637152*^9}, {3.998412046016057*^9, 
  3.998412047433159*^9}, {3.998412097110222*^9, 3.998412120008411*^9}},
 CellID->873047513,ExpressionUUID->"7e0cae1a-fe3a-46df-ae7d-77a1cc0bedbb"],

Cell[CellGroupData[{

Cell["\<\
Interval probabilities are evaluated as the difference of two CDF values \
\>", "Text",
 CellChangeTimes->{{3.998341987265965*^9, 3.998342056403995*^9}, {
  3.998342384183721*^9, 3.9983424168318233`*^9}, {3.998346949255403*^9, 
  3.998346953746087*^9}, {3.9983988374604597`*^9, 3.998398909079805*^9}, {
  3.998399200526684*^9, 3.998399207997073*^9}, {3.998399353788693*^9, 
  3.9983993719438133`*^9}, {3.998407035508232*^9, 3.9984070386247873`*^9}, {
  3.998407071702757*^9, 3.9984071273653097`*^9}, {3.998412085020859*^9, 
  3.998412085500291*^9}},
 CellID->136469881,ExpressionUUID->"31f925f1-951e-445c-9f74-b1ff40269090"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"P", "(", 
    RowBox[{"\[Sigma]", "\[Element]", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["\[Sigma]", "i"], ",", 
       SubscriptBox["\[Sigma]", "f"]}], ")"}]}], ")"}], "=", 
   RowBox[{
    RowBox[{"C", "(", 
     SubscriptBox["\[Sigma]", "f"], ")"}], "-", 
    RowBox[{"C", "(", 
     SubscriptBox["\[Sigma]", "i"], ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1701274687,ExpressionUUID->"4efba88d-a7fb-4663-9e82-55bcb7236f8b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Recursive Derivatives", "Subsection",
 CellChangeTimes->{{3.998348322284196*^9, 3.998348333575597*^9}, {
  3.998377056875139*^9, 3.998377058182811*^9}},
 CellID->1634664453,ExpressionUUID->"8be6118a-374b-41f3-8c17-84736afdc98d"],

Cell[CellGroupData[{

Cell[TextData[{
 "Let the spatial form of the GWP wavefunction at some implicit time ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "\[Tau]"}], TraditionalForm]],ExpressionUUID->
  "c0ae55d9-141f-40db-9b95-cc58b586d821"],
 " be defined by its complex exponent, such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[CapitalPsi]", "(", "x", ")"}], "\[Proportional]", " ", 
    SuperscriptBox["e", 
     RowBox[{"Z", "(", "x", ")"}]]}], TraditionalForm]],ExpressionUUID->
  "ae187ea0-72fe-40b3-be3b-56f08077aa7b"],
 ".  The n-th spatial derivative can be factored perfectly into a polynomial ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "n"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "75762fef-0227-4959-af75-4868df28fdf1"],
 " multiplied by the base wavefunction"
}], "Text",
 CellChangeTimes->{{3.9983484814931707`*^9, 3.998348641477503*^9}, {
   3.998348722640027*^9, 3.998348723232568*^9}, {3.9983490362702293`*^9, 
   3.9983490868718224`*^9}, {3.9983491344765797`*^9, 3.998349323459993*^9}, {
   3.998349687554061*^9, 3.9983497281100807`*^9}, {3.998377060526353*^9, 
   3.9983770971659813`*^9}, 3.9983771390395327`*^9, {3.998377496556448*^9, 
   3.998377498567029*^9}, {3.998393972433612*^9, 3.998394031578618*^9}, {
   3.998412154739128*^9, 3.9984121550955667`*^9}},
 CellID->1047165500,ExpressionUUID->"d9aa8769-96fe-4f5b-ba5d-8446483952b7"],

Cell[BoxData[
 FormBox[
  RowBox[{
   FractionBox[
    RowBox[{
     SuperscriptBox["\[PartialD]", "n"], 
     RowBox[{"\[CapitalPsi]", "(", "x", ")"}]}], 
    RowBox[{"\[PartialD]", 
     SuperscriptBox["x", "n"]}]], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["P", "n"], "(", "x", ")"}], 
    RowBox[{"\[CapitalPsi]", "(", "x", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1082071335,ExpressionUUID->"4b64024e-0dd1-4b16-92af-71a2db212759"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Because the exponent ",
 Cell[BoxData[
  FormBox[
   RowBox[{"Z", "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "eadecf42-f576-4431-ac74-db4b800b3165"],
 " is quadratic in space"
}], "Text",
 CellChangeTimes->{{3.998348712531827*^9, 3.998348844678886*^9}, {
   3.998349103390387*^9, 3.998349119124073*^9}, 3.9983769998976393`*^9},
 CellID->1481404549,ExpressionUUID->"7ca0b556-c7e4-48ac-be6a-61245413feda"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Z", "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox[
      RowBox[{
       SubscriptBox["\[Alpha]", "\[Tau]"], "(", 
       RowBox[{"x", "-", 
        SubscriptBox["x", "\[Tau]"]}], ")"}], "2"]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     RowBox[{
      SubscriptBox["p", "\[Tau]"], "(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "\[Tau]"]}], ")"}]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     SubscriptBox["\[Gamma]", "\[Tau]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->40851725,ExpressionUUID->"f2aa6bbe-4891-41b9-a8e8-831f522d037f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["its first spatial derivative is strictly linear", "Text",
 CellChangeTimes->{{3.998377002107995*^9, 3.998377005668632*^9}},
 CellID->1547658682,ExpressionUUID->"0d81f6ac-df32-4eb4-a074-462d83607e51"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["Z", "\[Prime]"], "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "2"}], 
     RowBox[{
      SubscriptBox["\[Alpha]", "\[Tau]"], "(", 
      RowBox[{"x", "-", 
       SubscriptBox["x", "\[Tau]"]}], ")"}]}], "+", 
    RowBox[{
     FractionBox["\[ImaginaryI]", "\[HBar]"], 
     SubscriptBox["p", "\[Tau]"]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1177535910,ExpressionUUID->"8cb913eb-9c55-49a5-a3be-f93b9d530edc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "This allows the internal engine to generate ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["P", "n"], "(", "x", ")"}], TraditionalForm]],ExpressionUUID->
  "c7993446-5ddc-4d79-ad14-580c321103d8"],
 " using a simple computationally cheap recurrence relation"
}], "Text",
 CellChangeTimes->{{3.998348939866139*^9, 3.9983489843467903`*^9}},
 CellID->1784232265,ExpressionUUID->"37e8befb-e2f7-4817-b739-7a9e38a4cf04"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["P", "n"], "(", "x", ")"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["Z", "\[Prime]"], "(", "x", ")"}], 
     RowBox[{
      SubscriptBox["P", 
       RowBox[{"n", "-", "1"}]], "(", "x", ")"}]}], "+", 
    RowBox[{
     SubsuperscriptBox["P", 
      RowBox[{"n", "-", "1"}], "\[Prime]"], "(", "x", ")"}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998412181705368*^9, 3.99841218367307*^9}},
 FontSize->16,
 CellID->130031147,ExpressionUUID->"df286d32-7596-404f-b038-fee890169cfd"]
}, Open  ]],

Cell[TextData[{
 "where the base polynomial is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "0"], "(", "x", ")"}], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"dd0d2b2c-cf2f-420d-9fb2-4b2ec8316a71"],
 "."
}], "Text",
 CellChangeTimes->{{3.998349807577056*^9, 3.998349835547728*^9}, {
  3.998377210146533*^9, 3.998377214696579*^9}},
 CellID->1442618630,ExpressionUUID->"0365781c-c757-48f7-9998-74596790c38b"],

Cell["\<\
By implementing this recursive polynomial generator, the engine entirely \
avoids calling heavy, generic symbolic calculus routines when a user requests \
a high-order derivative.\
\>", "Text",
 CellChangeTimes->{{3.9983503870472803`*^9, 3.9983504335718393`*^9}, {
   3.9983931399029303`*^9, 3.9983931601167173`*^9}, {3.9983987126990147`*^9, 
   3.998398774241584*^9}, 3.998407237979863*^9},
 CellID->1000939780,ExpressionUUID->"2b5796c2-a232-499e-9b7c-8aeeaee1b268"],

Cell["\<\
A perfectly similar recursive algorithm is also used to construct derivatives \
of the momentum-space wavefunction and both the position-space and \
momentum-space probability densities. \
\>", "Text",
 CellChangeTimes->{{3.9983773805741587`*^9, 3.9983774153968782`*^9}, {
   3.998377546585709*^9, 3.998377558093849*^9}, {3.998398655048161*^9, 
   3.998398694720595*^9}, 3.9983987879899406`*^9, {3.998407290328393*^9, 
   3.998407361246674*^9}, {3.9984074002187023`*^9, 3.9984074386704607`*^9}, {
   3.998407477444146*^9, 3.998407477965644*^9}},
 CellID->1555475509,ExpressionUUID->"338e3d73-7822-4bb4-965d-93ef06874f1c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Expectation Values", "Subsection",
 CellChangeTimes->{{3.998346967920989*^9, 3.998346974689209*^9}},
 CellID->1726388251,ExpressionUUID->"923c75ee-1e86-4c53-b9fe-cf387392ea7f"],

Cell[CellGroupData[{

Cell["\<\
The exact integral definitions for arbitrary n-th order integer powers of the \
position and momentum operators are given by\
\>", "Text",
 CellChangeTimes->{{3.998378357677886*^9, 3.998378416310218*^9}},
 CellID->755779940,ExpressionUUID->"0e6ef2e4-c7d1-407e-a743-69b0c7e0ee07"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox["x", "n"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalPsi]", "*"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     SuperscriptBox["x", "n"], 
     RowBox[{"\[CapitalPsi]", "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->27679575,ExpressionUUID->"a46c73eb-5848-4e60-8b8e-22ee15d90b25"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    SuperscriptBox["p", "n"], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalPsi]", "*"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "x"}]]}], ")"}], "n"], 
     RowBox[{"\[CapitalPsi]", "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1354149273,ExpressionUUID->"7b353166-df0d-4472-8ef9-aee9a6ecd2f0"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Likewise the position-momentum cross-products are formally defined as  \
\>", "Text",
 CellChangeTimes->{{3.998378424695077*^9, 3.998378509545092*^9}, {
  3.9983830434858*^9, 3.998383046471377*^9}},
 CellID->155140405,ExpressionUUID->"075ea26f-fda5-4f01-aa95-954ec9df629d"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SuperscriptBox["x", "m"], 
     SuperscriptBox["p", "n"]}], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalPsi]", "*"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     SuperscriptBox["x", "m"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "x"}]]}], ")"}], "n"], 
     RowBox[{"\[CapitalPsi]", "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998412254472822*^9, 3.9984122572477922`*^9}},
 FontSize->16,
 CellID->399639377,ExpressionUUID->"8aead9ba-4b42-4003-b95f-20d52f29e47c"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[LeftAngleBracket]", 
    RowBox[{
     SuperscriptBox["p", "m"], 
     SuperscriptBox["x", "n"]}], "\[RightAngleBracket]"}], "=", 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[CapitalPsi]", "*"], "(", 
      RowBox[{"x", ",", "t"}], ")"}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", "\[HBar]", 
        FractionBox["\[PartialD]", 
         RowBox[{"\[PartialD]", "x"}]]}], ")"}], "m"], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "n"], 
       RowBox[{"\[CapitalPsi]", "(", 
        RowBox[{"x", ",", "t"}], ")"}]}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 FontSize->16,
 CellID->1557645070,ExpressionUUID->"b369bb4c-8839-48b8-8de6-2bd5cccad29a"]
}, Open  ]],

Cell["\<\
To evaluate these integrals analytically, the backend engine leverages the \
exact same recursive polynomial generator used for the wavefunction \
derivatives. By expressing the momentum operator derivatives as polynomials \
factored out of the Gaussian exponent, the expectation integrals reduce to \
exact algebraic combinations of the GWP parameters, bypassing summation \
limits or numerical quadrature entirely.\
\>", "Text",
 CellChangeTimes->{{3.998383252475999*^9, 3.998383345544773*^9}, {
  3.9983941917721786`*^9, 3.998394196407902*^9}, {3.998407691380397*^9, 
  3.9984076913857317`*^9}},
 CellID->1515034560,ExpressionUUID->"26298165-54e0-4418-af6f-98b860a07d10"],

Cell["\<\
Arbitrary order kinetic and potential energy expectation values and \
cross-products are expressed directly as sums of the position and momentum \
expectation values and cross-products defined above.\
\>", "Text",
 CellChangeTimes->{{3.998383252475999*^9, 3.998383345544773*^9}, {
  3.9983941917721786`*^9, 3.998394196407902*^9}, {3.998407692521476*^9, 
  3.998407807801874*^9}, {3.9984079744236526`*^9, 3.998407995750667*^9}, {
  3.998412281420227*^9, 3.998412283821023*^9}},
 CellID->433776968,ExpressionUUID->"1c51eb19-250e-43c1-8304-b338e0325509"],

Cell[TextData[{
 "The total energy (Hamiltonian) expectation value is just a sum of the \
kinetic and potential energy expectation values.  Unfortunately, higher-order \
expectation values of the total energy are not so easy to calculate \
algorithmically. However, the first few moments can be calculated \
symbolically for a GWP.  This approach was used to generate code for total \
energy moments through ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "4"}], TraditionalForm]],ExpressionUUID->
  "2922c0c9-4f59-4660-bd72-00787906a6d3"],
 "."
}], "Text",
 CellChangeTimes->{{3.998390317835848*^9, 3.998390445222808*^9}, {
  3.998394343477297*^9, 3.998394398913686*^9}, {3.9984015929400167`*^9, 
  3.998401608103559*^9}, {3.998408038289966*^9, 3.998408075972556*^9}, {
  3.9984123026084547`*^9, 3.998412312407227*^9}},
 CellID->733264627,ExpressionUUID->"691833b5-6d7b-477a-b683-32adfa2601c2"],

Cell[CellGroupData[{

Cell["\<\
Uncertainties, covariances, and correlations of operators are calculated \
using standard definitions:\
\>", "Text",
 CellChangeTimes->{{3.998390885497957*^9, 3.9983908990584106`*^9}, 
   3.998390998115641*^9, {3.998394231620612*^9, 3.998394239200296*^9}, {
   3.9983990515877523`*^9, 3.998399056433791*^9}, {3.9984074948984528`*^9, 
   3.998407650658791*^9}, {3.998407892394661*^9, 3.998407893691856*^9}},
 CellID->472247441,ExpressionUUID->"b8b346bd-e9f9-4841-a8af-07e2cca7b680"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"\[CapitalDelta]", " ", "A"}], "=", 
   SqrtBox[
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", 
      SuperscriptBox["A", "2"], "\[RightAngleBracket]"}], "-", 
     SuperscriptBox[
      RowBox[{"\[LeftAngleBracket]", "A", "\[RightAngleBracket]"}], "2"]}]]}],
   TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998405990910375*^9, 3.998406000158716*^9}},
 FontSize->16,
 CellID->2110665222,ExpressionUUID->"f4c2b69c-cec8-4c02-8188-d943142d0bbd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Cov", "(", 
    RowBox[{"A", ",", "B"}], ")"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], 
     RowBox[{"\[LeftAngleBracket]", 
      RowBox[{
       RowBox[{"A", " ", "B"}], "+", 
       RowBox[{"B", " ", "A"}]}], "\[RightAngleBracket]"}]}], "-", 
    RowBox[{
     RowBox[{"\[LeftAngleBracket]", "A", "\[RightAngleBracket]"}], 
     RowBox[{"\[LeftAngleBracket]", "B", "\[RightAngleBracket]"}]}]}]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.9984060046695127`*^9, 3.998406019754551*^9}},
 FontSize->16,
 CellID->247307081,ExpressionUUID->"f60a21d0-ba39-4c4c-a1c6-a4dbcffb827b"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"Corr", "(", 
    RowBox[{"A", ",", "B"}], ")"}], "=", 
   FractionBox[
    RowBox[{"Cov", "(", 
     RowBox[{"A", ",", "B"}], ")"}], 
    RowBox[{
    "\[CapitalDelta]", " ", "A", " ", "\[CapitalDelta]", " ", "B"}]]}], 
  TraditionalForm]], "DisplayFormulaNumbered",
 CellMargins->{{30, Inherited}, {Inherited, Inherited}},
 CellChangeTimes->{{3.998406022645955*^9, 3.9984060360056257`*^9}, {
  3.9984061588421373`*^9, 3.998406161619824*^9}},
 FontSize->16,
 CellID->916723947,ExpressionUUID->"176774b1-dc57-4485-bfe3-f9568b2291af"]
}, Open  ]],

Cell["\<\
The 1D engine provides uncertainties for position, momentum, force, potential \
energy, kinetic energy, and total energy.  Covariances and correlations are \
available for position and momentum, and also for kinetic and potential \
energy.\
\>", "Text",
 CellChangeTimes->{{3.9983944287312307`*^9, 3.9983944996226187`*^9}, {
  3.998407896930582*^9, 3.998407949207921*^9}, {3.9984080960675488`*^9, 
  3.998408141508342*^9}, {3.998412324462309*^9, 3.998412386437561*^9}},
 CellID->1328980367,ExpressionUUID->"19aaf908-c384-4605-8266-42fa32650953"]
}, Open  ]]
}, Open  ]],

