       ExpressionUUID->"2d55bac9-b095-4513-8c67-ce57fef189db"],
      Text["GWP1DCOVKEPE[param]"]], 
     PaneBox[
      InterpretationBox[Cell[BoxData[
        FormBox[
         StyleBox["\<\"Evaluates the kinetic-potential energy covariance.\"\>",
          StripOnInput->False,
          TextAlignment->Left,
          LineIndent->0], TextForm]], "InlineText",ExpressionUUID->
        "bd53078d-6b63-4273-808d-3afd3a05e856"],
       Text[
