Cell[CellGroupData[{

Cell["\<\
Attempt to evaluate the total energy expectation (ETE) moments up to order 5. \
While EKE and EPE support arbitrary moments, analytically exact total energy \
moments are mathematically limited to n=4. The engine safely catches and \
rejects requests beyond this limit.\
\>", "MathCaption",
 CellID->683167625,ExpressionUUID->"aafcc843-2598-4260-ba98-3e7924508a65"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"OBJ2", "[", 
     RowBox[{"\"\<ETE\>\"", ",", " ", "#"}], "]"}], "[", "0", "]"}], " ", 
   "&"}], " ", "/@", " ", 
  RowBox[{"Range", "[", 
   RowBox[{"0", ",", " ", "5"}], "]"}]}]], "Input",
 CellLabel->"In[79]:=",
 CellID->1550696513,ExpressionUUID->"162d7978-36f3-4975-b91d-08e620aa2988"],

Cell[BoxData[
 TemplateBox[{
  "GWP1DETE", "maxorder", 
   "\"Analytically exact total energy moments are only supported up to n = 4. \
Requested order: \\!\\(\\*RowBox[{\\\"5\\\"}]\\).\"", 2, 79, 5, 
   34105756699521342811, "Local", "GWPTools`GWPDeveloper`GWP1DETE"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.998420642091357*^9, 3.998645544641488*^9, 
  3.998852942235461*^9, 4.000412310288497*^9},
