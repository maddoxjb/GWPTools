Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["p", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}], ")"}]}], "+", 
       RowBox[{"ArcTan", "[", 
        FractionBox["t", "2"], "]"}]}], ")"}]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     FractionBox["2", "\[Pi]"], ")"}], 
    RowBox[{"1", "/", "4"}]]}], 
  RowBox[{
   SqrtBox[
    RowBox[{"-", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]"}], "+", "t"}]]}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"4", "+", 
      SuperscriptBox["t", "2"]}], ")"}], 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{3.998420641401895*^9, 3.998645474811306*^9, 
  3.9988529415309477`*^9},
