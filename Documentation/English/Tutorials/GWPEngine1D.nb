 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
   RowBox[{"\"\<Records\>\"", ",", " ", "\"\<StaticParameters\>\""}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[5]:=",
 CellID->218344565,ExpressionUUID->"ceffbba1-13e5-4fb4-8c46-bcbfce8e0a1e"],

