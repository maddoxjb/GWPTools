Cell[CellGroupData[{

Cell["\<\
Apply the free particle and parameterized harmonic oscillator propagators to \
a default parameter bus, and extract the resulting time-dependent spatial \
spread parameter (RA). Notice the curried syntax used to inject the \
oscillator frequency.\
\>", "MathCaption",
 CellID->499957170,ExpressionUUID->"ca5dc4ba-8123-4d55-922f-1b72773efec5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"GWP1DRA", " ", "@", " ", 
  RowBox[{
   RowBox[{"GWP1DFREE", "[", "t", "]"}], " ", "@", " ", 
   RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"GWP1DRA", " ", "@", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"GWP1DHARMONIC", "[", "2", "]"}], "[", "t", "]"}], " ", "@", " ", 
    RowBox[{"GWP1DPARAM", "[", "]"}]}]}], "//", "Simplify"}]}], "Input",
 CellChangeTimes->{{3.998416116166499*^9, 3.998416117885522*^9}},
 CellLabel->"In[127]:=",
 CellID->1824129126,ExpressionUUID->"c017fe29-ab26-4e90-8f57-2d12c1b0b7f3"],

Cell[BoxData[
 FractionBox["1", 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox["t", "2"], "4"]}], ")"}]}]]], "Output",
 CellChangeTimes->{3.9984206440083942`*^9, 3.99864587689946*^9, 
  3.998852954757986*^9},
 CellLabel->"Out[127]=",
 CellID->1281236400,ExpressionUUID->"8f5e3d8c-9ae7-404f-9073-58940f44ee82"],

Cell[BoxData[
 FractionBox["8", 
  RowBox[{"17", "+", 
   RowBox[{"15", " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"4", " ", "t"}], "]"}]}]}]]], "Output",
 CellChangeTimes->{3.9984206440083942`*^9, 3.99864587689946*^9, 
  3.998852954762518*^9},
 CellLabel->"Out[128]=",
 CellID->921646331,ExpressionUUID->"ca7e0d5e-94b7-45bf-9530-ed51c075538c"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Wavefunctions & Probabilities", "Subsection",
 CellID->661676110,ExpressionUUID->"d012f233-9479-423f-b62f-832219e26a18"],

Cell["\<\
The backend supports arbitrary n-th order spatial and momentum derivatives, \
accessed via curried syntax (e.g., GWP1DPSIX[n][x][param]). These are \
evaluated efficiently using the internal GWP1DHermiteEngine. Analytical CDFs \
bypass the need for numerical integration.\
\>", "Text",
 CellID->1120056604,ExpressionUUID->"178a913c-45b4-4980-8b0d-d31cbb196424"],

Cell["\<\
Spatial wavefunctions represent the core probability amplitudes in coordinate \
space. They are evaluated by passing the optional derivative order \
(defaulting to 0), the coordinate, and the parameter bus.\
\>", "Text",
 CellID->2097177473,ExpressionUUID->"eb43fd57-d637-4a34-9d38-aa49ee8fd0f8"],

Cell[CellGroupData[{

