Cell[CellGroupData[{

Cell["\<\
Programmatically instantiate a wavepacket for every registered potential \
model, evaluate their external potential (PEX) fields simultaneously, and \
format the output into a clean Dataset using an Association.\
\>", "MathCaption",
 CellID->685534538,ExpressionUUID->"d11987eb-f127-438b-b6c1-9ab93aa44bec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"models", "=", 
   RowBox[{"ToExpression", "[", 
    RowBox[{
     RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<PotentialModels\>\"", 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "@", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Potential Model\>\"", "->", "#"}], ",", 
       RowBox[{"\"\<PEX[x, t]\>\"", "->", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
           RowBox[{"\"\<Potential\>\"", "->", "#"}], "]"}], "[", "\"\<PEX\>\"",
           "]"}], "[", 
         RowBox[{"x", ",", "t"}], "]"}]}]}], "|>"}], "&"}], ",", "models"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.9984143805525703`*^9, 3.998414386865473*^9}, {
  3.9986456641442747`*^9, 3.998645684049411*^9}},
