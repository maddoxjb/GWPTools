}, Open  ]],

Cell["\<\
Extract the position-space density, as a function of space and time:\
\>", "ExampleText",
 CellChangeTimes->{{3.995725348532827*^9, 3.99572537993717*^9}, {
   3.9960584521702538`*^9, 3.996058454129301*^9}, {3.9960603665973387`*^9, 
   3.99606036754296*^9}, 3.9960604125971937`*^9},
 CellID->766500608,ExpressionUUID->"636c11f3-0788-4cfb-8a96-af8144c19c33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rho", "[", 
   RowBox[{"x_", ",", "t_"}], "]"}], "=", 
  RowBox[{
   RowBox[{"obj", "[", "\"\<DensityX\>\"", "]"}], "[", 
   RowBox[{"x", ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9957253926734667`*^9, 3.995725392674569*^9}, {
  3.996058458029564*^9, 3.996058477025709*^9}, {3.9960585080382833`*^9, 
  3.996058513191416*^9}, {3.9960603572017937`*^9, 3.996060359080779*^9}, {
  3.9978268835714903`*^9, 3.9978268878307734`*^9}},
 CellLabel->"In[4]:=",
 CellID->1768486087,ExpressionUUID->"c38e6309-c67a-4924-904f-3a5622a087f4"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["x", "2"], 
      RowBox[{"2", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["t", "2"], "4"]}], ")"}]}]]}]], " ", 
   SqrtBox[
    FractionBox["1", 
     RowBox[{"1", "+", 
      FractionBox[
       SuperscriptBox["t", "2"], "4"]}]]]}], 
  SqrtBox[
   RowBox[{"2", " ", "\[Pi]"}]]]], "Output",
 CellChangeTimes->{4.0004132311774273`*^9},
 CellLabel->"Out[4]=",
 CellID->644317998,ExpressionUUID->"b1843870-704d-4d9e-a7df-85907424c5aa"]
}, Open  ]],

Cell["Plot the probability density at different times:", "ExampleText",
 CellChangeTimes->{{3.995725477169115*^9, 3.99572551718463*^9}, {
  3.996060529653639*^9, 3.996060533761763*^9}, {3.996060748797821*^9, 
  3.996060751027811*^9}},
 CellID->1014549381,ExpressionUUID->"edc2b94b-f0bd-401b-8573-69112878af0b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"times", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "2.5", ",", "5"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"rho", "[", 
     RowBox[{"x", ",", "times"}], "]"}], "//", "Evaluate"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<Probability Density\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotLegends", "->", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\"\<t = \>\"", "<>", 
        RowBox[{"ToString", "[", "#", "]"}]}], "&"}], "/@", "times"}], 
     ")"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.995725525716292*^9, 3.995725525716552*^9}, {
  3.996060460776475*^9, 3.996060604191311*^9}, {3.996060673172297*^9, 
