Cell["\<\
Extract the wavefunctions and show that the overlap is very small and does \
not change with time: \
\>", "ExampleText",
 CellChangeTimes->{{3.996070082947276*^9, 3.9960701598394747`*^9}, {
  3.99607035807693*^9, 3.996070424927176*^9}},
 CellID->1841429112,ExpressionUUID->"9862db16-fe3d-45e9-959e-2f037e517721"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"csi1", "[", 
    RowBox[{"x", ",", "t"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj1", "[", "\"\<ConjugateWavefunctionX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"psi2", "[", 
    RowBox[{"x", ",", "t"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj2", "[", "\"\<WavefunctionX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.99606887703866*^9, 3.996068909645591*^9}, {
  3.996068985563498*^9, 3.996069008457429*^9}, {3.99607004487644*^9, 
  3.9960700485510387`*^9}, {3.996070096930272*^9, 3.996070116177805*^9}},
 CellLabel->"In[512]:=",
 CellID->538544301,ExpressionUUID->"5135e455-ea3d-4a45-a358-2969f01c0359"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"csi1", "[", 
     RowBox[{"x", ",", "t"}], "]"}], "*", 
    RowBox[{"psi2", "[", 
     RowBox[{"x", ",", "t"}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"Assumptions", "\[Rule]", 
    RowBox[{"t", "\[Element]", "Reals"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996068145733171*^9, 3.996068259542365*^9}, {
   3.996068446668353*^9, 3.9960684593893433`*^9}, {3.996068917325865*^9, 
