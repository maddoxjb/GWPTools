Cell["\<\
Plot the static phase-space trajectory (position vs. momentum expectation) \
over five driving cycles:\
\>", "ExampleText",
 CellChangeTimes->{{3.996092854784905*^9, 3.996092955340785*^9}, 
   3.998654899735343*^9},
 CellID->1439177796,ExpressionUUID->"d9ce3acb-eece-4553-90a2-f1eef993fce4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"obj", "[", "\"\<PositionExpectation\>\"", "]"}], "[", "t", 
      "]"}], ",", 
     RowBox[{
      RowBox[{"obj", "[", "\"\<MomentumExpectation\>\"", "]"}], "[", "t", 
      "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"10", " ", "Pi"}]}], "}"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Position\>\"", ",", "\"\<Momentum\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"ColorData", "[", 
     RowBox[{"97", ",", "1"}], "]"}]}], ",", 
   RowBox[{"AspectRatio", "->", "1"}]}], "]"}]], "Input",
