Cell["\<\
While 1D plots do not appear affected by the step function; however, 2D and \
3D plots of field functions containing the Gouy phase, do show a \
discontinuity.  Use Exclusions\[Rule]None to remove the effect.\
\>", "ExampleText",
 CellChangeTimes->{{3.996088993431282*^9, 3.996089016172166*^9}, {
  3.996089542383429*^9, 3.9960896001705112`*^9}, {3.9960896352951803`*^9, 
  3.996089727196351*^9}, {3.9960904922857533`*^9, 3.9960905502520313`*^9}},
 CellID->67424038,ExpressionUUID->"c1e6cc95-1811-4c85-aafb-09977186127f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Rpsi", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", 
      RowBox[{"\"\<Potential\>\"", "->", "HO"}], "]"}], 
     "[", "\"\<ImaginaryWavefunctionX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Rpsi", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"Rpsi", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"Exclusions", "->", "None"}]}], "]"}]}], "\[IndentingNewLine]", 
   "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.996089979424264*^9, 3.996090008940597*^9}, {
