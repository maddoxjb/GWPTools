Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"obj1", "[", "\"\<DensityX\>\"", "]"}], "[", 
      RowBox[{"x", ",", "0"}], "]"}], ",", 
     RowBox[{
      RowBox[{"obj2", "[", "\"\<DensityX\>\"", "]"}], "[", 
      RowBox[{"x", ",", "0"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Dashing", "[", "None", "]"}], ",", "Dashed"}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Initial Position Density\>\""}]}], 
  "]"}]], "Input",
