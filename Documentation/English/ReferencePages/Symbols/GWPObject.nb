Cell["\<\
When you query \"Assumptions\" directly from the object, it only returns the \
assumptions for the core 11-element parameter sequence. Variables introduced \
by the potential model (like drive frequencies) or the time variable t are \
not included because the potential has not been applied.\
\>", "ExampleText",
 CellChangeTimes->{3.9959954791754503`*^9},
 CellID->438426580,ExpressionUUID->"14799566-0492-4ae4-8606-3d5ec053bc45"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"RA", "+", 
