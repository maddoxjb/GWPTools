Notebook[{

Cell[CellGroupData[{
Cell["GWPObject", "ObjectName",
 CellID->768641715,ExpressionUUID->"6971b3c4-a822-4d0f-af51-a80d8577595e"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fd6c1442-c29d-44b6-b4a6-a0c537c20312"],
 Cell[BoxData[
  RowBox[{"GWPObject", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "204b33e3-7733-4f91-a21e-bf8c5b042158"],
 "\[LineSeparator]represents a generalized Gaussian wavepacket obtained by \
GWP."
}], "Usage",
 CellChangeTimes->{
  3.32361883463229*^9, 3.32766004026563*^9, 3.32766011595313*^9, 
   3.3278782058635*^9, 3.32958951928125*^9, {3.387566565476775*^9, 
   3.387566576423758*^9}, {3.996011535190351*^9, 3.996011623259041*^9}, {
   3.9960148254522*^9, 3.996014827079674*^9}, 3.996014872704049*^9, {
   3.996055796673717*^9, 3.9960558028031282`*^9}},
 CellID->7970,ExpressionUUID->"46d48db8-80f8-4f64-b6ac-c7372ee2466c"],

Cell["\<\
GWPObject[...] encapsulates a set of parameters, an external potential energy \
model, and related metadata characterizing a Gaussian wavepacket (GWP).\
\>", "Notes",
 CellChangeTimes->{{3.996015780340825*^9, 3.996015888946891*^9}, {
   3.996016556542562*^9, 3.996016558521834*^9}, {3.9960482761555634`*^9, 
   3.996048295657428*^9}, {3.996048326773518*^9, 3.996048326975976*^9}, {
   3.996049259225135*^9, 3.996049269548728*^9}, {3.9960493138900337`*^9, 
   3.99604933989528*^9}, 3.996055119093539*^9, {3.99782069507557*^9, 
   3.997820733151572*^9}, {3.9978208749241877`*^9, 3.997820892198914*^9}},
 CellID->141025178,ExpressionUUID->"8e5ca796-a4d8-4822-81aa-ad8582e3d7f2"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3c6ac2f2-b019-46c2-acea-d39162986ed9"], 
    RowBox[{
     StyleBox["obj", "TI"], "[", 
     StyleBox["property", "TI"], "]"}], Cell[
    "Evaluates the specified physical property.", "TableText",ExpressionUUID->
     "bb097e77-064e-4c36-9501-c5286a738c88"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f1323a63-7fe7-4987-a926-4700128d6e04"], 
    RowBox[{
     StyleBox["obj", "TI"], "[", 
     StyleBox["query", "TI"], "]"}], Cell["\<\
Queries the introspection framework for metadata (e.g., \"Records\", \
\"Properties\", \"Classes\", \"Signatures\").\
\>", "TableText",ExpressionUUID->"cf2403aa-ab09-4ff4-99b1-a2949427ec6a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "57911128-e495-41b9-ae2d-2941ad94b11a"], 
    RowBox[{
     StyleBox["obj", "TI"], "[", 
     RowBox[{
      StyleBox["query", "TI"], ",", 
      StyleBox["class", "TI"]}], "]"}], Cell[TextData[{
     "Filters the introspection query by a specific property class (e.g., ",
     StyleBox["obj", "TI"],
     "[\"Properties\",\"Energies\"])."
    }], "TableText",ExpressionUUID->"9f4a7d8e-692a-4764-92e0-5fd66738e138"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.9978214281559134`*^9, 3.997821607468231*^9}, {
  3.997822561563579*^9, 3.997822561563641*^9}, {3.9986521217803164`*^9, 
  3.9986521279593353`*^9}, {3.998652503035975*^9, 3.998652536856703*^9}, {
  3.998654090292171*^9, 3.9986541081708307`*^9}},
 CellID->936399059,ExpressionUUID->"373efd26-4e52-42d6-bc9b-dfa0f211c6bd"],

Cell["\<\
Physical properties are organized by property classes (which group related \
physics) and signature classes (which dictate the mathematical evaluation \
structure).\
\>", "Notes",
 CellChangeTimes->{{3.997821653669602*^9, 3.997821686008678*^9}, 
   3.998652357830349*^9},
 CellID->1850821415,ExpressionUUID->"6ed593ea-5576-4858-acdf-de6d14e6c4f4"],

Cell["\<\
Each physical property is a member of both a dynamic class and a static class.\
\>", "Notes",
 CellID->834067713,ExpressionUUID->"0d291fc5-43c8-46f4-a24a-ca26b6c22790"],

Cell["\<\
The property's dynamic class determines how it evaluates when the external \
potential has been activated by the GWP constructor.\
\>", "Notes",
 CellID->1550288422,ExpressionUUID->"d072e936-efd8-4b12-a2fe-20341ad76aa7"],

Cell["\<\
The property's static class determines how it evaluates as a fallback when \
the potential is inactive (i.e., a time-independent wavepacket).\
\>", "Notes",
 CellID->278419503,ExpressionUUID->"8ec27cfc-e06d-483f-aee5-374419eeb1f3"],

Cell["\<\
The specific signature assigned to a property dictates exactly how it must be \
queried, e.g., as an immediate static value, a function of time [t], a field \
over space and time [x, t], etc.\
\>", "Notes",
 CellChangeTimes->{{3.998653880052937*^9, 3.998653912675344*^9}},
 CellID->1782757015,ExpressionUUID->"4ae15142-12e0-4d0a-ae7c-17a3166c14fd"],

Cell[TextData[{
 "Use ",
 StyleBox["obj", "TI"],
 "[\"Signatures\"] to return the complete global taxonomy of all mathematical \
signatures defined within the framework."
}], "Notes",
 CellID->147138796,ExpressionUUID->"a2f4c653-c288-4a13-8d7a-ccf40427890b"],

Cell[TextData[{
 "Use ",
 StyleBox["obj", "TI"],
 "[\"Records\"] to view the specific dynamic and static signatures assigned \
to the properties of the active object."
}], "Notes",
 CellID->1208066675,ExpressionUUID->"06bad8b5-c355-42f1-8d57-5c16a214a8b1"],

Cell[TextData[{
 "Use ",
 StyleBox["obj", "TI"],
 "[\"Records\", ",
 StyleBox["property", "TI"],
 "] to view the specific dynamic and static signatures assigned to a \
particular property of the active object."
}], "Notes",
 CellChangeTimes->{{3.998654123391305*^9, 3.998654163807603*^9}, {
  3.998654256185101*^9, 3.998654259829076*^9}},
 CellID->866552835,ExpressionUUID->"61ba4cca-d420-4a13-8b81-efa7d74e5840"],

Cell["\<\
The visual layout of GWPObject[...] is controlled by the \"Summary\" option \
of the GWP constructor.\
\>", "Notes",
 CellChangeTimes->{{3.996053428126225*^9, 3.996053458089614*^9}},
 CellID->1058329724,ExpressionUUID->"001fd1fe-87fc-4fc5-9ab6-8420e1a0f04a"]
}, Open  ]],

