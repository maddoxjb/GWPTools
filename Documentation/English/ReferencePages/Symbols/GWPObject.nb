Cell["\<\
Evaluate the overlap integral to demonstrate that it is very small and \
constant over time:\
\>", "ExampleText",
 CellChangeTimes->{{3.996070082947276*^9, 3.9960701598394747`*^9}, {
   3.99607035807693*^9, 3.996070424927176*^9}, 3.9986551075726643`*^9},
 CellID->1841429112,ExpressionUUID->"9862db16-fe3d-45e9-959e-2f037e517721"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"obj1", "[", "\"\<ConjugateWavefunctionX\>\"", "]"}], "[", 
      RowBox[{"x", ",", "t"}], "]"}], "*", 
     RowBox[{
      RowBox[{"obj2", "[", "\"\<WavefunctionX\>\"", "]"}], "[", 
      RowBox[{"x", ",", "t"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"t", "\[Element]", "Reals"}]}]}], "]"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"N", "[", "%", "]"}]}], "Input",
 CellChangeTimes->{{3.996068145733171*^9, 3.996068259542365*^9}, {
   3.996068446668353*^9, 3.9960684593893433`*^9}, {3.996068917325865*^9, 
   3.9960689242777452`*^9}, {3.996069013466927*^9, 3.996069015919282*^9}, {
   3.99606904944637*^9, 3.996069074184826*^9}, 3.9960701018759737`*^9, {
   3.996070449249229*^9, 3.996070483379787*^9}, {3.998655078615368*^9, 
   3.998655084798684*^9}},
 CellLabel->"In[5]:=",
 CellID->526094388,ExpressionUUID->"1cfb3955-fe64-417b-909c-7fda920c3e9d"],

Cell[BoxData[
 FractionBox["1", 
  SuperscriptBox["\[ExponentialE]", "8"]]], "Output",
