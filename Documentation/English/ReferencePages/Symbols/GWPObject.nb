Cell[CellGroupData[{

Cell["Phase Discontinuities", "ExampleSubsection",
 CellChangeTimes->{{3.996093924269211*^9, 3.9960939315080557`*^9}},
 CellID->2107545898,ExpressionUUID->"4dd765ef-e98d-4ff6-a7cf-a1916683be0a"],

Cell["\<\
For quadratic potentials, the time-dependent expression for the real part of \
the phase parameter (the Guoy phase) contains an arctangent of a ratio \
involving time and the real and imaginary components of the shape parameter.  \
These are evaluated using ArcTan[x,y].\
\>", "ExampleText",
 CellChangeTimes->{{3.9960874010849543`*^9, 3.996087402238056*^9}, {
  3.996087566970723*^9, 3.996087595888315*^9}, {3.996087703261231*^9, 
  3.996087773894375*^9}, {3.996087830303411*^9, 3.9960878508235903`*^9}, {
  3.99608792194993*^9, 3.996087946920094*^9}, {3.996088028761598*^9, 
  3.9960880967936573`*^9}, {3.996088128582279*^9, 3.996088163065309*^9}, {
  3.996088587946102*^9, 3.9960886061045837`*^9}, {3.996088636413479*^9, 
  3.996088643524954*^9}, {3.9960886972510242`*^9, 3.996088704233921*^9}, {
  3.996089155371196*^9, 3.996089160278433*^9}},
 CellID->729102413,ExpressionUUID->"ea9181ff-3a81-4abd-aed3-304742af7aab"],

Cell["\<\
Extract the Guoy phase for a free particle with a GWP with a symbolic shape \
parameter:\
\>", "ExampleText",
 CellChangeTimes->{{3.996089078324978*^9, 3.99608907883213*^9}, {
  3.99608916460878*^9, 3.9960892134322433`*^9}},
 CellID->278800350,ExpressionUUID->"21b7fbe3-2d3b-4d17-ad07-1fd555bba009"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"RA", "+", 
      RowBox[{"I", "*", "IA"}]}], ",", 
     RowBox[{"\"\<Potential\>\"", "->", "FREE"}]}], "]"}], 
   "[", "\"\<RealPhase\>\"", "]"}], "[", "t", "]"}]], "Input",
 CellChangeTimes->{{3.996087416512072*^9, 3.996087463736889*^9}, {
  3.996087626634925*^9, 3.9960876609187517`*^9}, {3.996089066497492*^9, 
  3.996089068045074*^9}},
 CellLabel->"In[178]:=",
 CellID->1950248455,ExpressionUUID->"7b56db5f-3226-4c6a-9807-b56e4efb3f88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "2"]}], " ", 
  RowBox[{"ArcTan", "[", 
   RowBox[{
    RowBox[{"1", "-", 
     RowBox[{"2", " ", "IA", " ", "t"}]}], ",", 
    RowBox[{"2", " ", "RA", " ", "t"}]}], "]"}]}]], "Output",
 CellChangeTimes->{{3.99608744712755*^9, 3.9960874642056837`*^9}, {
   3.996087627954152*^9, 3.996087661950935*^9}, 3.9960890707364883`*^9},
 CellLabel->"Out[178]=",
 CellID->393310218,ExpressionUUID->"9457ac83-2eb9-4617-b50c-80cde24c6101"]
}, Open  ]],

Cell["\<\
For harmonic potentials the ratio involves trigonometric expressions, which \
leads branch cut discontinuities that are handled by supplementing the Guoy \
phase with an appropriate step function.\
\>", "ExampleText",
 CellChangeTimes->{{3.996088621249124*^9, 3.9960886283955727`*^9}, {
  3.9960886585278053`*^9, 3.996088667882375*^9}, {3.9960887194447947`*^9, 
  3.996088794275728*^9}, {3.9960892186459227`*^9, 3.996089227476055*^9}, {
  3.99608937110968*^9, 3.996089371528652*^9}},
 CellID->2090612849,ExpressionUUID->"e725ba59-7dd2-4050-99ad-2bae9e5d5715"],

Cell["\<\
Extract the Gouy phase for a standard harmonic oscillator with default \
parameters:\
\>", "ExampleText",
 CellChangeTimes->{{3.996088858014905*^9, 3.996088901289298*^9}, {
  3.9960893927533092`*^9, 3.9960894139825563`*^9}},
 CellID->515525746,ExpressionUUID->"4f0bacbb-88f2-479a-8626-3df24088cc24"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"guoy", "[", "t_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"GWP", "[", 
     RowBox[{"\"\<Potential\>\"", "\[Rule]", "HO"}], "]"}], 
    "[", "\"\<RealPhase\>\"", "]"}], "[", "t", "]"}]}]], "Input",
 CellChangeTimes->{{3.996087474964965*^9, 3.996087490724094*^9}, {
  3.996087678752598*^9, 3.996087684152094*^9}, {3.99608902965688*^9, 
  3.9960890601889668`*^9}, {3.9960893597469*^9, 3.9960893618681927`*^9}, {
  3.996089408064825*^9, 3.996089408847064*^9}, {3.996089513856435*^9, 
  3.996089529124946*^9}},
 CellLabel->"In[191]:=",
 CellID->147780715,ExpressionUUID->"b46125e2-be76-4217-9d74-73d8f59961da"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "2"]}], " ", 
   RowBox[{"ArcTan", "[", 
    RowBox[{
     RowBox[{"Cos", "[", "t", "]"}], ",", 
     FractionBox[
      RowBox[{"Sin", "[", "t", "]"}], "2"]}], "]"}]}], "+", 
  RowBox[{"\[Pi]", " ", 
   RowBox[{"Floor", "[", 
    FractionBox[
     RowBox[{"\[Pi]", "-", "t"}], 
     RowBox[{"2", " ", "\[Pi]"}]], "]"}]}]}]], "Output",
 CellChangeTimes->{{3.99608747935009*^9, 3.996087491662421*^9}, 
   3.99608768485256*^9, {3.996089034138856*^9, 3.996089060808642*^9}, 
   3.996089362471822*^9, 3.9960894186861486`*^9, {3.996089516863187*^9, 
   3.9960895297706633`*^9}},
 CellLabel->"Out[191]=",
 CellID->391844893,ExpressionUUID->"eb9e9274-029a-4aeb-a030-4c4b7e3140f0"]
}, Open  ]],

Cell["Illustrate the effect of the step function:", "ExampleText",
 CellChangeTimes->{{3.99608895739122*^9, 3.9960889657519417`*^9}},
 CellID->1414081036,ExpressionUUID->"d0de6c46-3c21-4b75-a573-a5846c8a5902"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fun", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"guoy", "[", "t", "]"}], ",", 
     RowBox[{
      RowBox[{"guoy", "[", "t", "]"}], "/.", 
      RowBox[{
       RowBox[{"Floor", "[", "x_", "]"}], ":>", "0"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"fun", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", 
     RowBox[{
      RowBox[{"-", "4"}], "Pi"}], ",", 
     RowBox[{"4", "Pi"}]}], "}"}], ",", 
