Cell["\<\
Construct a GWPObject for an forced harmonic oscillatory with an off-resonant \
sinusoidal driving force:\
\>", "ExampleText",
 CellChangeTimes->{{3.996091504257495*^9, 3.9960915468838873`*^9}},
 CellID->1153482799,ExpressionUUID->"380e521c-84d1-4573-88b6-8cd955bfb8b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"\"\<Potential\>\"", "->", 
      RowBox[{"FHONON", "[", 
       RowBox[{"1", ",", 
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"6", "/", "10"}]}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.996090918417612*^9, 3.996090938527693*^9}, {
   3.996091075566519*^9, 3.9960910886181383`*^9}, {3.9960911724009323`*^9, 
   3.996091181460682*^9}, {3.996091418055236*^9, 3.99609147572612*^9}, 
   3.996091553127469*^9, 3.9960940756853323`*^9},
 CellLabel->"In[316]:=",
 CellID->188309429,ExpressionUUID->"3cf347a1-e502-4b63-ab73-d752f489730c"],

Cell["\<\
Extract the time-dependent position-space density and the position and \
momentum expectation functions: \
\>", "ExampleText",
 CellChangeTimes->{{3.996091558402604*^9, 3.996091583347362*^9}, {
  3.996091984471252*^9, 3.996091990160832*^9}},
 CellID->945447910,ExpressionUUID->"31a72cc6-1df0-4264-bdf1-0fd1b3aea61c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rho", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<DensityX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xavg", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<ExpectationX\>\"", "]"}], "[", "t", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pavg", "[", "t_", "]"}], "=", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<ExpectationP\>\"", "]"}], "[", "t", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.996091972226892*^9, 3.996091978566907*^9}},
 CellLabel->"In[320]:=",
 CellID->1407919979,ExpressionUUID->"5fbc214d-1a0e-4940-8939-95b870949b62"],

Cell["\<\
Make a DensityPlot overlaid with a plot of the expectation value:\
\>", "ExampleText",
 CellChangeTimes->{{3.996091588220606*^9, 3.996091617754137*^9}, {
  3.996091944099943*^9, 3.9960919463749104`*^9}},
 CellID->91763417,ExpressionUUID->"4bee345b-9e25-4955-9917-f69620081a2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{"rho", "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"5", "*", "2", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", "\"\<position\>\""}], "}"}]}]}], "]"}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"xavg", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"5", "*", "2", "Pi"}]}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.996090577725893*^9, 3.996090676492136*^9}, {
