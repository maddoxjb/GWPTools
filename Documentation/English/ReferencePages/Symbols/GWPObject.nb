Cell["\<\
Use Animate and ParametricPlot to make an animation showing the evolution of \
the wavepacket's center in phase space. \
\>", "ExampleText",
 CellChangeTimes->{{3.996092854784905*^9, 3.996092955340785*^9}},
 CellID->1439177796,ExpressionUUID->"d9ce3acb-eece-4553-90a2-f1eef993fce4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Animate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"xavg", "[", "t", "]"}], ",", 
       RowBox[{"pavg", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"5", "*", "2", "Pi"}]}], "}"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<position\>\"", ",", "\"\<momentum\>\""}], "}"}]}], ",", 
     RowBox[{"Epilog", "->", 
      RowBox[{"{", 
       RowBox[{"Red", ",", 
        RowBox[{"PointSize", "[", ".025", "]"}], ",", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xavg", "[", "tt", "]"}], ",", 
           RowBox[{"pavg", "[", "tt", "]"}]}], "}"}], "]"}]}], "}"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
