 CellID->1019729978,ExpressionUUID->"5c61397c-a737-49b1-9df3-886e3d79827a"]
}, Open  ]],

Cell["The input parameters are also a static property:", "ExampleText",
 CellChangeTimes->{{3.997827562463428*^9, 3.997827597823801*^9}},
