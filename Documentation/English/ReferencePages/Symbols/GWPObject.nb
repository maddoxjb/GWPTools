Cell["Temporal properties evaluate as a pure function of time:", "ExampleText",
 CellChangeTimes->{{3.997827642155439*^9, 3.997827655148823*^9}},
 CellID->1896263645,ExpressionUUID->"25540540-b3a5-4ee3-905c-ed8bf101aa62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "[", "\"\<PositionUncertainty\>\"", "]"}], "[", "t", 
  "]"}]], "Input",
 CellChangeTimes->{{3.997827657238331*^9, 3.9978276668192043`*^9}},
 CellLabel->"In[4]:=",
 CellID->1386365796,ExpressionUUID->"b7337d59-0663-45a0-a55a-53fdd4a9c67b"],

Cell[BoxData[
 FractionBox["1", 
  SqrtBox[
   FractionBox["1", 
    RowBox[{"1", "+", 
     FractionBox[
      SuperscriptBox["t", "2"], "4"]}]]]]], "Output",
 CellChangeTimes->{4.000413231539403*^9},
 CellLabel->"Out[4]=",
 CellID->1738172347,ExpressionUUID->"9e116cda-732c-4604-97b3-1ffdfa56ce09"]
}, Open  ]],

Cell["Field properties evaluate as a pure function of time:", "ExampleText",
 CellChangeTimes->{{3.997827781116324*^9, 3.997827799290895*^9}},
 CellID->1237767516,ExpressionUUID->"a20e4f32-a4d4-4d23-a974-87470b1575f7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "[", "\"\<RealWavefunctionX\>\"", "]"}], "[", 
  RowBox[{"x", ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.997827710717265*^9, 3.9978277560311537`*^9}},
 CellLabel->"In[5]:=",
 CellID->2077878178,ExpressionUUID->"3965fd5a-4c64-4bfc-96a8-56b1ef722974"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["x", "2"], 
      RowBox[{"4", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["t", "2"], "4"]}], ")"}]}]]}]], " ", 
   RowBox[{"Cos", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"t", " ", 
       SuperscriptBox["x", "2"]}], 
      RowBox[{"8", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         FractionBox[
          SuperscriptBox["t", "2"], "4"]}], ")"}]}]], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"1", ",", 
        FractionBox["t", "2"]}], "]"}]}]}], "]"}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Pi]"}], ")"}], 
    RowBox[{"1", "/", "4"}]], " ", 
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", 
      FractionBox[
       SuperscriptBox["t", "2"], "4"]}], ")"}], 
    RowBox[{"1", "/", "4"}]]}]]], "Output",
 CellChangeTimes->{4.000413231560275*^9},
 CellLabel->"Out[5]=",
 CellID->1242585888,ExpressionUUID->"3daddb95-ce75-4233-82d9-1fce9fb64740"]
}, Open  ]],

Cell["\<\
Moment properties take an additional positive integer argument that specifies \
the order of the expectation value:\
\>", "ExampleText",
 CellChangeTimes->{{3.997828655975873*^9, 3.997828786143729*^9}},
 CellID->2131285778,ExpressionUUID->"82b8ef76-718f-4db3-96b7-27991be01df1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "[", 
   RowBox[{"\"\<PositionExpectation\>\"", ",", "2"}], "]"}], "[", "t", 
  "]"}]], "Input",
 CellChangeTimes->{{3.997827987566928*^9, 3.997828059142355*^9}, {
  3.997828106840541*^9, 3.997828107003107*^9}},
 CellLabel->"In[6]:=",
 CellID->611437847,ExpressionUUID->"64877926-cec5-406b-a3ad-925c4a539587"],

Cell[BoxData[
 RowBox[{"1", "+", 
  FractionBox[
   SuperscriptBox["t", "2"], "4"]}]], "Output",
 CellChangeTimes->{4.000413231579126*^9},
 CellLabel->"Out[6]=",
 CellID->2010036188,ExpressionUUID->"c004abd5-e7d1-481c-9257-7410771afa52"]
}, Open  ]],

Cell["\<\
Recursive properties use the positive integer argument to specify a \
derivative order:\
\>", "ExampleText",
 CellChangeTimes->{{3.997828720536379*^9, 3.997828757986096*^9}, {
  3.997828795111549*^9, 3.9978288160691433`*^9}},
 CellID->856755618,ExpressionUUID->"cb3867e5-da8a-4ae5-ab2c-421c84430d50"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "[", 
   RowBox[{"\"\<DensityX\>\"", ",", "1"}], "]"}], "[", 
  RowBox[{"x", ",", "t"}], "]"}]], "Input",
 CellChangeTimes->{{3.997828819487562*^9, 3.997828827198182*^9}},
 CellLabel->"In[7]:=",
 CellID->466430392,ExpressionUUID->"a12026fb-3018-4596-8d99-f4103ad8b8d3"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["x", "2"], 
       RowBox[{"2", " ", 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          FractionBox[
           SuperscriptBox["t", "2"], "4"]}], ")"}]}]]}]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["1", 
       RowBox[{"1", "+", 
        FractionBox[
         SuperscriptBox["t", "2"], "4"]}]], ")"}], 
     RowBox[{"3", "/", "2"}]], " ", "x"}], 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]]}]], "Output",
 CellChangeTimes->{4.00041323159594*^9},
 CellLabel->"Out[7]=",
 CellID->612960759,ExpressionUUID->"9760d42c-55b7-4703-92ab-f426b28dec96"]
}, Open  ]]
}, Open  ]],

