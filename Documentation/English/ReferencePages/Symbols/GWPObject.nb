Cell["\<\
Prepare a squeezed state for the standard harmonic oscillator and extract the \
position-space density and current density:\
\>", "ExampleText",
 CellChangeTimes->{{3.996071093369607*^9, 3.99607113547873*^9}},
 CellID->2002593242,ExpressionUUID->"f14a5775-c383-4b6d-a5b8-2c7603cbc9a9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{"2", ",", "1", ",", 
     RowBox[{"\"\<Potential\>\"", "->", "HO"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhox", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<DensityX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"jx", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj", "[", "\"\<CurrentX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9960620981616573`*^9, 3.996062101564867*^9}, {
  3.996062160310087*^9, 3.996062293195835*^9}, {3.996062325369969*^9, 
  3.9960624916896257`*^9}, {3.996062542966354*^9, 3.996062543442333*^9}, {
  3.996063927995397*^9, 3.996063944667844*^9}, {3.996064009947488*^9, 
  3.9960640445300426`*^9}, {3.996065676751693*^9, 3.996065727798471*^9}, {
  3.996070563261791*^9, 3.9960705763314857`*^9}, {3.996070686094968*^9, 
  3.996070697398211*^9}, {3.996070728322994*^9, 3.996070812263959*^9}, {
  3.996070905375849*^9, 3.9960709108372107`*^9}, {3.996071061778063*^9, 
  3.996071081290966*^9}},
 CellLabel->"In[595]:=",
 CellID->50634789,ExpressionUUID->"701a6136-2707-4743-9975-e68d972af52f"],

Cell["\<\
Compare contour plots of the density and current side-by-side:\
\>", "ExampleText",
 CellChangeTimes->{{3.99607113920161*^9, 3.996071149094339*^9}, {
  3.9960712157070103`*^9, 3.996071248642743*^9}},
 CellID->597683271,ExpressionUUID->"1212f3bf-408f-4341-8623-4adb09d02c23"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"opts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
     RowBox[{"Contours", "\[Rule]", "10"}], ",", 
     RowBox[{"PlotPoints", "\[Rule]", "25"}], ",", 
     RowBox[{"FrameLabel", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"\"\<time\>\"", ",", "\"\<position\>\""}], "}"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{"{", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"rhox", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"Evaluate", "@", "opts"}], ",", 
      RowBox[{"PlotLabel", "\[Rule]", "\"\<Density\>\""}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"ContourPlot", "[", 
     RowBox[{
      RowBox[{"jx", "[", 
       RowBox[{"x", ",", "t"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", 
        RowBox[{"2", "Pi"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
      RowBox[{"Evaluate", "@", "opts"}], ",", 
      RowBox[{"PlotLabel", "\[Rule]", "\"\<Current density\>\""}]}], "]"}]}], 
   "\[IndentingNewLine]", "}"}], "]"}]}], "Input",
 CellChangeTimes->{{3.9960705815244627`*^9, 3.996070665061276*^9}, {
  3.996070709594387*^9, 3.9960707129458103`*^9}, {3.996070827819326*^9, 
