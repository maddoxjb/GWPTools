 CellID->385839394,ExpressionUUID->"11a2cef6-7a9a-4b87-b7d4-ac3f3e7adc74"],

Cell[TextData[{
 "GWPObject[...][\"",
 StyleBox["property", "TI"],
 "\"] returns a particular property."
}], "Notes",
