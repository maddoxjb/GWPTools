Cell["\<\
Construct a forced harmonic oscillator with an off-resonant sinusoidal \
driving force :\
\>", "ExampleText",
 CellChangeTimes->{{3.998654979961652*^9, 3.998654997537595*^9}, {
  3.9986550557380543`*^9, 3.9986550578180313`*^9}},
 CellID->288631030,ExpressionUUID->"cb078569-78a0-4679-b603-af77184b2a15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{
    RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"1", "/", "2"}], ",", 
     RowBox[{"\"\<Potential\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<NonResonantForcedHO\>\"", ",", "1", ",", 
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"6", "/", "10"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[1]:=",
 CellID->1006819696,ExpressionUUID->"61340507-6dc1-420a-be5d-c7f8f23d4276"],

Cell["\<\
Overlay the wavepacket's continuous spatial density with its exact expected \
position:\
\>", "ExampleText",
 CellChangeTimes->{{3.996091588220606*^9, 3.996091617754137*^9}, {
   3.996091944099943*^9, 3.9960919463749104`*^9}, 3.998654925933622*^9},
 CellID->91763417,ExpressionUUID->"4bee345b-9e25-4955-9917-f69620081a2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"DensityPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"obj", "[", "\"\<DensityX\>\"", "]"}], "[", 
      RowBox[{"x", ",", "t"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"10", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"PlotPoints", "->", "100"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Time\>\"", ",", "\"\<Position\>\""}], "}"}]}]}], "]"}], ",", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"obj", "[", "\"\<PositionExpectation\>\"", "]"}], "[", "t", 
      "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", 
       RowBox[{"10", " ", "Pi"}]}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ColorData", "[", 
         RowBox[{"97", ",", "1"}], "]"}], ",", "Thick"}], "}"}]}]}], "]"}]}], 
  "]"}]], "Input",
