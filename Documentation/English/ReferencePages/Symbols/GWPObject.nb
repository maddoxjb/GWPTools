Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[Cell[
  "Neat Examples", "ExampleSection",ExpressionUUID->
   "92dae6fa-321c-4dcf-8fe1-ce3bdbbe9e39"],
  $Line = 0; Null]], "ExampleSection",
 CellID->13275214,ExpressionUUID->"603e6920-5f71-4a92-8b50-20bc1eee725d"],

Cell["\<\
Construct two distinct free-particle GWPs with the same initial shape and \
position, but opposite momenta:\
\>", "ExampleText",
 CellChangeTimes->{{3.996068534974544*^9, 3.9960685763862047`*^9}, {
  3.9960687238736563`*^9, 3.9960687522840014`*^9}, {3.996070184045309*^9, 
  3.9960702040257063`*^9}},
 CellID->2060835452,ExpressionUUID->"6fe7e6ba-6da5-48fb-94a7-684b7414959d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"obj1", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"1", "/", "4"}], ",", "0", ",", "2", ",", 
     RowBox[{"\"\<Potential\>\"", "->", "HO"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"obj2", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"1", "/", "4"}], ",", "0", ",", 
     RowBox[{"-", "2"}], ",", 
     RowBox[{"\"\<Potential\>\"", "->", "HO"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.996067442396368*^9, 3.9960674598962297`*^9}, {
  3.99606751950799*^9, 3.99606752868853*^9}, {3.9960685795711317`*^9, 
  3.996068580562825*^9}, {3.996069096891329*^9, 3.99606911194479*^9}},
 CellLabel->"In[501]:=",
 CellID->30406266,ExpressionUUID->"318188cf-3726-4912-a1cd-ce4b6a2cbeaf"],

Cell["Extract the position-space and momentum-space densities:", "ExampleText",
 CellChangeTimes->{{3.996070273823009*^9, 3.9960702867469883`*^9}},
 CellID->705792099,ExpressionUUID->"ac96ee01-e2f0-4001-b4a3-e92df66ee8dc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"rhox1", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj1", "[", "\"\<DensityX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhox2", "[", 
    RowBox[{"x_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj2", "[", "\"\<DensityX\>\"", "]"}], "[", 
    RowBox[{"x", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhop1", "[", 
    RowBox[{"p_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj1", "[", "\"\<DensityP\>\"", "]"}], "[", 
    RowBox[{"p", ",", "t"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rhop2", "[", 
    RowBox[{"p_", ",", "t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"obj2", "[", "\"\<DensityP\>\"", "]"}], "[", 
    RowBox[{"p", ",", "t"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9960686139592543`*^9, 3.996068651483097*^9}, {
  3.9960686899046803`*^9, 3.99606869096446*^9}, {3.996070170571391*^9, 
  3.996070175395452*^9}, {3.996070232387203*^9, 3.996070235725548*^9}, {
  3.996070294630392*^9, 3.996070306801609*^9}},
 CellLabel->"In[506]:=",
 CellID->1114010938,ExpressionUUID->"b5a89f94-8df2-43d8-979f-50659c456c4b"],

Cell["\<\
The wavepackets have the same initial position-space densities:\
\>", "ExampleText",
 CellChangeTimes->{{3.996068655626845*^9, 3.996068670965547*^9}, {
  3.996070500944586*^9, 3.996070503990065*^9}},
 CellID->1052246388,ExpressionUUID->"42aaf55e-14a7-4d38-a1c4-b423454d2b2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"rhox1", "[", 
      RowBox[{"x", ",", "0"}], "]"}], ",", 
     RowBox[{"rhox2", "[", 
      RowBox[{"x", ",", "0"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Dashing", "[", "None", "]"}], ",", "Dashed"}], "}"}]}]}], 
  "]"}]], "Input",
