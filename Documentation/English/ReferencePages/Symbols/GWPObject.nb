 CellID->7970,ExpressionUUID->"46d48db8-80f8-4f64-b6ac-c7372ee2466c"],

Cell["\<\
GWPObject[...] encapsulates a set of parameters, an external potential energy \
model, and related metadata characterizing a Gaussian wavepacket (GWP).\
\>", "Notes",
 CellChangeTimes->{{3.996015780340825*^9, 3.996015888946891*^9}, {
   3.996016556542562*^9, 3.996016558521834*^9}, {3.9960482761555634`*^9, 
   3.996048295657428*^9}, {3.996048326773518*^9, 3.996048326975976*^9}, {
   3.996049259225135*^9, 3.996049269548728*^9}, {3.9960493138900337`*^9, 
   3.99604933989528*^9}, 3.996055119093539*^9},
 CellID->141025178,ExpressionUUID->"8e5ca796-a4d8-4822-81aa-ad8582e3d7f2"],

Cell["\<\
GWPObject[...][\"Properties\"] returns a complete list of property strings.\
\>", "Notes",
 CellChangeTimes->{{3.996015959385091*^9, 3.9960159880922413`*^9}, {
  3.996016211690778*^9, 3.996016233506873*^9}, {3.996049652671857*^9, 
  3.996049653996049*^9}},
 CellID->1314258775,ExpressionUUID->"a2f1bd24-d4a2-4aec-8a58-1156df31a923"],

Cell["\<\
GWPObject[...][\"PropertyClasses\"] returns a list of property class strings.\
\
\>", "Notes",
 CellChangeTimes->{{3.996015990596923*^9, 3.9960160114499197`*^9}, {
   3.996016129869553*^9, 3.9960161449758177`*^9}, {3.9960162180628967`*^9, 
   3.996016220300701*^9}, 3.996016348991452*^9, {3.996049938727956*^9, 
   3.996049940658372*^9}},
 CellID->146776461,ExpressionUUID->"b2de5159-0871-463f-bd6f-9cc0bb177545"],

Cell[TextData[{
 "GWPObject[...][\"",
 StyleBox["class", "TI"],
 "\"] returns a list of property strings belonging to a particular property \
class."
}], "Notes",
 CellChangeTimes->{{3.996015990596923*^9, 3.9960160114499197`*^9}, {
   3.996016129869553*^9, 3.9960161449758177`*^9}, {3.9960162180628967`*^9, 
