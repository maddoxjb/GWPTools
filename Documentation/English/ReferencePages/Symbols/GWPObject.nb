Cell[CellGroupData[{

Cell["Dynamic Properties Property Extraction", "ExampleSubsubsection",
 CellChangeTimes->{{3.996094036889874*^9, 3.996094041477983*^9}, {
  3.9961051893021317`*^9, 3.996105190576305*^9}, {3.996105290129924*^9, 
  3.996105295460486*^9}},
 CellID->2012514818,ExpressionUUID->"3c8c9691-d86e-40f2-b669-1a683e57acba"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"obj", "=", 
   RowBox[{"GWP", "[", 
    RowBox[{
     RowBox[{"RA", "+", 
      RowBox[{"I", "*", "IA"}]}], ",", "RX", ",", "RP", ",", 
     RowBox[{"RG", "+", 
      RowBox[{"I", "*", "IG"}]}], ",", 
     RowBox[{"\"\<MASS\>\"", "->", "MASS"}], ",", 
     RowBox[{"\"\<HBAR\>\"", "->", "HBAR"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"obj", "[", "\"\<DynamicParameters\>\"", "]"}]}], "Input",
 CellChangeTimes->{{3.996105307329808*^9, 3.996105313605296*^9}},
 CellLabel->"In[686]:=",
 CellID->949883606,ExpressionUUID->"f918d9ac-3798-439c-a59a-2b3bc6459e82"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"ImaginaryPhase\"\>", ",", "\<\"ImaginaryShape\"\>", 
   ",", "\<\"MomentumCenter\"\>", ",", "\<\"PositionCenter\"\>", 
   ",", "\<\"PotentialCoefficients\"\>", ",", "\<\"RealPhase\"\>", 
   ",", "\<\"RealShape\"\>"}], "}"}]], "Output",
 CellChangeTimes->{3.996105314296337*^9},
 CellLabel->"Out[687]=",
 CellID->907448522,ExpressionUUID->"14ff4dd4-f1c0-4c83-b82e-25591cc067f4"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell["Static Property Extraction", "ExampleSubsection",
 CellChangeTimes->{{3.996094036889874*^9, 3.996094041477983*^9}, {
  3.9961051893021317`*^9, 3.996105190576305*^9}},
 CellID->1469105876,ExpressionUUID->"2c98a8b6-0f62-473b-9f45-d540be580a7d"],

Cell[CellGroupData[{

Cell["Units and Scaling", "ExampleSubsection",
 CellChangeTimes->{{3.996093975508415*^9, 3.996093980283119*^9}},
 CellID->592946386,ExpressionUUID->"12616525-a72f-4c65-a9d5-4a6a368c1033"],

Cell["\<\
GWPObject uses atomic units for numerical input and output.  Quantity and \
related functions for units can be used to setup input values in atomic \
units; however, explicit units must be stripped prior to input.\
\>", "ExampleText",
 CellChangeTimes->{{3.99608109048906*^9, 3.996081142994397*^9}, {
   3.996083954362019*^9, 3.996084038367008*^9}, {3.9960840692913094`*^9, 
   3.996084092124613*^9}, {3.996084127600593*^9, 3.996084172122158*^9}, 
   3.9961046060087557`*^9},
 CellID->1806739827,ExpressionUUID->"3e2bac33-529a-41c3-8f04-46d3503963f8"],

Cell["\<\
Defines a set of particle masses in atomic units of mass (i.e., relative to \
the electron mass):\
\>", "ExampleText",
 CellChangeTimes->{
  3.996081081349235*^9, {3.9960811558191137`*^9, 3.9960811808592157`*^9}, {
   3.996082816086162*^9, 3.9960828255989323`*^9}},
 CellID->1803625776,ExpressionUUID->"50c7facc-28a8-45c3-80c5-d1366f9c3932"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"particles", "=", 
  RowBox[{"{", 
   RowBox[{"\"\<Electron\>\"", ",", "\"\<Muon\>\"", ",", "\"\<Proton\>\"", 
    ",", "\"\<Tau\>\"", ",", "\"\<AlphaParticle\>\""}], "}"}]}], "\n", 
 RowBox[{"masses", "=", 
  RowBox[{"Quantity", "/@", 
   RowBox[{"StringInsert", "[", 
    RowBox[{"particles", ",", "\"\<Mass\>\"", ",", 
     RowBox[{"-", "1"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"masses", "=", 
  RowBox[{"masses", "/", 
   RowBox[{"masses", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{
  3.996080312203511*^9, {3.996080364108975*^9, 3.996080364703175*^9}, {
   3.996080484105146*^9, 3.996080504257489*^9}, {3.996081214694767*^9, 
   3.996081218420682*^9}, {3.996082880288659*^9, 3.996082892509571*^9}},
 CellLabel->"In[1182]:=",
 CellID->1410217405,ExpressionUUID->"6fe9739c-b56d-4abf-94a5-df475b622e42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"Electron\"\>", ",", "\<\"Muon\"\>", ",", "\<\"Proton\"\>", 
   ",", "\<\"Tau\"\>", ",", "\<\"AlphaParticle\"\>"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9960803142797413`*^9, {3.996080486493256*^9, 3.996080510127563*^9}, {
   3.996081218971353*^9, 3.996081232962831*^9}, 3.996081390555283*^9, {
   3.9960828848349533`*^9, 3.99608289309454*^9}},
 CellLabel->"Out[1182]=",
 CellID->1646626472,ExpressionUUID->"fdd2b4c6-1c53-44d4-8523-59d49c1b26f1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], 
     SubscriptBox["\"m\"", "\"e\""], "electron mass", "\"ElectronMass\""},
    "Quantity"], ",", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], 
     SubscriptBox["\"m\"", 
      StyleBox["\"\[Mu]\"", Plain, StripOnInput -> False]], "muon mass", 
     "\"MuonMass\""},
    "Quantity"], ",", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], 
     SubscriptBox["\"m\"", "\"p\""], "proton mass", "\"ProtonMass\""},
    "Quantity"], ",", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], 
     SubscriptBox["\"m\"", 
      StyleBox["\"\[Tau]\"", Plain, StripOnInput -> False]], 
     "tau particle mass", "\"TauMass\""},
    "Quantity"], ",", 
   TemplateBox[{
     InterpretationBox["\[InvisibleSpace]", 1], 
     SubscriptBox["\"m\"", 
      StyleBox["\"\[Alpha]\"", Plain, StripOnInput -> False]], 
     "alpha particle mass", "\"AlphaParticleMass\""},
    "Quantity"]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9960803142797413`*^9, {3.996080486493256*^9, 3.996080510127563*^9}, {
   3.996081218971353*^9, 3.996081232962831*^9}, 3.996081390555283*^9, {
   3.9960828848349533`*^9, 3.996082893096229*^9}},
 CellLabel->"Out[1183]=",
 CellID->229356015,ExpressionUUID->"f2ce4017-c049-4ce1-ab65-fbb0f8a5333a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "1", ",", "206.7682827023655854274`7.344697540996344", ",", 
   "1836.1526734215265610731`8.906578314837764", ",", 
   "3477.2275485186253988559`3.8774707867952145", ",", 
   "7294.2995315489056619818`8.912933271759496"}], "}"}]], "Output",
 CellChangeTimes->{
  3.9960803142797413`*^9, {3.996080486493256*^9, 3.996080510127563*^9}, {
   3.996081218971353*^9, 3.996081232962831*^9}, 3.996081390555283*^9, {
   3.9960828848349533`*^9, 3.996082893098484*^9}},
 CellLabel->"Out[1184]=",
 CellID->53397740,ExpressionUUID->"e8556b79-f1d0-4f23-8e51-53f4705d567c"]
}, Open  ]],

Cell["\<\
Convert 1 nm to atomic units (i.e., relative to the Bohr radii):\
\>", "ExampleText",
 CellChangeTimes->{{3.996080731669846*^9, 3.996080763486237*^9}, {
  3.996080960492236*^9, 3.996081037513324*^9}, {3.996081249279784*^9, 
  3.9960812525976954`*^9}, {3.996081300469091*^9, 3.996081301231284*^9}, {
  3.996082910808333*^9, 3.996082985129118*^9}},
 CellID->991042757,ExpressionUUID->"df31765e-e620-4519-8d1d-229814395379"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"UX0", "=", 
  RowBox[{"QuantityMagnitude", "@", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"\"\<Nanometers\>\"", ",", "\"\<BohrRadius\>\""}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9960789224233418`*^9, 3.996078959741087*^9}, {
  3.996079589330357*^9, 3.996079605338764*^9}, {3.996079925262267*^9, 
  3.99607992724937*^9}, {3.996080531240017*^9, 3.9960807145971212`*^9}, {
  3.996080939763254*^9, 3.9960809552068377`*^9}, {3.996081256300852*^9, 
  3.9960812605248013`*^9}, {3.996081321554628*^9, 3.99608136606868*^9}},
 CellLabel->"In[1185]:=",
 CellID->1548105127,ExpressionUUID->"18a9b9b0-b5fb-47dd-b35e-ce62f7b174f1"],

Cell[BoxData["18.897261246257701551`9.519481150304392"], "Output",
 CellChangeTimes->{
  3.996080955918476*^9, 3.996081261399827*^9, {3.9960813366951847`*^9, 
   3.9960813615319643`*^9}, 3.996082967243183*^9},
 CellLabel->"Out[1185]=",
 CellID->382351480,ExpressionUUID->"ee24df88-f5dc-4287-aeae-d268815e7b6a"]
}, Open  ]],

Cell["\<\
Convert 1 ns to atomic units (i.e., relative to the period of an electron's \
orbit in the Bohr model for the ground state of a hydrogen atom):\
\>", "ExampleText",
 CellChangeTimes->{{3.996083175134644*^9, 3.996083436415496*^9}},
 CellID->1757721966,ExpressionUUID->"4cea498c-68e9-4925-9e8a-204cbbadeab3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"TAU", "=", 
  RowBox[{"QuantityMagnitude", "@", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"\"\<Nanoseconds\>\"", ",", "\"\<AtomicUnitOfTime\>\""}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9960834530614243`*^9, 3.9960835003895407`*^9}},
 CellLabel->"In[1192]:=",
 CellID->317075752,ExpressionUUID->"14b4f233-4149-4423-afc3-0d732a70e5a6"],

Cell[BoxData["4.13413733351821122237873794`11.41048724687186*^7"], "Output",
 CellChangeTimes->{
  3.996080947971346*^9, {3.9960834884658613`*^9, 3.996083501119207*^9}},
 CellLabel->"Out[1192]=",
 CellID->981318433,ExpressionUUID->"6b2efab0-3bd9-48c9-bd77-57d73705bf9d"]
}, Open  ]],

Cell["\<\
Generate expressions for the free particle position uncertainties (nm) as a \
function of time (ns): \
\>", "ExampleText",
 CellChangeTimes->{{3.996080814777835*^9, 3.996080848171658*^9}, {
  3.996080880026339*^9, 3.9960809055825*^9}, {3.996083023901804*^9, 
  3.996083049606617*^9}, {3.996083109174034*^9, 3.996083139316003*^9}, {
  3.996083677260262*^9, 3.996083713377187*^9}},
 CellID->1988468683,ExpressionUUID->"608cc585-269d-4611-bc06-fcd7395e2b9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"UXT", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"GWP", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"UX0", ",", "0"}], "}"}], ",", 
       RowBox[{"\"\<MASS\>\"", "\[Rule]", "masses"}]}], "]"}], 
     "[", "\"\<PositionUncertainty\>\"", "]"}], "[", "t", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"UXT", "=", 
   RowBox[{
    RowBox[{"UXT", "/", "UX0"}], "/.", 
    RowBox[{"t", "\[Rule]", 
     RowBox[{"t", "*", "TAU"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9960835466635857`*^9, 3.9960835493174753`*^9}, {
  3.996083608939754*^9, 3.996083611698407*^9}, {3.9960836616954308`*^9, 
  3.996083670152837*^9}},
 CellLabel->"In[1210]:=",
 CellID->344494471,ExpressionUUID->"a61c7048-41ed-423f-abe7-d0ddfa4a1468"],

Cell["Make a LogPlot of the uncertainties:", "ExampleText",
 CellChangeTimes->{{3.9960838789564533`*^9, 3.996083889835659*^9}},
 CellID->454833488,ExpressionUUID->"9b4b650e-ca3b-46d2-b44e-fa4318184b3f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LogPlot", "[", 
  RowBox[{"UXT", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
   RowBox[{"FrameLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<time / ns\>\"", ",", "\"\<\[CapitalDelta]x / nm\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", "particles"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.996075361151927*^9, 3.996075378820163*^9}, {
  3.99607792132598*^9, 3.996077945652347*^9}, {3.9960780810515003`*^9, 
