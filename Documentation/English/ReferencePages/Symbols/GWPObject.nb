 RowBox[{"Sequence", "[", 
  RowBox[{"RA", ",", "IA", ",", "RX", ",", "RP", ",", "RG", ",", "IG", ",", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     FractionBox["IG", "HBAR"]], " ", 
    SuperscriptBox[
     RowBox[{"(", 
