Cell["\<\
The momentum parameter may be specified in different formats:\
\>", "Notes",
 CellChangeTimes->{{3.995665789034937*^9, 3.9956658076251297`*^9}, {
  3.995669768252687*^9, 3.9956697692534533`*^9}, {3.9959154750204983`*^9, 
