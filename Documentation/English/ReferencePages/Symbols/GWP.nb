Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["7"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "x"}], ")"}], "2"]}], "-", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "x"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "y"}], ")"}]}], "-", 
     RowBox[{"4", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "y"}], ")"}], "2"]}]}]]}], 
  "\[Pi]"]], "Output",
 CellChangeTimes->{4.00041315074094*^9},
 CellLabel->"Out[6]=",
 CellID->1066563502,ExpressionUUID->"1456f767-2b7a-4540-90db-98217ab02778"]
}, Open  ]]
