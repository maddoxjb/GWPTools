Cell["The phase parameter may be specified in different formats:", "Notes",
 CellChangeTimes->{{3.995665816223916*^9, 3.995665831231862*^9}, {
  3.995672961715774*^9, 3.995672965767316*^9}, {3.9959154616686363`*^9, 
  3.9959154802390423`*^9}, {3.996014172516452*^9, 3.996014173350963*^9}},
 CellID->1257326586,ExpressionUUID->"8461c62a-209b-448e-993e-37aa390dbaca"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "81d388e2-3fb4-4a3d-9619-e90fc84a9902"], "RG", Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "3b1e9f59-cb6c-4ce7-bd7d-325e6e06de8b"],
     " is taken to be real-valued."
    }], "TableText",ExpressionUUID->"3f34afc1-567f-439e-a119-d05e858f5509"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "73290391-46b5-4a8b-b656-2333aaec3df1"], 
    RowBox[{"RG", "+", 
     RowBox[{"I", "*", "IG"}]}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "586c8376-cbf6-47a0-a715-1f65413e76e9"],
     " is taken to be complex-valued."
    }], "TableText",ExpressionUUID->"c59fedf1-75c1-4511-b911-3410e97342d6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1f2b804a-a06c-408d-82a9-9557e962d20c"], 
    RowBox[{"{", 
     RowBox[{"\"\<Action\>\"", ",", "S", ",", "MU"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "38a3571f-cab4-4d78-b947-93e72f1d338f"],
     " is calculated from the semiclassical action ",
     StyleBox["S", "InlineCode"],
     " along a trajectory with Maslov index ",
     StyleBox["MU", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"8e4695b6-30e4-4855-9d24-1d38503f40b4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "05aec666-4959-4b25-b241-9cc4932b8600"], 
    RowBox[{"{", 
     RowBox[{"\"\<Action\>\"", ",", "S"}], "}"}], Cell[
    "Uses a default Maslov index of zero.", "TableText",ExpressionUUID->
     "6dbee66f-61c1-4991-a4f5-b86b145eaf10"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "99f5aee3-e872-4417-af53-8ce9280326de"], 
    RowBox[{"{", 
     RowBox[{"\"\<Displacement\>\"", ",", 
      SubscriptBox["X", "0"], ",", 
      SubscriptBox["P", "0"]}], "}"}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "360786e0-a8ef-4913-8876-e04a76b6e460"],
     " is calculated from the phase shift associated with a translation from \
a point (",
     Cell[BoxData[
      SubscriptBox["X", "0"]], "InlineFormula",ExpressionUUID->
      "b2cfabe0-bafd-4be9-a9ea-d0830fde348b"],
     ",",
     Cell[BoxData[
      SubscriptBox["P", "0"]], "InlineFormula",ExpressionUUID->
      "eb7820e9-7bc3-4b96-b65d-c960e2e8931e"],
     ") to the wavepacket's phase space center."
    }], "TableText",ExpressionUUID->"9471eaa8-dff9-43c2-8176-d25a39d8122c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "20e3068f-3138-498d-b4c1-335bcd842604"], 
    RowBox[{"{", 
     RowBox[{"\"\<Coefficient\>\"", ",", "THETA", ",", "Amp"}], "}"}], Cell[
    TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "6c54c15c-dce0-4433-b0e0-d635c29294a7"],
     " is calculated from a complex coefficient with phase angle ",
     StyleBox["THETA", "InlineCode"],
     " and amplitude ",
     StyleBox["Amp", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"a05c3245-61c0-4e02-8069-0e838c16eff6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4fd3e02d-3bae-4d44-8cc1-ff8523968d0b"], 
    RowBox[{"{", 
     RowBox[{"\"\<Evolution\>\"", ",", "EE", ",", "TAU"}], "}"}], Cell[
    TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Gamma]", "\[Prime]"]], "InlineFormula",ExpressionUUID->
      "60ea8a32-7f2d-447d-bf50-7ab52c9c698c"],
     " is calculated from the phase factor for a stationary state with \
eigenenergy ",
     StyleBox["EE", "InlineCode"],
     " at time ",
     StyleBox["TAU", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"2457e1a6-bab7-4287-b6c9-5cb38be74c58"]}
  }]], "2ColumnTableMod",
