      FormatType->StandardForm,ExpressionUUID->
      "784717de-0624-4884-bb8d-fb365ebadcc7"],
     " is taken to be complex-valued."
    }], "TableText",ExpressionUUID->"35bed03d-0fd0-40f2-a7ef-dd9cd210aa8f"]}
  }]], "2ColumnTableMod",
