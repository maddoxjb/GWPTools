 CellID->985901439,ExpressionUUID->"85bb4560-923c-45e7-8fa4-7e2f65beacbe"],

Cell[TextData[{
 "The single-primed arguments may be complex-valued numbers or symbolic \
expressions and are separated into real and imaginary components using ",
 StyleBox["ComplexExpand", "InlineCode"],
 ".  Complex-valued input expressions, therefore, must explicitly contain the \
imaginary unit (",
 StyleBox["I", "InlineCode"],
 " or ",
 StyleBox["\[ImaginaryI]", "InlineCode"],
 ")."
}], "Notes",
 CellChangeTimes->{{3.995713880564437*^9, 3.9957139689359627`*^9}, {
   3.995714021055604*^9, 3.995714376277623*^9}, 3.995714453039851*^9, 
   3.995715114349195*^9, {3.995715184365108*^9, 3.995715185071766*^9}, {
   3.9957154977103777`*^9, 3.995715508957983*^9}, {3.99571571515699*^9, 
   3.995715717908772*^9}, 3.9957157512167177`*^9, {3.9957158201481047`*^9, 
   3.99571582985075*^9}, {3.995716123190771*^9, 3.99571612512403*^9}, {
   3.9957163971253147`*^9, 3.995716409093912*^9}, 3.995716450510417*^9, {
   3.995718432984496*^9, 3.9957184520974903`*^9}, {3.995872636072707*^9, 
   3.9958726365136538`*^9}, {3.995877227562008*^9, 3.995877266268125*^9}, {
   3.995913993326385*^9, 3.995913999590736*^9}, {3.995914643049292*^9, 
   3.995914683861018*^9}, {3.995914993233383*^9, 3.995915000970621*^9}, {
   3.9959150354361877`*^9, 3.995915057226961*^9}, {3.9960122639257107`*^9, 
   3.9960122831208153`*^9}, 3.9960123203530617`*^9, {3.996013386940241*^9, 
   3.996013393335703*^9}, {3.996013868344605*^9, 3.996013871050535*^9}},
 CellID->1050554093,ExpressionUUID->"8f971747-1501-4f1a-834c-32f8e7ea30c5"],

Cell[TextData[{
 "The single-primed input parameters are algebraically rearranged to form new \
set of parameters ",
 Cell[BoxData[
  SuperscriptBox["\[Alpha]", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "8b03940e-39b6-4d54-9490-295e3624cd23"],
 ", ",
 Cell[BoxData[
  SuperscriptBox["x", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "1ec4a409-cc18-4c0d-8932-ed4f2e01aace"],
 ", ",
 Cell[BoxData[
  SuperscriptBox["p", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "24bc46e9-6811-44a7-b5cf-a245c9a66618"],
 ", and ",
 Cell[BoxData[
  SuperscriptBox["\[Gamma]", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "2256c735-069a-48df-8d43-d9aa7163aefc"],
 ", where ",
 Cell[BoxData[
  SuperscriptBox["x", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "02040231-eb06-4dea-8940-8494688252e9"],
 " and ",
 Cell[BoxData[
  SuperscriptBox["p", "\[Prime]\[Prime]"]], "InlineFormula",
  FormatType->StandardForm,ExpressionUUID->
  "2c936db2-5b76-4010-96d7-e634fd9f7732"],
 " are real-valued numbers or expressions.  These double-primed quantities \
are used as the initial values for the GWP parameters. "
}], "Notes",
 CellChangeTimes->{{3.995714463455203*^9, 3.995714510112011*^9}, {
   3.995715212760765*^9, 3.995715213259967*^9}, {3.995716192546689*^9, 
   3.995716220768099*^9}, {3.995716427582993*^9, 3.9957164692724047`*^9}, 
   3.995718457606266*^9, {3.995872728505487*^9, 3.995872729987302*^9}, {
   3.995914055786359*^9, 3.995914057307575*^9}, {3.9959146993044987`*^9, 
   3.995914821692923*^9}, {3.995915061290936*^9, 3.995915090184146*^9}, {
   3.9959158921857452`*^9, 3.995915962190372*^9}, {3.996012389765697*^9, 
   3.99601246911893*^9}, {3.996012502964861*^9, 3.996012520744535*^9}, {
   3.9960139567289267`*^9, 3.996014147830659*^9}},
 CellID->1162928782,ExpressionUUID->"3125f4bf-6814-4e57-a450-a8d47237868a"],

Cell["The shape parameter may be specified in different formats:", "Notes",
 CellChangeTimes->{{3.995664528114892*^9, 3.995664545969861*^9}, {
  3.995665779971313*^9, 3.995665781404023*^9}, {3.9956660209220963`*^9, 
