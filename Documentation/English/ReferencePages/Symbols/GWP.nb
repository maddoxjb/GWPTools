Cell["\<\
A shape parameter with a non-positive real part represents a wavepacket that \
blows up at infinity. The constructor will catch this, emit a warning, and \
abort:\
\>", "ExampleText",
 CellChangeTimes->{3.995994465901168*^9},
 CellID->168331745,ExpressionUUID->"87555bff-776c-4b17-9b5b-49f2d1c1cbb5"],

