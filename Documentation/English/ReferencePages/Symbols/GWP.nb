Cell["\<\
Gaussian wavepackets (GWPs) are a class of exact solutions to the \
time-dependent Schr\[ODoubleDot]dinger equation for systems where the \
external potential field is a quadratic function of the spatial coordinate(s).\
\>", "Notes",
 CellChangeTimes->{{3.996013180158967*^9, 3.996013265499043*^9}, {
   3.9960133462562437`*^9, 3.9960133482878313`*^9}, {3.996013778236422*^9, 
   3.99601380188265*^9}, {3.997701070488532*^9, 3.9977010740942783`*^9}, {
   3.997702120544402*^9, 3.9977021227407722`*^9}, {3.997708505622137*^9, 
   3.997708506646584*^9}, {3.99770939775668*^9, 3.997709406363513*^9}, {
   3.9977212292965508`*^9, 3.997721255915674*^9}, {3.997721382060944*^9, 
   3.9977213868726788`*^9}, {3.9977214598386917`*^9, 3.997721469663706*^9}, {
   3.9977215587899323`*^9, 3.997721571976383*^9}, 3.997721602452627*^9, {
   3.997721693204816*^9, 3.997721701833682*^9}, {3.9977295728195333`*^9, 
   3.997729659584654*^9}, {3.997729693729969*^9, 3.997729695186762*^9}},
 CellID->414192942,ExpressionUUID->"a94eaef8-d3b5-4666-986c-941589f8c6d6"],

Cell[TextData[{
 "GWP[",
 StyleBox["type", "TI"],
 "][",
 StyleBox["parameters", "TI"],
 ", ",
 StyleBox["options", "TI"],
 "] returns a GWPObject representing a GWP with the specified type, \
parameters, and options. "
}], "Notes",
 CellChangeTimes->{{3.997723645363037*^9, 3.9977237371440496`*^9}, 
   3.99772459567635*^9, {3.997724813659898*^9, 3.99772481689675*^9}, 
