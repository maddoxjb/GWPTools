   {Cell["      ", "ModInfo",ExpressionUUID->
     "29ddd575-d7b3-4c51-8a88-315a97b80677"], "Automatic", Cell[
    "Displays the input parameters and potential.", "TableText",
     ExpressionUUID->"ffeaeb1d-4559-4ead-86be-dea5cbd767c9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a69e1de1-d9a9-4cb9-b6b1-9559ccc1b32a"], "\"\<Association\>\"", Cell[
    "Displays the raw association data for the GWPObject", "TableText",
