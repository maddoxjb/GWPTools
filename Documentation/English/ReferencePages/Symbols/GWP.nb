   {Cell["   ", "ModInfo",ExpressionUUID->
     "4d1fb098-5690-4eeb-967e-626168129cc5"], "\"\<HBAR\>\"", "1", Cell[
    "Specifies the reduced Planck constant.", "TableText",ExpressionUUID->
     "44c1e2ba-b390-49f7-a027-dba9f85ee406"]},
   {Cell["   ", "ModInfo",ExpressionUUID->
     "c4c833d9-4516-438d-bf15-a5dfca34697c"], "\"\<Summary\>\"", "Automatic", 
    Cell[TextData[{
     "Controls the formatting of ",
     StyleBox["GWPObject", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"0e62d6e7-ac89-4134-97f2-ac43b08ab730"]}
  }]], "3ColumnTableMod",
 CellChangeTimes->{{3.995658024754869*^9, 3.995658100693696*^9}, {
