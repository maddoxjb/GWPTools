Cell["\<\
The \"Potential\" option accepts a structural template mapping to an \
analytical propagator. Zero-parameter models (e.g., \"Free\") accept a simple \
string, while parameterized models require a tagged list (e.g., \
{\"Harmonic\", omega}).\
\>", "Notes",
 CellChangeTimes->{{3.995837871867076*^9, 3.995837901275324*^9}, {
   3.995838321783267*^9, 3.9958383235629787`*^9}, {3.995872839851708*^9, 
   3.99587301058144*^9}, {3.995873096643362*^9, 3.995873294090515*^9}, {
   3.995873514744928*^9, 3.995873515468979*^9}, {3.995874379627851*^9, 
   3.995874389809317*^9}, {3.99587451749222*^9, 3.995874541353467*^9}, 
   3.9958747652232313`*^9, {3.99770234206143*^9, 3.997702351183519*^9}, {
   3.997702388408208*^9, 3.997702402411989*^9}, {3.99772583978683*^9, 
   3.9977258439204473`*^9}, {3.997730294697033*^9, 3.997730311565023*^9}, {
   3.9977516436758013`*^9, 3.997751654861002*^9}, 3.998647378452971*^9, {
   3.9986474784916553`*^9, 3.9986474795187187`*^9}},
 CellID->1436737754,ExpressionUUID->"e04d637b-1d12-46a0-a9e3-1680a5fa8143"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "63ad9cf0-07e6-45d9-8576-a5da7dc257f5"], 
    StyleBox[
     RowBox[{
      RowBox[{"GWP", "[", "\"\<1D\>\"", "]"}], "[", "\"\<PotentialModels\>\"",
       "]"}], "InlineCode"], Cell["\<\
Lists the exact input templates required for the active engine. \
\>", "TableText",ExpressionUUID->"854268cc-1eff-4954-8a96-62e46efd9de2"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.995873423382725*^9, 3.9958734376936703`*^9}, {
  3.995873467781039*^9, 3.99587349312857*^9}, {3.9958735466131268`*^9, 
  3.995873708780081*^9}, {3.995884290518448*^9, 3.995884290518559*^9}, {
  3.996014234446447*^9, 3.996014277195429*^9}, {3.99770237646916*^9, 
  3.9977024277744102`*^9}, {3.9977086961064796`*^9, 3.997708702571601*^9}, {
  3.99772601832521*^9, 3.997726030386306*^9}, {3.997728674983962*^9, 
  3.997728711422534*^9}, {3.99773019014268*^9, 3.997730230006671*^9}, {
  3.9977303307130747`*^9, 3.997730339889727*^9}, {3.99864739488161*^9, 
  3.998647462766747*^9}},
 CellID->1399749105,ExpressionUUID->"23254e88-d76c-4ab3-a13d-2aab5154782d"],

Cell["\<\
The \"MASS\" and \"HBAR\" options accept real-valued positive numbers or \
symbols.  The package is not designed to support inputs that use Quantity.\
\>", "Notes",
 CellChangeTimes->{{3.997725907509799*^9, 3.9977259642964478`*^9}, {
  3.997730562543893*^9, 3.99773058999308*^9}},
 CellID->720853258,ExpressionUUID->"79264dd1-30ae-4d29-a968-b9cbf016158f"],

Cell["\<\
The \"Summary\" option controls the visual layout of the returned GWPObject \
and has the following values:\
\>", "Notes",
 CellChangeTimes->{{3.995874591953106*^9, 3.99587467195682*^9}, {
  3.9960143286354523`*^9, 3.9960143485108843`*^9}, {3.997725847171298*^9, 
  3.9977258580615664`*^9}, {3.997751689915228*^9, 3.997751703462916*^9}},
 CellID->1745919061,ExpressionUUID->"9918f1d1-168e-4d7d-8470-af68d5383bdb"],

