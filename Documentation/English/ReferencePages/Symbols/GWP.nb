Cell["The following options can be given: ", "Notes",
 CellID->1056544180,ExpressionUUID->"8dc7d04d-8d65-48df-966b-5feae0f0026e"],

Cell[BoxData[GridBox[{
   {Cell["   ", "ModInfo",ExpressionUUID->
     "d532191a-e7fd-458f-96ec-66d39dc4a1af"], "\"\<Potential\>\"", "None", 
    Cell["Specifies the external potential energy field.", "TableText",
     ExpressionUUID->"9304a209-082a-4f3e-aebb-1a97e0dca8fc"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "88549303-bae7-418c-96b3-6752b12ecfdf"], "\"\<MASS\>\"", "1", Cell[
