     ExpressionUUID->"1385e879-ac71-412b-a0a9-dd1ca2af7c47"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.995874811673786*^9, 3.9958748853509903`*^9}, {
  3.995876615904091*^9, 3.995876762689842*^9}, {3.995877117108135*^9, 
  3.9958771171082773`*^9}, {3.9977025214304323`*^9, 3.9977025638890533`*^9}, {
  3.99773062932384*^9, 3.997730642411723*^9}, {3.997731162218583*^9, 
  3.997731163325653*^9}},
 CellID->1184512428,ExpressionUUID->"44462ec4-e0ba-4383-8d1f-b911e6db39e2"],

Cell["\<\
GWP[\"Types\"] is a global query that lists all registered GWP types.\
\>", "Notes",
 CellChangeTimes->{{3.9986489844570093`*^9, 3.998649006422944*^9}, {
  3.998649240374566*^9, 3.9986492486727333`*^9}},
 CellID->2034924938,ExpressionUUID->"23880f17-c6db-446d-aab7-5e608ee88586"],

Cell[TextData[{
 "GWP[",
 StyleBox["type", "TI"],
 "][",
 StyleBox["query", "TI"],
 "] is used for introspective queries for a particular type.  Note that \
without the type argument GWP[",
 StyleBox["query", "TI"],
 "] queries the default \"1D\" type."
}], "Notes",
 CellChangeTimes->{{3.997730683003048*^9, 3.997730726502899*^9}, {
  3.99775175083663*^9, 3.997751751802291*^9}, {3.9986490105222473`*^9, 
  3.998649019542412*^9}, {3.99864905183832*^9, 3.998649102028528*^9}, {
  3.998649142361047*^9, 3.9986492235197372`*^9}, {3.998649267399226*^9, 
  3.99864928204674*^9}},
 CellID->1034766671,ExpressionUUID->"36651bb0-2f37-48ed-a53f-006fe74ae8e6"],

Cell[TextData[{
 "GWP[",
 StyleBox["type", "TI"],
 "][",
 StyleBox["query", "TI"],
 ",",
 StyleBox["class", "TI"],
 "] is used for introspective queries filtered by class."
}], "Notes",
 CellChangeTimes->{{3.997730683003048*^9, 3.997730726502899*^9}, {
  3.99775175083663*^9, 3.997751751802291*^9}, {3.9986490105222473`*^9, 
  3.998649019542412*^9}, {3.99864905183832*^9, 3.998649102028528*^9}, {
  3.998649142361047*^9, 3.998649142866486*^9}, {3.998649288810686*^9, 
  3.998649305531061*^9}},
 CellID->1636536932,ExpressionUUID->"cb85c719-a7c4-48a5-ac3e-5402a1e5a2c2"],

Cell["The following lists the possible strings for queries:", "Notes",
 CellChangeTimes->{{3.998649313926034*^9, 3.9986493539586973`*^9}},
 CellID->1056105892,ExpressionUUID->"62c6e704-7720-47e7-af13-f3efbe21f60c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "6333102f-ad02-4f9f-b76a-492032c0bc82"], Cell[
    "\"Classes\"", "TableText",ExpressionUUID->
     "3cc691e6-1f54-40ec-be4a-51d106a2eb25"], Cell[
    "List all registered property classes.", "TableText",ExpressionUUID->
     "3ec1912a-7587-4504-93bf-e495c8ae8fe1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e9debed-1cd4-429d-852b-219fefce189c"], Cell[
    "\"Properties\"", "TableText",ExpressionUUID->
     "219130a3-ddfb-4872-b9a5-99bc1bdc3ed2"], Cell[
    "List all registered properties.", "TableText",ExpressionUUID->
     "33acba6a-0d5f-45b5-b424-2e75fac0a94d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c9ac18b3-9c47-4a6c-9fb1-e95e377eb19d"], Cell[
    "\"ShortKeys\"", "TableText",ExpressionUUID->
     "7d78048f-5f7f-4260-a109-1be63639c234"], Cell["\<\
List the abbreviated macro keys for all registered properties. \
\>", "TableText",ExpressionUUID->"0de20525-b835-4cb2-845f-71cfaa1e7930"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ba8bc9db-7c2e-4c7b-9caa-89cc351a43a4"], Cell[
    "\"PotentialModels\"", "TableText",ExpressionUUID->
     "842b5d91-7a1f-4b58-9a28-6ced0c0299d5"], Cell["\<\
List the structural input templates required to instantiate the active \
engine's potential models.\
\>", "TableText",ExpressionUUID->"49a8d422-06ef-444b-a479-c28ed7986075"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9cfbc981-f29d-4fbb-9571-2864e8148e56"], Cell[
    "\"Records\"", "TableText",ExpressionUUID->
     "7b04c66f-3c66-4ef3-b800-5b64958530b6"], Cell["\<\
Returns the complete property registry metadata as an association.\
\>", "TableText",ExpressionUUID->"2557f57d-0d7a-4a7e-a23f-9dba84b479e6"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d6a2f9a5-8ae1-45da-ba7f-a1d4a8ef4364"], Cell[
    "\"PotentialRecords\"", "TableText",ExpressionUUID->
     "41772865-6609-4f50-b971-cc65ef8bdabc"], Cell["\<\
Returns the complete potential models registry as an association.\
\>", "TableText",ExpressionUUID->"1a99eb2a-d0c4-442c-9d84-9cc0a96e4c57"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dd5e0bcb-8419-4352-a630-7738dc60ac13"], Cell[
    "\"Signatures\"", "TableText",ExpressionUUID->
     "695e5907-1098-4362-964f-cc766836c93f"], Cell["\<\
Returns the complete taxonomy of dynamic and static signature classifications.\
\>", "TableText",ExpressionUUID->"f84ff272-8e17-45ea-900a-215220003606"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8873a619-814b-4efe-a258-0d8215ae1687"], Cell[
    "\"SignatureClasses\"", "TableText",ExpressionUUID->
     "8934b262-8adc-40b0-8206-9e3ccc8b83be"], Cell["\<\
List all available signature mappings (e.g., \"Temporal\", \"Spatial\")\
\>", "TableText",ExpressionUUID->"ab207fce-cfbb-43bc-b1b6-b69d2cdae8da"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "61044c8f-1826-4642-bc89-b6e1ed3b8785"], Cell[
    "\"DynamicClasses\"", "TableText",ExpressionUUID->
     "ba2aceeb-0271-4f41-bcf0-7c6044531577"], Cell["\<\
List the specific signature classifications used when an external potential \
is driving the wavepacket.\
\>", "TableText",ExpressionUUID->"d7935df5-5aaa-4daf-acd5-8b4b6e40a06b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bfd93abd-9486-4c68-a7a0-7122ec1cbe7d"], Cell[
    "\"StaticClasses\"", "TableText",ExpressionUUID->
     "e81d2cd8-4f5a-4bbd-808b-74088cb9006a"], Cell["\<\
List the specific signature classifications used when the wavepacket is \
evaluated without an active potential.\
\>", "TableText",ExpressionUUID->"9976a8d6-1c2f-4cc0-9650-f5aa55e5194f"]}
  }]], "2ColumnTableMod",
