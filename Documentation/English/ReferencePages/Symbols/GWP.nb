  3.995914510465274*^9}, {3.996012217287093*^9, 3.996012222449965*^9}, {
  3.9960133770581837`*^9, 3.996013377948688*^9}, {3.996013835903057*^9, 
  3.996013840960038*^9}},
 CellID->1614505848,ExpressionUUID->"2458df84-6655-4498-8eb4-20c74a76672a"],

