    RowBox[{"1", "/", "2"}], ",", "1"}], "}"}], "]"}]], "Input",
 CellChangeTimes->{{3.9959945520431747`*^9, 3.995994559385721*^9}},
 CellLabel->"In[9]:=",
 CellID->95257790,ExpressionUUID->"41c664a4-048f-4b14-bbcb-d62a39fb5deb"],

Cell[BoxData[
 TemplateBox[{
  "GWPTools`Private`GWP486", "complexia", 
   "\"The calculated imaginary shape parameter IA = \
\\!\\(\\*FractionBox[RowBox[{\\\"\[ImaginaryI]\\\", \\\" \\\", \
SqrtBox[\\\"3\\\"]}], \\\"2\\\"]\\) must be strictly real. Check your \
uncertainty bounds.\"", 2, 9, 3, 34076802476654923909, "Local", 
   "GWPTools`Private`GWP486"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.995994561020117*^9},
