   {Cell["      ", "ModInfo",ExpressionUUID->
     "cd8a5d1c-b155-4249-b736-f83dabac5cd5"], "Automatic", Cell["\<\
Displays the raw initial parameters, mass, and Planck constant.\
\>", "TableText",ExpressionUUID->"78031e30-721b-47b4-9aa4-66bbda8f2dba"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
