Cell[TextData[{
 "The arguments may be complex-valued numbers or symbolic expressions. \
Complex-valued expressions must explicitly contain the imaginary unit, e.g., ",
 StyleBox["A=RA+I*IA", "InlineCode"],
 "."
}], "Notes",
