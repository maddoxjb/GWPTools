   {Cell["      ", "ModInfo",ExpressionUUID->
     "6ec64607-c37b-4de4-8dce-b78fb0661b44"], "\"\<Energy\>\"", Cell["\<\
Displays initial kinetic, potential, and total energy decomposition.\
\>", "TableText",ExpressionUUID->"a84672b5-8d7c-4ecf-9b67-b52b3be18f9d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4a8b8a8b-84ca-49ea-903b-cff228ec1ea6"], "None", Cell[
