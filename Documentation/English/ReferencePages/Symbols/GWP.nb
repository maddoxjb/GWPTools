Notebook[{

Cell[CellGroupData[{
Cell["GWP", "ObjectName",
 CellID->428668562,ExpressionUUID->"7712ccdc-5254-4a99-b86f-0f539ed62242"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c22d9ca9-4aaa-4175-89ed-03c57f3b7dc6"],
 Cell[BoxData[
  RowBox[{"GWP", "[", "...", "]"}]], "InlineFormula",ExpressionUUID->
  "f3770456-f4f2-4e75-887e-5080842982b2"],
 "\[LineSeparator]returns a GWPObject representing a generalized Gaussian \
wavepacket."
}], "Usage",
 CellChangeTimes->{
  3.32361883463229*^9, 3.32766004026563*^9, 3.32766011595313*^9, 
   3.3278782058635*^9, 3.32958951928125*^9, {3.387566565476775*^9, 
   3.387566576423758*^9}, {3.996011535190351*^9, 3.996011623259041*^9}},
 CellID->7970,ExpressionUUID->"fb67ace9-e758-4167-b666-1366e8cb8cf7"],

Cell[TextData[{
 "The wavefunction for a generalized 1D Gaussian wavepacket (GWP) is a \
function of a spatial coordinate ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "c1c88b53-9316-405b-ac07-e6674716ee78"],
 " and time ",
 Cell[BoxData[
  FormBox["t", TraditionalForm]], "InlineMath",ExpressionUUID->
  "617aef56-ab53-4f6d-a95c-b276fa786340"],
 ":"
}], "Notes",
 CellChangeTimes->{{3.995658891135318*^9, 3.995658960232605*^9}, {
   3.9956590552869883`*^9, 3.995659057836286*^9}, {3.995659103196945*^9, 
   3.99565913588701*^9}, {3.9956592713271933`*^9, 3.9956593006038837`*^9}, {
   3.995659331713306*^9, 3.995659332200779*^9}, {3.995659371730562*^9, 
   3.995659391321003*^9}, {3.995659446588147*^9, 3.9956594603848257`*^9}, {
   3.995659631595449*^9, 3.995659676549073*^9}, {3.9956604720507593`*^9, 
   3.995660485241352*^9}, {3.99566059181257*^9, 3.99566059438868*^9}, {
   3.995660788164044*^9, 3.995660821838627*^9}, 3.995713103207219*^9, {
   3.995913737270719*^9, 3.99591375963691*^9}, {3.9960114242427387`*^9, 
   3.9960114927746553`*^9}, {3.996011631265321*^9, 3.996011661685117*^9}, {
   3.996012187504705*^9, 3.996012188691307*^9}, {3.996012993548625*^9, 
   3.9960130049419613`*^9}},
 CellID->1791262317,ExpressionUUID->"f10a3327-5c1a-49d1-aa2e-cd2197f063bd"],

Cell[TextData[Cell[BoxData[
 FormBox[
  StyleBox[
   RowBox[{
    RowBox[{"\[Psi]", "(", 
     RowBox[{"x", ",", "t"}], ")"}], "=", 
    RowBox[{"N", " ", 
     RowBox[{"exp", "(", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox[
         RowBox[{
          SubscriptBox["\[Alpha]", "t"], "(", 
          RowBox[{"x", "-", 
           SubscriptBox["x", "t"]}], ")"}], "2"]}], "+", 
       RowBox[{
        FractionBox["\[ImaginaryI]", "\[HBar]"], 
        RowBox[{
         SubscriptBox["p", "t"], "(", 
         RowBox[{"x", "-", 
          SubscriptBox["x", "t"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["\[ImaginaryI]", "\[HBar]"], 
        SubscriptBox["\[Gamma]", "t"]}]}], ")"}]}]}],
   FontSize->18], 
  TraditionalForm]], \
"InlineMath",ExpressionUUID->"b1ea8d13-1e62-4301-bec9-c5ed9530a29f"]], \
"ExampleText",
 CellChangeTimes->{{3.995660491937461*^9, 3.9956605349707336`*^9}},
 CellID->1682658282,ExpressionUUID->"f25f5d67-db71-4af6-8e27-83077aafe732"],

Cell[TextData[{
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineMath",ExpressionUUID->
  "47bb0bdd-d42e-464e-bc8d-c4eba004aca7"],
 " is a time-independent normalization factor, the parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "t"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"84b5d2fe-35ee-43ab-9cea-a60d55413b9f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "t"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "d3f5a072-42df-4f11-96bb-6c688599cdb3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["p", "t"], TraditionalForm]], "InlineMath",ExpressionUUID->
  "a5693108-1277-4912-9f5d-fb4f886abd2d"],
 ", and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "t"], TraditionalForm]], "InlineMath",
  ExpressionUUID->"1cba6266-e23d-4864-a4f8-7948f281df83"],
 " are time-dependent functions, and ",
 Cell[BoxData[
  FormBox["\[HBar]", TraditionalForm]], "InlineMath",ExpressionUUID->
  "8bb4b062-a600-406e-a981-c3fb50e852c9"],
 " is the reduced Planck constant."
}], "Notes",
 CellChangeTimes->{{3.996011691182488*^9, 3.996011726120281*^9}, {
  3.996012000946913*^9, 3.996012012707612*^9}, {3.996012556940135*^9, 
  3.996012560772909*^9}},
 CellID->81347581,ExpressionUUID->"bd4a3440-1e01-47d3-85c1-2cc534aa1ee3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "470d82fc-e396-4237-8fa3-93eb296f1095"], Cell[TextData[Cell[BoxData[
     FormBox[
      SubscriptBox["\[Alpha]", "t"], TraditionalForm]],ExpressionUUID->
     "fe3c31fd-9982-430b-84b5-0057401f14b7"]], "TableText",ExpressionUUID->
     "1158c241-b1a4-44f3-874d-51a1b1eeac78"], Cell[TextData[Cell[BoxData[
    Cell["\<\
Complex-valued shape parameter controlling the wavepacket's width and spatial \
chirp.\
\>", "TableText",ExpressionUUID->"377d69d1-f631-405f-a389-3a0466365046"]],
     CellChangeTimes->{{3.9956618774886503`*^9, 3.995661985209993*^9}, {
      3.995662072366991*^9, 3.995662204992208*^9}},ExpressionUUID->
     "99afe4f7-ea16-41b9-aacf-c29fb7a24fea"]], "TableText",ExpressionUUID->
     "1ffabde7-f2e7-4cd8-9efe-a6496e7ec2ff"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "016f328b-55d2-43c8-a632-52c10bda7244"], Cell[TextData[Cell[BoxData[
     FormBox[
      SubscriptBox["x", "t"], TraditionalForm]],ExpressionUUID->
     "fdfe04e0-8d4c-4ad1-adc2-09402fe201a1"]], "TableText",ExpressionUUID->
     "ce580013-6580-4c5f-a52f-706257711e8e"], Cell[
    "Real-valued position-space center.", "TableText",ExpressionUUID->
     "6ce5c8f6-0f99-4eba-979a-ca8ebb299763"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "ecf37465-bcf7-4166-82ea-71b887fb911a"], Cell[TextData[Cell[BoxData[
     FormBox[
      SubscriptBox["p", "t"], TraditionalForm]],ExpressionUUID->
     "29de110c-3031-4230-9ba8-88d5557ea050"]], "TableText",ExpressionUUID->
     "cad3afa1-bfed-4c8d-9fa9-eb8bb6b7cb1b"], Cell[
    "Real-valued momentum-space center.", "TableText",ExpressionUUID->
     "67992c0d-9f00-40d3-9872-4ac47b2bc0cb"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4816d9ca-2c6b-4152-a082-a2128043c4e6"], Cell[TextData[Cell[BoxData[
     FormBox[
      SubscriptBox["\[Gamma]", "t"], TraditionalForm]],ExpressionUUID->
     "7986a057-0914-45dc-bb14-12661de1b8e5"]], "TableText",ExpressionUUID->
     "40bacf50-aa45-4f45-84be-bde811781520"], Cell["\<\
Complex-valued phase parameter controlling the global phase and normalization.\
\>", "TableText",ExpressionUUID->"6acc04f2-9035-4803-8ec0-1b357e731b40"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.995662255348521*^9, 3.995662292997201*^9}, {
  3.9956623250143557`*^9, 3.995662325014393*^9}, {3.995662357219205*^9, 
  3.9956623734944344`*^9}, {3.995713167499741*^9, 3.995713212270578*^9}},
 CellID->1225906885,ExpressionUUID->"8e524c64-646d-44a8-b8ef-ef24a74c9aa9"],

Cell[TextData[{
 "The generalized GWP is an exact solution of the time-dependent Schr\
\[ODoubleDot]dinger equation when the external potential function is at most \
a quadratic polynomial of ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]], "InlineMath",ExpressionUUID->
  "aa415032-5fff-45b6-9fdf-befed4a55ce7"],
 "."
}], "Notes",
 CellChangeTimes->{{3.996013180158967*^9, 3.996013265499043*^9}, {
  3.9960133462562437`*^9, 3.9960133482878313`*^9}, {3.996013778236422*^9, 
  3.99601380188265*^9}},
 CellID->737499716,ExpressionUUID->"88c97bde-993f-4d53-8b12-8fdc7b1d8dae"],

Cell[TextData[{
 "The time-dependence of the GWP parameters is determined by their initial \
(",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", "0"}], TraditionalForm]], "InlineMath",ExpressionUUID->
  "d5dce921-ed2c-4cc6-8d6d-c11c8186509d"],
 ") values and the potential energy coefficients, which may also be \
time-dependent functions."
}], "Notes",
 CellChangeTimes->{{3.995837753603138*^9, 3.995837819693591*^9}, {
  3.995837992633457*^9, 3.995838002108199*^9}, {3.9958770141469517`*^9, 
  3.995877015032626*^9}, {3.996012033654914*^9, 3.996012035001329*^9}, {
  3.99601260881176*^9, 3.9960126231866007`*^9}, {3.996012657113515*^9, 
  3.996012749057769*^9}, {3.996012880173255*^9, 3.996012949450286*^9}, {
  3.996013112819525*^9, 3.996013127559309*^9}, {3.996013294880945*^9, 
  3.996013359757636*^9}},
 CellID->30455330,ExpressionUUID->"e3be066f-8b56-46c3-b623-e0acbccea74b"],

Cell[TextData[{
 StyleBox["GWP[", "InlineCode"],
 StyleBox["args", "TI"],
 StyleBox["]", "InlineCode"],
 " is used to specify initial values for the parameters:"
}], "Notes",
 CellChangeTimes->{{3.995662704611705*^9, 3.995662808911985*^9}, {
  3.9956629639240723`*^9, 3.9956629643719683`*^9}, {3.995663376002777*^9, 
