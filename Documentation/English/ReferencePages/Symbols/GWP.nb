 CellID->883860210,ExpressionUUID->"ca5ca367-af23-4127-a672-3415817af077"],

Cell[BoxData[
 TemplateBox[{
  "GWPTools`Private`GWP486", "unnorm", 
   "\"The real shape parameter RA = \\!\\(\\*RowBox[{\\\"-\\\", \
\\\"1\\\"}]\\) must be strictly positive.\"", 2, 8, 2, 34076802476654923909, 
   "Local", "GWPTools`Private`GWP486"},
  "MessageTemplate2",
  BaseStyle->"MSG"]], "Message",
