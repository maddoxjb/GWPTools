 CellID->490448740,ExpressionUUID->"81e329e5-bb41-44ce-a568-c058ef7fde96"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "dfef586e-e71c-409d-bbea-2daace7cc369"], "RP", Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["p", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "b0b5bd35-50d4-408d-b480-59dc168730a0"],
     " is taken to be real-valued (most common format)."
    }], "TableText",ExpressionUUID->"45902774-672b-4897-9a62-fd507d669ea7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c362d72d-928e-4707-b12a-0c14c657dc94"], 
    RowBox[{"RP", "+", 
     RowBox[{"I", "*", "IP"}]}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["p", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "b6987b8b-3c7c-4161-979b-37f1cd321c59"],
     " is taken to be complex-valued."
    }], "TableText",ExpressionUUID->"a51c11f6-d4ee-436e-938b-211e64e8b370"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "394b8861-024f-4fb3-a05f-59067cc1f9e5"], 
    RowBox[{"{", 
     RowBox[{"\"\<KineticEnergy\>\"", ",", "KE", ",", "SignRP"}], "}"}], Cell[
    TextData[{
     Cell[BoxData[
      SuperscriptBox["p", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "4441b7a0-12db-4f67-ab3a-055176dc1659"],
     " is calculated from the initial classical kinetic energy ",
     StyleBox["KE", "InlineCode"],
     " and the initial momentum's sign ",
     StyleBox["SignRP", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"2ddddac5-7d6f-40f7-b606-43ab02639d45"]}
  }]], "2ColumnTableMod",
 CellChangeTimes->{{3.995668803765033*^9, 3.995668857012114*^9}, {
  3.995669023431512*^9, 3.99566903656441*^9}, {3.995670244190399*^9, 
  3.995670283432488*^9}, {3.995670546806237*^9, 3.995670555818523*^9}, {
