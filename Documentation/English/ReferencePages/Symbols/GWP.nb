Cell["\<\
The position parameter may be specified in different formats:\
\>", "Notes",
 CellChangeTimes->{{3.995665789034937*^9, 3.9956658076251297`*^9}, {
   3.995668103128653*^9, 3.9956681042805653`*^9}, {3.9956683846499157`*^9, 
