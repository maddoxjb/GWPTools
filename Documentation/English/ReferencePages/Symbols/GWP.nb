Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "481fa2da-9f9d-4465-8272-afed32aae00c"], "RA", Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Alpha]", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "5a2a6736-8334-4d91-b88a-c39ef0d0c4bc"],
     " is taken to be real-valued."
    }], "TableText",ExpressionUUID->"2ac29264-059e-4e8a-8190-ef8dec9cd405"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3f131f6f-c07d-48bd-b4f2-da9708e890e1"], 
    RowBox[{"RA", "+", 
     RowBox[{"I", "*", "IA"}]}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Alpha]", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "86781689-386d-49e7-8671-5f44ebf6f2f4"],
     " is taken to be complex-valued. "
    }], "TableText",ExpressionUUID->"d0da47df-7b04-4ecf-bbb6-124d00cb2b6a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "c75a238a-4e40-4215-8788-d405d1bbfe1e"], 
    RowBox[{"{", 
     RowBox[{"UX", ",", "COVXP"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Alpha]", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "f9d6e988-934f-490d-a4fe-2fa8ca9d6de0"],
     " is calculated from the real-valued position uncertainty ",
     StyleBox["UX", "InlineCode"],
     " and position-momentum covariance ",
     StyleBox["COVXP", "InlineCode"],
     ". "
    }], "TableText",ExpressionUUID->"841d4c46-249f-4e8d-88a7-696f07dae1f1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "32e67e7a-afaa-4a8a-921f-06b0390746d5"], 
    RowBox[{"{", 
     RowBox[{"UX", ",", "UP", ",", "SignIA"}], "}"}], Cell[TextData[{
     Cell[BoxData[
      SuperscriptBox["\[Alpha]", "\[Prime]"]], "InlineFormula",
      FormatType->StandardForm,ExpressionUUID->
      "9a1f0e5c-2241-4d7f-97ed-aa791dbf3393"],
     " is calculated from the uncertainties ",
     StyleBox["UX", "InlineCode"],
     " and ",
     StyleBox["UP", "InlineCode"],
     "; the sign of the imaginary component (the initial chirp) is specified \
by ",
     StyleBox["SignIA", "InlineCode"],
     "."
    }], "TableText",ExpressionUUID->"f186c330-d825-412a-9194-eed4c4b7e5c2"]}
  }]], "2ColumnTableMod",
