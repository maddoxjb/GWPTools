 CellID->451206322,ExpressionUUID->"74270446-fb48-4818-a335-6291076b1486"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f8cb3855-11cf-4a74-a999-41ce0402941e"], "RX", Cell[TextData[{
