Cell[TextData[{
 "When specifying the shape using uncertainties (",
 StyleBox["{UX, UP, SgnIA}", "InlineCode"],
 "), the values must satisfy the uncertainty principle. Violating this limit \
forces the internal phase space to become imaginary:"
}], "ExampleText",
 CellChangeTimes->{{3.995994518832575*^9, 3.995994533984894*^9}},
 CellID->1185157625,ExpressionUUID->"0bf4a368-9f9d-43a5-abef-f55acd039acb"],

