         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"GWPFormatReport[report] formats a TestReportObject \
into a Dataset.\\nGWPFormatReport[report, \\\"ReportFormat\\\" -> format] \
specifies the output format.\\nValid formats include \\\"Summary\\\" \
(default), \\\"Detailed\\\", or a custom list of TestObject properties (e.g., \
{\\\"TestID\\\", \\\"Outcome\\\"}).\\nAccepts all standard Dataset options \
(e.g., MaxItems, Alignment, Background).\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
