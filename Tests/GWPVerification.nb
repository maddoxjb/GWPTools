                    RowBox[{
                    RowBox[{"GWPTools`Private`format", "=", 
                    RowBox[{"OptionValue", "[", "\"ReportFormat\"", "]"}]}], 
                    ";", 
                    RowBox[{"GWPTools`Private`datasetOpts", "=", 
                    RowBox[{"FilterRules", "[", 
                    RowBox[{
                    RowBox[{"{", "GWPTools`Private`opts", "}"}], ",", 
                    RowBox[{"Options", "[", "Dataset", "]"}]}], "]"}]}], ";", 
                    
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"ListQ", "[", "GWPTools`Private`format", "]"}], 
                    ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{"Dataset", "[", 
                    RowBox[{
                    RowBox[{"Association", "[", 
                    RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], "\[Rule]", 
                    RowBox[{"#1", "[", "GWPTools`Private`format", "]"}]}], 
                    "&"}], ",", 
                    
                    RowBox[{"GWPTools`Private`report", "[", "\"Results\"", 
                    "]"}]}], "]"}], "]"}], ",", 
                    
                    RowBox[{"Sequence", "@@", 
                    "GWPTools`Private`datasetOpts"}]}], "]"}], "]"}]}], "]"}],
                     ";", 
                    RowBox[{"Switch", "[", 
                    
                    RowBox[{"GWPTools`Private`format", ",", "\"Summary\"", 
                    ",", 
                    RowBox[{"Dataset", "[", 
