                    RowBox[{"GWPTools`Private`report", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"Title\"", ",", "\"CPUTimeUsed\"", ",", 
                    "\"RuntimeFailures\"", ",", "\"ReportSucceeded\""}], 
                    "}"}], "]"}], ",", 
                    
                    RowBox[{"Sequence", "@@", 
                    "GWPTools`Private`datasetOpts"}]}], "]"}], ",", 
                    "\"Detailed\"", ",", 
                    RowBox[{"Dataset", "[", 
                    RowBox[{
                    RowBox[{"Association", "[", 
                    RowBox[{"MapIndexed", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"First", "[", "#2", "]"}], "\[Rule]", 
                    RowBox[{"#1", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"\"TestID\"", ",", "\"CPUTimeUsed\"", ",", 
                    "\"Outcome\"", ",", "\"Input\"", ",", 
                    "\"MetaInformation\""}], "}"}], "]"}]}], "&"}], ",", 
                    
                    RowBox[{"GWPTools`Private`report", "[", "\"Results\"", 
                    "]"}]}], "]"}], "]"}], ",", 
                    
                    RowBox[{"Sequence", "@@", 
                    "GWPTools`Private`datasetOpts"}]}], "]"}], ",", "_", ",", 
                    "GWPTools`Private`report"}], "]"}]}]}], "]"}]}]}, {" "}, {
                   
                    RowBox[{
                    RowBox[{"GWPFormatReport", "[", 
