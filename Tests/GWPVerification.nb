Cell[CellGroupData[{

Cell["06-GWPTD", "Subsection",
 CellChangeTimes->{{3.996335738629848*^9, 3.9963357454370737`*^9}, 
   3.996672469810019*^9, {3.996753015752389*^9, 3.996753019402701*^9}, 
   3.996753694935259*^9},ExpressionUUID->"07579ac7-396d-47b2-ab27-\
32a0104a4cba"],

Cell["\<\
The 06-GWPTD test suite verifies that the internal functions responsible for \
constructing parameter time derivatives strictly match the analytical \
equations of motion governing the wavepacket\[CloseCurlyQuote]s evolution. \
Furthermore, the suite proves that the external potential energy and force \
functions correctly reproduce the underlying quadratic model, ensuring that \
they remain mathematically consistent with one another across successive \
spatial derivatives.\
\>", "Text",
 CellChangeTimes->{
  3.996755396194168*^9},ExpressionUUID->"00cb124a-4533-4920-bfc3-\
2e6ffdc822c6"],

