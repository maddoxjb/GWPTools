  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "GWPTestReport[\"key1\", \"key2\", ...] runs test files whose names \
contain the specified strings.\nGWPTestReport[\"All\"] runs the entire \
testing suite.\nGWPTestReport[] returns a list of all available test files.\n\
Accepts all standard TestReport options (e.g., TimeConstraint, \
MemoryConstraint).", "Documentation" -> None, "OwnValues" -> None, "UpValues" -> 
    None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, GWPTools`GWPTestReport, {GWPTools`GWPTestReport[
         Pattern[GWPTools`Private`keys, 
          BlankNullSequence[String]], 
         Pattern[GWPTools`Private`opts, 
          OptionsPattern[]]] :> 
       Module[{GWPTools`Private`testDir, GWPTools`Private`allFiles, 
          GWPTools`Private`targetFiles, GWPTools`Private`keyList, 
          GWPTools`Private`availableKeys, GWPTools`Private`testOpts, 
          GWPTools`Private`merge}, 
         GWPTools`Private`keyList = {GWPTools`Private`keys}; 
         GWPTools`Private`testOpts = FilterRules[{GWPTools`Private`opts}, 
            Options[TestReport]]; 
         GWPTools`Private`merge = OptionValue["MergeReports"]; 
         GWPTools`Private`testDir = Replace[
            OptionValue["GWPTestDirectory"], Automatic :> 
            FileNameJoin[{GWPTools`Private`$PackageDirectory, "Tests"}]]; If[
           Not[
            DirectoryQ[GWPTools`Private`testDir]], Message[
             MessageName[GWPTools`GWPTestReport, "nodir"], 
             GWPTools`Private`testDir]; Return[$Failed]; Null]; 
         GWPTools`Private`allFiles = 
          FileNames["*.wl", GWPTools`Private`testDir]; 
         GWPTools`Private`availableKeys = 
          Map[FileBaseName, GWPTools`Private`allFiles]; 
         If[Length[GWPTools`Private`keyList] === 0, 
           Return[GWPTools`Private`availableKeys]; Null]; 
         GWPTools`Private`targetFiles = If[
            MemberQ[
             Map[ToLowerCase, GWPTools`Private`keyList], "all"], 
            GWPTools`Private`allFiles, 
            Select[GWPTools`Private`allFiles, 
             Function[GWPTools`Private`file, 
              AnyTrue[GWPTools`Private`keyList, StringContainsQ[
                FileNameTake[GWPTools`Private`file], #, IgnoreCase -> 
                True]& ]]]]; 
         If[Length[GWPTools`Private`targetFiles] === 0, Message[
             MessageName[GWPTools`GWPTestReport, "nokeys"], 
             GWPTools`Private`keyList]; Return[
             Missing["NotAvailable"]]; Null]; If[
           TrueQ[GWPTools`Private`merge], 
           TestReport[GWPTools`Private`targetFiles, 
            Apply[Sequence, GWPTools`Private`testOpts]], 
           Map[TestReport[#, 
             Apply[Sequence, GWPTools`Private`testOpts]]& , 
            GWPTools`Private`targetFiles]]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     "GWPTestDirectory" -> Automatic, "MergeReports" -> True, 
      HandlerFunctions -> None, HandlerFunctionsKeys -> All, MemoryConstraint -> 
      Inherited, ProgressReporting :> $ProgressReporting, SameTest -> 
