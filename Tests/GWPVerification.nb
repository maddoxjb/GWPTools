  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "GWPCacheVerificationSuite[] runs the entire test suite and saves the \
merged TestReportObjects to a binary .mx file in the package directory.\n\
GWPCacheVerificationSuite[\"Load\"] instantly loads the cached reports into \
the global variable GWPVerificationTests.", "Documentation" -> None, 
    "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, GWPTools`GWPCacheVerificationSuite, {
      GWPTools`GWPCacheVerificationSuite[] :> 
       Module[{GWPTools`Private`availableTests, GWPTools`Private`cacheFile, 
          GWPTools`Private`reports}, 
         Print["Clearing system cache and preparing tests..."]; 
         ClearSystemCache[]; 
         GWPTools`Private`availableTests = GWPTools`GWPTestReport[]; 
         GWPTools`Private`cacheFile = 
          FileNameJoin[{
            GWPTools`Private`$PackageDirectory, "Tests", 
             "GWPVerificationCache.mx"}]; 
         Print["Executing full verification suite. This will take a few \
minutes..."]; 
         GWPTools`Private`reports = 
          AssociationMap[
           GWPTools`GWPTestReport[#, "MergeReports" -> True]& , 
            GWPTools`Private`availableTests]; 
         Export[GWPTools`Private`cacheFile, 
           GWPTools`Private`reports]; $CellContext`GWPVerificationTests = 
          GWPTools`Private`reports; 
         Print["Caching complete. Results saved to: ", 
           GWPTools`Private`cacheFile]; Null], 
       GWPTools`GWPCacheVerificationSuite["Load"] :> 
       Module[{GWPTools`Private`cacheFile}, 
         GWPTools`Private`cacheFile = 
          FileNameJoin[{
            GWPTools`Private`$PackageDirectory, "Tests", 
             "GWPVerificationCache.mx"}]; If[
           FileExistsQ[
           GWPTools`Private`cacheFile], $CellContext`GWPVerificationTests = 
            Import[GWPTools`Private`cacheFile]; 
           Print["Successfully loaded cached verification suite into global \
variable GWPVerificationTests."], 
           Print[
           "Cache file not found. Run GWPCacheVerificationSuite[] to generate \
it."]]; Null]}], "SubValues" -> None, "DefaultValues" -> None, "NValues" -> 
    None, "FormatValues" -> None, "Options" -> None, "Attributes" -> {}, 
    "FullName" -> "GWPTools`GWPCacheVerificationSuite"|>, False]]], "Output",
