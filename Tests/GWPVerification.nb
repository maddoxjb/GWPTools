 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-MATH-CDF\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
