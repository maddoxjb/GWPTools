Cell[TextData[{
 "This notebook provides a streamlined execution environment for running the \
complete GWPTools verification suite. For a comprehensive guide on the \
testing architecture and the underlying GWPDiagnostics subpackage, please \
refer to the dedicated TechNote available within the Mathematica \
Documentation Center. To verify the package\[CloseCurlyQuote]s integrity on \
your local machine, simply select ",
 StyleBox["Evaluate Notebook",
  FontWeight->"Bold"],
 " from the Evaluation menu. Please note that to guarantee rigorous \
cross-platform reproducibility, this suite evaluates all complex symbolic \
logic and numerical integration constraints entirely from scratch. \
Consequently, a full execution will take approximately ",
 StyleBox["10 to 15 minutes",
  FontWeight->"Bold"],
 " to complete."
}], "Text",
 CellChangeTimes->{{3.988287889663212*^9, 3.9882879344154787`*^9}, {
   3.988288054016302*^9, 3.988288093480371*^9}, {3.9882881343524857`*^9, 
   3.988288135936454*^9}, 3.996335770542832*^9, {3.99633588402883*^9, 
   3.996335884414557*^9}, 3.996748973705576*^9, 3.9967490181148376`*^9, {
   3.996749435216167*^9, 
   3.99674944747293*^9}},ExpressionUUID->"92aee5f6-c443-48d7-acba-\
d0c567007695"],

