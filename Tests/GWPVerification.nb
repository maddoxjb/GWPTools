Cell[BoxData[{
 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-HYDRO-CSPACE\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
