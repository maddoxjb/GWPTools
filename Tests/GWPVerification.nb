Cell[CellGroupData[{

Cell["1D-MATH-WAVEFUNCTION", "Subsection",
 CellChangeTimes->{{3.996335738629848*^9, 3.9963357454370737`*^9}, 
   3.996672469810019*^9, {3.996753015752389*^9, 3.996753019402701*^9}, 
   3.996753711035615*^9, {3.99744975454994*^9, 3.9974497550355673`*^9}, {
   3.9974591265620403`*^9, 3.997459130616262*^9}, {3.997460469500497*^9, 
   3.9974604700678587`*^9}, {3.99747641523254*^9, 
   3.9974764154889717`*^9}},ExpressionUUID->"a199ccef-c854-4d5d-ae9f-\
965f423f8100"],

Cell["\<\
The 1D-MATH-WAVEFUNCTION test suite validates the mathematical integrity of \
the framework\[CloseCurlyQuote]s wavefunctions in both position and momentum \
space. It verifies that the internal functions correctly decompose into real \
and imaginary components and proves that their explicitly coded analytical \
derivatives perfectly match standard symbolic differentiation up to the sixth \
order. Furthermore, the suite rigorously evaluates Hilbert space projections \
via continuous integration, confirming that the wavefunctions strictly \
satisfy fundamental quantum mechanical requirements, including unit \
normalization and the precise recovery of position and momentum expectation \
values.\
\>", "Text",
 CellChangeTimes->{
  3.9967556459584208`*^9, {3.997461258400906*^9, 
   3.997461274647401*^9}},ExpressionUUID->"9d90aa6e-721a-4b24-b530-\
f265c36b11f2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-MATH-WAVEFUNCTION\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Detailed\>\""}]}], 
  "]"}]}], "Input",
