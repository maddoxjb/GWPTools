Cell[CellGroupData[{

Cell["1D-HYDRO-PSPACE", "Subsection",
 CellChangeTimes->{{3.996335738629848*^9, 3.9963357454370737`*^9}, 
   3.996672469810019*^9, {3.996753015752389*^9, 3.996753019402701*^9}, 
   3.996753758938923*^9, {3.997449768153405*^9, 3.997449768637271*^9}, {
   3.9974591709208937`*^9, 3.997459175952298*^9}, {3.997460671427647*^9, 
   3.9974606905712023`*^9}, {3.997476389714588*^9, 
   3.997476389953279*^9}},ExpressionUUID->"1681a238-3bdc-4f42-a16d-\
771ca70727db"],

Cell["\<\
The 1D-HYDRO-PSPACE test suite extends this rigorous hydrodynamic validation \
into momentum space. Unlike the integration tests, this suite successfully \
employs a fully generalized, unwrapped parameter sequence featuring complex \
position and momentum inputs to prove the robustness of the algebraic \
representations. It confirms that the momentum-space mappings of the \
amplitude, phase, spatial coordinates, and flow velocities are analytically \
correct. Additionally, it verifies the explicit mathematical formulations for \
the momentum-space current density, quantum potential, quantum stress, and \
the corresponding decompositions of information and energy densities.\
\>", "Text",
 CellChangeTimes->{
  3.996756929555015*^9, {4.000410577474155*^9, 
   4.000410590722735*^9}},ExpressionUUID->"61615e2a-6b47-47e7-9d0d-\
b5f40ab54ba8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"report", "=", 
  RowBox[{"GWPTestReport", "[", "\"\<1D-HYDRO-PSPACE\>\"", "]"}]}], "\n", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Summary\>\""}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"GWPFormatReport", "[", 
  RowBox[{"report", ",", 
   RowBox[{"\"\<ReportFormat\>\"", "->", "\"\<Detailed\>\""}]}], 
  "]"}]}], "Input",
